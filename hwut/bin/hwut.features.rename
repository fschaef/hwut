#! /bin/sh
# SPDX-License: MIT; Project HWUT; (C) Frank-Rene Schaefer
# The launcher of 'hwut.features.rename': 'services/lib/features/rename.py' run
# as a module, from wherever 'hwut.features.rename' is called, by PATH or
# by path.
HERE=$(dirname "$(readlink -f "$0")")
PYTHONPATH="$HERE/../..${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -m hwut.services.lib.features.rename "$@"
