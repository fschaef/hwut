#! /bin/sh
# SPDX-License: MIT; Project HWUT; (C) Frank-Rene Schaefer
# The launcher of 'hwut.report.list': 'services/lib/report/list.py' run as a
# module, from wherever 'hwut.report.list' is called, by PATH or by path.
HERE=$(dirname "$(readlink -f "$0")")
PYTHONPATH="$HERE/../..${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -m hwut.services.lib.report.list "$@"
