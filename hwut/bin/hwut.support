#! /bin/sh
# SPDX-License: MIT; Project HWUT; (C) Frank-Rene Schaefer
# The launcher of 'hwut.support': 'services/lib/support/core.py' run as a
# module, from wherever 'hwut.support' is called, by PATH or by path.
HERE=$(dirname "$(readlink -f "$0")")
PYTHONPATH="$HERE/../..${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -m hwut.services.lib.support.core "$@"
