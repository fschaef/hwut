#! /bin/sh
# SPDX-License: MIT; Project HWUT; (C) Frank-Rene Schaefer
# The launcher of 'hwut.remove.apply': 'services/lib/remove/apply.py'
# run as a module, from wherever 'hwut.remove.apply' is called, by
# PATH or by path.
HERE=$(dirname "$(readlink -f "$0")")
PYTHONPATH="$HERE/../..${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -m hwut.services.lib.remove.apply "$@"
