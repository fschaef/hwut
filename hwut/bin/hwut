#! /bin/sh
# SPDX-License: MIT; Project HWUT; (C) Frank-Rene Schaefer
# THE DEFAULT FACE. 'hwut' alone is 'hwut.run': the tree run, from
# wherever it is called, by PATH or by path. A bare 'hwut' states no
# wish, and a wish that states nothing wants everything -- so 'hwut'
# runs the whole tree below the current directory.
HERE=$(dirname "$(readlink -f "$0")")
command -v python3 > /dev/null 2>&1 \
    || exec "$HERE/../services/_no_python.sh" "$(basename "$0")"
PYTHONPATH="$HERE/../..${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -m hwut.services._launch hwut.services.run "$@"
