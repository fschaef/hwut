#
# THE DEVELOPMENT CONTAINER -- every requirement of working on hwut in
# one image, so the work reads the same on any machine
# (adm/DEVELOPMENT.txt, 'The development container').
#
#     hwut.dev.podman.build                  the image 'hwut-dev', from this
#     hwut.dev.podman.enter                  a shell in it, the host's tree
#                                            mounted read-write at its path
#     hwut.dev.podman.enter bin/hwut.run     the census, in it
#
# THE LIST OF RECORD is 'adm/requirement-list.txt'; this recipe installs
# what it names, and 'sh adm/requirement-check.sh' inside the image says
# whether it did.
#
# WHAT STANDS IN IT, and why:
#     python 3.13            the interpreter the tree is written for
#                            ('match' statements: 3.10 at least); from the
#                            deadsnakes package source, in a venv whose
#                            'python3' is first on PATH
#     bidict rapidfuzz regex typeguard pyrsistent prompt_toolkit psutil pint
#                            the packages the tree imports
#     coverage               coverage.py: 'hwut.cov.run' over python
#     ruff 0.16.8            'adm/TEST/test-static-analysis.sh'; PINNED: a
#                            newer ruff counts other findings, and that
#                            suite's GOOD is a count
#     gcc, g++, make         gcov, the C road of 'hwut.cov.run'; a
#                            verilated model is C++ built by make
#     lcov, gcovr            the lcov tracefile road
#     verilator              'verilator --coverage': coverage D-12 is
#                            probed against the tool itself here
#     ghdl                   the PSL coverage road
#     lua5.4, luarocks, luacov
#     git, mercurial, subversion, breezy, fossil
#                            'adm/bundle.sh', 'hwut.affected'; and the
#                            repositories 'hwut.sanitize root' offers as
#                            a boundary ('services/_boundary.py
#                            REPOSITORY_MARK_TUPLE') -- each made by its
#                            own tool, not by a marker directory
#     libvterm0, libvterm-dev
#                            the terminal a page of the keyed screen is
#                            read through ('support/test_writing/python/
#                            hwut_vterm.py' binds it) (ruled 2026-10-09, r-11d: "use
#                            libvterm ... do not use pyte")
#     texlive-latex-base, texlive-latex-recommended, latexmk
#                            'hwut.cov.conv.to_pdf' (geometry, xcolor,
#                            colortbl, longtable, array)
#     zsh, pwsh              'services/TEST/test-complete.py'
#     THE TEST WRITING SUPPORT ('support/', E-217), every row
#     'support:<language>' of the list, at the versions MEASURED 2026-11-01:
#                            openjdk-21 (FFM preview), verilator 5.020,
#                            ghdl 4.1, erlang 25, guile-3.0, ghc 9.4.7,
#                            swi-prolog 9.0.4, gfortran 13,
#                            libffi-platypus-perl, libsqlite3-dev; and from
#                            their own releases, which Ubuntu packages
#                            too old: Go 1.24.7 (go.mod), node 22.23.4
#                            (node:sqlite), Rust 1.97.0, PowerShell 7.4.6
#     COLUMNS=300, no colour  the pages are recorded at one width
#
# THE BASE IS UBUNTU 24.04, where the support was measured: Debian
# bookworm packages Go 1.19, node 18, no JDK 21, GHC 9.0, GHDL 3 and
# Verilator 5.006 -- each older than what was measured, several known not
# to do. x86_64 only: the release tarballs are named for it.
#
# NOT IN IT: jujutsu, pijul and darcs -- no Ubuntu package; their marker
# directories are still recognised. MEASURED 2026-11-04, the first build:
# 'darcs' HAS NO INSTALLATION CANDIDATE on 24.04 -- it stood in noble
# universe as 2.16.5-1 and was deleted there, so the build broke on it.
# Nothing is run to find a repository ('_darcs' is the mark, services
# E-25), and 'darcs' is a ROAD requirement, which
# 'adm/requirement-check.sh' says and does not fail on.
# The coverage readers stay tested on WITNESSED artefacts
# ('readers/TEST/REAL_PARSING_INPUT').
#
# WRITTEN 2026-11-01 WHERE NO CONTAINER ENGINE STANDS: this recipe was
# NOT BUILT by its author; each package and version in it was measured
# on an Ubuntu 24.04 machine, where every port gave 47 ok and every
# demonstration 27 ok. The first 'hwut.dev.podman.build --rebuild' is its
# test; then 'hwut.dev.podman.enter sh hwut/adm/requirement-check.sh'.
#
# NOTHING OF THE TREE IS IN THE IMAGE: the tree is the host's, mounted
# by 'hwut.dev.podman.enter'; the image holds the requirements alone.

FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends software-properties-common gpg-agent \
 && add-apt-repository -y ppa:deadsnakes/ppa \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        python3.13 python3.13-venv python3.13-dev \
        gcc g++ libc6-dev make lcov gcovr \
        verilator ghdl iverilog \
        lua5.4 luarocks \
        git mercurial subversion brz fossil zsh \
        curl ca-certificates xz-utils \
        libvterm0 libvterm-dev \
        texlive-latex-base texlive-latex-recommended latexmk \
        openjdk-21-jdk-headless \
        erlang-base erlang-dev \
        guile-3.0 \
        ghc \
        swi-prolog-nox \
        gfortran \
        libffi-platypus-perl \
        libsqlite3-0 libsqlite3-dev \
        util-linux \
 && rm -rf /var/lib/apt/lists/*

RUN luarocks install luacov

#  Go, node, Rust and PowerShell: their own releases, at the measured
#  versions (the list's 'support:' rows say why each).
RUN curl -sSL https://go.dev/dl/go1.24.7.linux-amd64.tar.gz \
    | tar -xz -C /usr/local \
 && ln -s /usr/local/go/bin/go /usr/local/go/bin/gofmt /usr/local/bin/
RUN mkdir -p /opt/node \
 && curl -sSL https://nodejs.org/dist/v22.23.4/node-v22.23.4-linux-x64.tar.xz \
    | tar -xJ -C /opt/node --strip-components=1 \
 && ln -s /opt/node/bin/node /opt/node/bin/npm /opt/node/bin/npx /usr/local/bin/
RUN curl -sSL https://static.rust-lang.org/dist/rust-1.97.0-x86_64-unknown-linux-gnu.tar.xz \
    | tar -xJ -C /tmp \
 && /tmp/rust-1.97.0-x86_64-unknown-linux-gnu/install.sh --components=rustc,rust-std-x86_64-unknown-linux-gnu \
 && rm -rf /tmp/rust-1.97.0-x86_64-unknown-linux-gnu
#  PowerShell is no Ubuntu package: Microsoft's release tarball.
RUN mkdir -p /opt/pwsh \
 && curl -sSL https://github.com/PowerShell/PowerShell/releases/download/v7.4.6/powershell-7.4.6-linux-x64.tar.gz \
    | tar -xz -C /opt/pwsh \
 && chmod +x /opt/pwsh/pwsh && ln -s /opt/pwsh/pwsh /usr/local/bin/pwsh

RUN python3.13 -m venv /opt/hwut-venv \
 && /opt/hwut-venv/bin/pip install --no-cache-dir \
        bidict rapidfuzz regex typeguard pyrsistent prompt_toolkit psutil pint \
        coverage ruff==0.16.8

ENV PATH=/opt/hwut-venv/bin:$PATH \
    COLUMNS=300 \
    NO_COLOR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    POWERSHELL_TELEMETRY_OPTOUT=1

CMD ["bash"]
