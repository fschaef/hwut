# THE RUNTIME IMAGE OF hwut (adm/WORK/spec/24, ruling 2): Debian stable and
# the Debian package of this tree, nothing for developing hwut. The SAME
# SOFTWARE as the wheel and the deb: the image is the deb, installed.
# 'adm/container/Containerfile' is the DEVELOPMENT image, not this one.
#
#     python3 adm/packaging/build.py image <dir>       builds it, tagged
#                                                      ghcr.io/fschaef/hwut:<version>
#
#     podman run --rm --userns=keep-id -v "$PWD":/work:Z ghcr.io/fschaef/hwut hwut.help
#     docker run --rm --user "$(id -u):$(id -g)" -v "$PWD":/work ghcr.io/fschaef/hwut hwut.help
#
# WHAT A RUN WRITES INTO THE MOUNTED TREE BELONGS TO THE CALLER: rootless
# podman with '--userns=keep-id', docker with '--user'. The image runs as
# whoever it is told; HOME is '/tmp', so a user without a home writes
# nothing outside the tree.
FROM docker.io/library/debian:13-slim

ARG VERSION
COPY hwut.deb /tmp/hwut.deb
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        /tmp/hwut.deb \
 && rm -rf /var/lib/apt/lists/* /tmp/hwut.deb

LABEL org.opencontainers.image.title="hwut" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/fschaef/hwut" \
      org.opencontainers.image.licenses="MIT"

ENV HOME=/tmp
WORKDIR /work
CMD ["hwut.help"]
