#! /bin/sh
# SPDX-License: MIT; Project VUT; (C) Frank-Rene Schaefer
# The launcher of 'hwut.dev.podman.build': 'services/lib/dev/podman/build.py' run as a module, from
# wherever 'hwut.dev.podman.build' is called, by PATH or by path.
HERE=$(dirname "$(readlink -f "$0")")
PYTHONPATH="$HERE/../..${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -m vut.services.lib.dev.podman.build "$@"
