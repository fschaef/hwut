#! /bin/sh
# SPDX-License: MIT; Project VUT; (C) Frank-Rene Schaefer
# The launcher of 'hwut.remove-choice': 'services/remove_choice.py' run as a module,
# from wherever 'hwut.remove-choice' is called, by PATH or by path.
HERE=$(dirname "$(readlink -f "$0")")
PYTHONPATH="$HERE/../..${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -m vut.services.remove_choice "$@"
