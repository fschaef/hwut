#! /bin/sh
# SPDX-License: MIT; Project VUT; (C) Frank-Rene Schaefer
# The launcher of 'hwut.cov.run': 'services/lib/cov/run.py' run as a module, from
# wherever 'hwut.cov.run' is called, by PATH or by path.
HERE=$(dirname "$(readlink -f "$0")")
PYTHONPATH="$HERE/../..${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -m vut.services.lib.cov.run "$@"
