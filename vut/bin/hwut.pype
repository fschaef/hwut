#! /bin/sh
# SPDX-License: MIT; Project VUT; (C) Frank-Rene Schaefer
# The launcher of 'hwut.pype': 'services/pype.py' run as a module, from
# wherever 'hwut.pype' is called, by PATH, by path, or by a she-bang line.
HERE=$(dirname "$(readlink -f "$0")")
PYTHONPATH="$HERE/../..${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -m vut.services.pype "$@"
