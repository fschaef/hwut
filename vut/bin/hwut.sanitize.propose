#! /bin/sh
# SPDX-License: MIT; Project VUT; (C) Frank-Rene Schaefer
# The launcher of 'hwut.sanitize.propose': 'services/lib/sanitize/propose.py'
# run as a module, from wherever 'hwut.sanitize.propose' is called, by
# PATH or by path.
HERE=$(dirname "$(readlink -f "$0")")
PYTHONPATH="$HERE/../..${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -m vut.services.lib.sanitize.propose "$@"
