#! /bin/sh
# SPDX-License: MIT; Project VUT; (C) Frank-Rene Schaefer
# The launcher of 'hwut.cov.conv.to_humans': 'services/lib/cov/conv/to_humans.py' run as a module, from
# wherever 'hwut.cov.conv.to_humans' is called, by PATH or by path.
HERE=$(dirname "$(readlink -f "$0")")
PYTHONPATH="$HERE/../..${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -m vut.services.lib.cov.conv.to_humans "$@"
