bad_signal : work(out: q signals: known) {
    q = 1;
    if: q > 2 { signal unknown; }
    give q;
}
never_emits : work(out: q signals: silent, loud) {
    q = 1;
    if: q > 2 { signal loud; }
    give q;
}
stray_tick : work(out: q) {
    tick;
    q = 1;
    give q;
}
gadget : class {
    w: float;
    forge : work
    temper : work
    anneal : work
}
+gadget.forge : work(in: metal out: g : gadget) { g = 1; give g; }
+gadget.polish : work(in: g out: result : gadget) { result = g; give result; }
+gadget.temper : work(in: g out: result : widget) { result = g; give result; }
-gadget : work(in: g : gadget) { give; }
+phantom.make : work(out: p : phantom) { p = 1; give p; }
widget : class {
    z: float;
    from : work
}
+widget.from : work(in: a, b = 1 out: w : widget) { w = a; give w; }
+widget.from : work(in: a, y out: w : widget) { w = a + y; give w; }
+widget.from : work(in: r out: w : widget) { w = r; give w; }
W : reactor {
    v: float;
    caller : behavior {
        E => { .v = widget.from(1, 2) else: { ~ANY => ; }
               .v = widget.from(zz = 1) else: { ~ANY => ; } }
    }
}
cursed : class { c: float; from : work }
+cursed.from : work(in: seed out: c : cursed) { c = seed; give c; }
-cursed : work(in: c : cursed signals: refuse(code)) { if: c > 0 { signal refuse(1); } give; }
blessed : class { bv: float; from : work }
+blessed.from : work(in: seed out: bl : blessed) { bl = seed; give bl; }
-blessed() : work(in: bl : blessed signals: busy(t)) { if: bl > 0 { signal busy(9); } give; }
user_of : work(in: seed out: result) {
    bl = blessed.from(seed);
    destruct bl else: { busy => ; }
    result = seed;
    give result;
}
R : reactor { thing: float;
    ender : behavior { E2 => { destruct .thing; } }
}
misjump : work(in: v out: result signals: snag) {
    if: v > 0 { dropto rescue; }
    result = v;
    give result;
    :rescue: => {
        signal snag;
    }
}
after_life : work(in: seed out: result) {
    bl2 = blessed.from(seed);
    destruct bl2 else: { busy => ; }
    result = bl2 + 1;
    give result;
}
deadcode : work(in: a out: q) {
    q = a;
    give q;
    q = 2;
}
ticker_gives : clockwork(in: n out: v) {
    v = n;
    tick;
    give;
}
port_foreign : work(in: a out: q) {
    q = a;
    give stranger;
}
port_missing : work(in: a out: q, r) {
    q = a;
    r = a;
    give q;
}
port_disorder : work(in: a out: q, r) {
    q = a;
    r = a;
    give r, q;
}
port_doubled : work(in: a out: q) {
    q = a;
    give q, q;
}
routed_in_work : work(in: a out: q signals: snag) {
    if: a > 0 { signal snag to nowhere; }
    q = a;
    give q;
}
dead_arm : work(in: a out: q signals: snag) {
    q = a / 2 else: {
        ~ANY => ;
        div_by_zero => { q = 0; }
    }
    if: a > 9 { signal snag; }
    give q;
}

#{ F-9 slice (12.6 / SEMANTICS 24 / R-45 / R-47): the call-site laws
   over a RESOLVED callee, and the emission arity laws. }
grady : work(in: v out: g signals: too_big(gap), stuck) {
    if: v > 9 { signal too_big(v - 9); }
    if: v < 0 { signal stuck; }
    g = v;
    give g;
}
beat : event(gap, badly);
drummer : work(in: t out: b signals: beat) {
    if: t > 200 { signal beat(t - 200); }
    #{ ^ ADOPTED arity: 'beat' declares (gap, badly) -- 1 carried, REJECT }
    if: t < 0 { signal too_big(1, 2, 3); }
    #{ ^ undeclared here AND respelled-arity nonsense both reject }
    b = t;
    give b;
}
call_sites : work(in: a out: q) {
    x = grady(a);
    #{ ^ MANDATORY HANDLER: signalling callee, no else: -- REJECT }
    y = 1 + grady(a) else: {
        too_big => { y = 0; }
        stuck   => { y = 0; }
    }
    #{ ^ EXPRESSION POSITION: grady buried under '+', REJECT (the
       handler answers the STATEMENT's rhs, not an inner call); the
       cascade is lawful: with the buried call banned, the statement's
       fault union is primitives-only, so its named arms reject too }
    z = grady(a) else: {
        nonsense               => { z = 0; }
        too_big when: e.gap > 2 => { z = 1; }
    }
    #{ ^ 'nonsense' names no fault of grady -- REJECT; and TESTIMONY:
       'too_big' met only GUARDED (a guard-hole) and 'stuck' met by
       nothing, no ~ANY -- two failure-to-testify REJECTs }
    w = a / 2 else: { weird => { w = 0; } ~ANY => { w = 1; } }
    #{ ^ 'weird' is no built-in fault of a primitive statement -- REJECT }
    q = a;
    give q;
}
