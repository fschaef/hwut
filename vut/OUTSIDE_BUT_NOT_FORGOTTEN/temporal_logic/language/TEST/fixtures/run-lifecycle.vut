station : reactor++(in: cmd) {
    polling : behavior {
        ~ENTRY => armed;
        ~EXIT  => disarmed;
    }
    master : behavior {
        start =!=> polling;
        stop  =x=> polling;
    }
}
plant : work() {
    f = script("start; start; stop; stop; start");
    #{ start   -> enter (~ENTRY -> armed)
       start   -> no-op (already active, R-48)
       stop    -> leave (~EXIT -> disarmed)
       stop    -> no-op (already off, R-48 -- no second ~EXIT)
       start   -> RESTART: re-enter, ~ENTRY fires again (R-48) }
    s = station();
    f ----> s;
    give;
}
