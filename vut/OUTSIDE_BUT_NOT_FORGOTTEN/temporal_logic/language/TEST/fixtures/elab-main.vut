import: "lib/base.vut" as: base
open: fleet {
    limit: float;
}
drive : reactor is: base.vehicle {
    speed: float;
    gain: float;
    cap: float;
    main : behavior {
        MOTOR_ON when: .speed > .gain => go;
        STOP => { .speed = base.max_speed; .cap = fleet.limit; dropto done; :done: }
        HOT => base.vehicle;
        COLD => base.vehicle.top_speed;
    }
}
