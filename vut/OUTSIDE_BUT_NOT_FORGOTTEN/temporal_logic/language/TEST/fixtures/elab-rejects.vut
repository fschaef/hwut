hot : cause(threshold) temp_high when: e.value > threshold;
bad : reactor is: nowhere {
    q: float; v: float; a: float; y: float;
    lonely : behavior {
        ~ENTRY when: .x > 0 => a;
        hot(5) when: .y > 0 => b;
        F => { if: .q > 0 { :inner: } dropto later; :early: dropto early; }
        G => { loose = 2; .v = mystery; }
        K => { .v = .a / 2; .v = .a / .b; .v /= .b; }
        H => hot();
        I => hot(1, 2);
        J => hot(1, level = 3);
    }
}
z: mystery_type;

wrong_arrows : reactor(in: cmd) {
    n: float;
    IDLE : behavior {
        go => RUN;
        halt =x=> IDLE;
        rise =!=> nowhere_event;
        spin =!=> RUN to cmd;
    }
    RUN : behavior { back =!=> IDLE; }
}

#{ R-50/R-51, the STATIC unit net: provable mismatches reject at
   compile time; a handler on the statement suppresses (SEM-21
   mirrored) -- the runtime unit_mismatch path then answers. }
metrics : reactor(in: cmd) {
    dist  : physical[m];
    speed : physical[m/s];
    B : behavior {
        probe => {
            .speed = .dist;
            #{ ^ WRITE SEAM, unhandled: m/s := m -- REJECT [UNIT] }
            .dist = .dist + 2.0 [s];
            #{ ^ OPERATOR, unhandled: m + s -- REJECT [UNIT] }
            .speed = .dist / 2.0 [s];
            #{ ^ derivation: PROVEN LAWFUL, no reject }
            .speed = .dist else: { unit_mismatch => { .speed = .speed; } }
            #{ ^ handled: SUPPRESSED -- the runtime path answers }
        }
    }
}
