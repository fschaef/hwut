ungated : work(in: known: k out: result) {
    probe = (k == Nothing);
    result = k + 1;
    give result;
}
leaky : work(in: known: k out: result) {
    seen = (k == Nothing);
    held = k;
    result = held;
    give result;
}
voider : work(out: result) {
    held = Nothing;
    result = 1;
    give result;
}
silent : work(in: known: k out: r) {
    r = k + 1;
    give r;
}
viewer : work(in: a out: known: view) {
    view = a;
    give view;
}
take_view : work(in: a out: r) {
    r = viewer(a);
    give r;
}
site_ungated : work(in: known: k out: result) {
    seen = (k == Nothing);
    known: m = k;
    result = m + 1;
    give result;
}
