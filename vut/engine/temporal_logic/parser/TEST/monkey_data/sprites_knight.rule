## Knight -- a state machine. Guard / advance / parry are exclusive stances.
state_machine: Knight(reach: number)
    default: Knight.Guard
    init: { knight.raise_shield() }

    state: Guard
        on: EnemyInRange & { event.distance <= reach } => ! Advance()
        on: ArrowIncoming => { knight.block(event.angle) }
    until: EnemyInRange

    state: Advance
        on: BladeClash => ! Parry()
        on: Tick => { knight.pos = knight.pos:step_to(event.foe, reach) }
    until: BladeClash

    state: Parry
        init: { knight.stance = "high" }
        on: ParryWindowOpen => { knight.riposte() }
        on: ClashResolved => ! Guard()
    until: ClashResolved
:end
