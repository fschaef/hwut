## Ghost -- a state machine: at most one behaviour active at a time.
## Mutually-exclusive states (patrol / chase / flee) is exactly what a state
## machine encodes, so the ghost is modelled as one.
state_machine: Ghost(speed: number)
    default: Ghost.Patrol

    state: Patrol
        on: SeesPlayer & { event.distance < 8 } => ! Chase()
        on: Tick => { ghost.pos = ghost.pos + ghost.dir * speed }
    until: SeesPlayer

    state: Chase(target: string)
        init: { ghost.locked_on = target }
        on: Tick => { ghost.pos = ghost.pos:toward(target, speed) }
        on: PowerPelletEaten => ! Flee()
    until: PowerPelletEaten

    state: Flee
        init: { ghost.color = "blue" }
        deinit: { ghost.color = "white" }
        on: Tick => { ghost.pos = ghost.pos:away_from("player", speed) }
        on: PowerPelletExpired => ! Patrol()
    until: PowerPelletExpired
:end
