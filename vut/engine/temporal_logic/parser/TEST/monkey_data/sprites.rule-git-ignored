## ======================================================================
## menagerie -- ROOT: shared vocabulary, then every category
## ======================================================================

import: "sprites_moving.rule" into: menagerie.moving
import: "sprites_plants.rule" into: menagerie.plants
import: "sprites_undead.rule" into: menagerie.undead
import: "sprites_villains.rule" into: menagerie.villains
import: "sprites_rules.rule" into: menagerie.rules
import: "sprites_sea.rule" into: menagerie.sea

## ======================================================================
## shared event, clock and forward-decl vocabulary
## ======================================================================

event: Spooked1(depth: int)
event: RainFell2(weight: string)
event: PreyEscaped3(amount: int)
event: BladeClash4(range: string)
event: BladeClash5(fear: int)
event: EnemyInRange6(weight: int)
event: WhipCracked7(range: string)
event: PreyEscaped8(depth: int)
event: EnemyInRange9(fear: int)
event: SunRose10(weight: int)
event: RainFell11(amount: string)
event: PreyEscaped12(amount: string)
event: Tick13(depth: int)

clock: EnemyInRange14 79
clock: ArrowIncoming15 151

Crab16 is: state
Crab17 is: state
Goblin18 is: mode
Spider19 is: state
Beetle20 is: mode
Eel21 is: mode

Ghoul22 is: list<bool>
Dryad23 is: dict<string, int>
Beetle24 is: dict<bool, string>

## ======================================================================
## category: moving
## ======================================================================
open: menagerie.moving

state_machine: Wasp25(rate: string)
    default: Wasp25.Flee26

    state: Flee26
        init: { self.alert = true }
        on: SeesPlayer & [ e.tags.has("boss") ]
                => { self.hp = self.hp - 1 }
        until: ArrowIncoming

    state: Stalk27
        init: { self.pos = self.pos:step() }
        on: Wounded & [ e.name.glob("prey_*") ]
                => { self.alert = true }
        until: PreyEscaped

    state: Idle28
        init: { self.pos = self.pos:step() }
        on: Cornered
                => -! Ogre
                => { self.alert = true }
        until: EnemyInRange

    state: Retreat29
        init: { self.pos = self.pos:step() }
        on: Cornered
                => { self.pos = self.pos:step() }
                => Splash(level)
        until: NoiseHeard
:end

on: SeesPrey & [ e.range <= 10 ]
        => "Ogre reacts"
        => -! Serpent
        => +! Kraken(power) in: villains

mode_group: Siren30
    has: Wasp.y

    mode: Rest31
        init: { self.hp = self.hp - 1 }
        on: Tick & [ e.path.len() > 0 ]
                => -! Goblin
                => "Boar reacts"
        until: SunRose

    mode: Lurk32
        init: { self.hp = self.hp - 1 }
        on: RainFell & [ e.path.len() > 0 ]
                => { self.hp = self.hp - 1 }
                => ArrowIncoming(power = loud, speed = slow)
                => BladeClash(level)
        until: WhipCracked

    mode: Roost33
        init: { self.alert = true }
        on: PreyEscaped
                => ! Guard(speed)
                => ! Retreat(level = slow, rate)
                => +! Beetle(rate = fast) in: sea
        until: PreyEscaped
:end

on: SunRose
        => { self.hp = self.hp - 1 }
        => BladeClash(level, level = sm.x)
:close

## ======================================================================
## category: plants
## ======================================================================
open: menagerie.plants

on: SeesPrey
        => -! Lich

state_machine: Wizard34(rate: string)
    default: Wizard34.Rally35

    state: Rally35
        init: { self.pos = self.pos:step() }
        on: ArrowIncoming & [ e.hp > 0 ]
                => -! Wizard
        until: WhipCracked

    state: Stalk36
        init: { self.alert = true }
        on: SeesPrey
                => { self.alert = true }
        until: PreyEscaped
:end

on: EnemyInRange
        => WhipCracked()
:close

## ======================================================================
## category: undead
## ======================================================================
open: menagerie.undead

on: Tick
        => +! Dryad(rate, level, speed) in: sea
        => { self.hp = self.hp - 1 }
        => SeesPrey(power = 89)

state_machine: Bear37(rate: string)
    default: Bear37.Retreat38

    state: Retreat38
        init: { self.alert = true }
        on: BladeClash
                => "Troll reacts"
        until: SunRose

    state: Rally39
        init: { self.pos = self.pos:step() }
        on: SunRose & [ e.hp > 0 ]
                => "Wraith reacts"
                => ! Guard(depth = e.depth)
                => RainFell(speed = "Forage")
        until: Tick

    state: Rally40
        init: { self.alert = true }
        on: NoiseHeard
                => -! Wolf
                => ! Submerge(power = "Hunt", depth = slow, speed = fast)
        until: BladeClash
:end

on: Cornered & [ e.tags.has("boss") ]
        => SeesPrey()
:close

## ======================================================================
## category: villains
## ======================================================================
open: menagerie.villains

state_machine: Bandit41(rate: string)
    default: Bandit41.Rest42

    state: Rest42
        init: { self.hp = self.hp - 1 }
        on: RainFell
                => +! Spider(depth, speed, speed) in: rules
                => +! Stag(rate = fast) in: villains
        until: Wounded

    state: Charge43
        init: { self.pos = self.pos:step() }
        on: BladeClash
                => "Stag reacts"
                => -! Bear
        until: WhipCracked
:end

state_machine: Hawk44(rate: string)
    default: Hawk44.Ambush45

    state: Ambush45
        init: { self.pos = self.pos:step() }
        on: Tick & [ e.range <= 10 ]
                => -! Troll
                => { self.pos = self.pos:step() }
                => ! Idle()
        until: NoiseHeard

    state: Roost46
        init: { self.hp = self.hp - 1 }
        on: SunRose
                => PreyEscaped(depth = "Idle")
                => { self.hp = self.hp - 1 }
        until: RainFell

    state: Patrol47
        init: { self.pos = self.pos:step() }
        on: Splash & [ e.range <= 10 ]
                => +! Dryad(speed = "Forage", power) in: villains
                => +! Bandit(power) in: rules
                => +! Wizard(depth = slow, rate = 73) in: sea
        until: RainFell
:end
:close

## ======================================================================
## category: rules
## ======================================================================
open: menagerie.rules

mode_group: Dryad48
    has: Raven.y

    mode: Forage49
        init: { self.alert = true }
        on: SunRose & [ e.name.glob("prey_*") ]
                => -! Bear
                => "Pixie reacts"
                => { self.hp = self.hp - 1 }
        until: SeesPlayer

    mode: Roost50
        init: { self.alert = true }
        on: SunRose
                => +! Wraith(power = 29, rate) in: moving
                => +! Spider(level = "Hunt") in: sea
                => ! Submerge(speed, speed)
        until: ArrowIncoming
:end

mode_group: Troll51
    has: Ogre.y

    mode: Lurk52
        init: { self.hp = self.hp - 1 }
        on: ArrowIncoming & [ e.path.len() > 0 ]
                => ! Idle(rate = mg.pos)
        until: BladeClash

    mode: Idle53
        init: { self.hp = self.hp - 1 }
        on: Splash
                => "Kraken reacts"
                => BladeClash(level = m.x, rate = fast, power)
                => "Dryad reacts"
        until: SeesPlayer

    mode: Submerge54
        init: { self.alert = true }
        on: RainFell
                => +! Drake(rate, rate = m.fear) in: sea
        until: RainFell
:end
:close

## ======================================================================
## category: sea
## ======================================================================
open: menagerie.sea

state_machine: Drake55(rate: string)
    default: Drake55.Submerge56

    state: Submerge56
        init: { self.alert = true }
        on: NoiseHeard
                => +! Ogre(power = "Rest") in: undead
                => Cornered(rate = "Forage", speed = "Lurk")
        until: BladeClash

    state: Rally57
        init: { self.hp = self.hp - 1 }
        on: SeesPlayer
                => "Knight reacts"
                => -! Knight
        until: Wounded

    state: Stalk58
        init: { self.alert = true }
        on: ArrowIncoming
                => +! Siren(speed, level = 59) in: moving
        until: ArrowIncoming
:end

mode_group: Stag59
    has: Goblin.x

    mode: Rest60
        init: { self.hp = self.hp - 1 }
        on: Spooked
                => { self.alert = true }
        until: Wounded

    mode: Retreat61
        init: { self.hp = self.hp - 1 }
        on: NoiseHeard & [ e.name.glob("prey_*") ]
                => "Knight reacts"
        until: NoiseHeard

    mode: Submerge62
        init: { self.alert = true }
        on: WhipCracked & [ e.path.len() > 0 ]
                => { self.pos = self.pos:step() }
                => +! Crab() in: plants
                => "Bandit reacts"
        until: EnemyInRange
:end
:close
