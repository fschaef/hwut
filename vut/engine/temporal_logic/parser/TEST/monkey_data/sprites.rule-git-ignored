## ======================================================================
## menagerie -- ROOT: shared vocabulary, then every category
## ======================================================================

include: "sprites_moving.rule" into: menagerie.moving
include: "sprites_plants.rule" into: menagerie.plants
include: "sprites_undead.rule" into: menagerie.undead
include: "sprites_villains.rule" into: menagerie.villains
include: "sprites_rules.rule" into: menagerie.rules
include: "sprites_sea.rule" into: menagerie.sea

## ======================================================================
## shared event, clock and forward-decl vocabulary
## ======================================================================

event: Spooked1(depth: number)
event: RainFell2(weight: string)
event: PreyEscaped3(amount: number)
event: BladeClash4(range: string)
event: BladeClash5(fear: number)
event: EnemyInRange6(weight: number)
event: WhipCracked7(range: string)
event: PreyEscaped8(depth: number)
event: EnemyInRange9(fear: number)
event: SunRose10(weight: number)
event: RainFell11(amount: string)
event: PreyEscaped12(amount: string)
event: Tick13(depth: number)

clock: EnemyInRange14 79
clock: ArrowIncoming15 151

Crab16 is: state
Crab17 is: state
Goblin18 is: mode
Spider19 is: state
Beetle20 is: mode
Eel21 is: mode

## ======================================================================
## category: moving
## ======================================================================
open: menagerie.moving

mode_group: Raven22
    has: Wizard.y

    mode: Roost23
        init: { self.pos = self.pos:step() }
        on: SunRose
                => "Wizard reacts"
                => Splash(level = "Idle")
        until: RainFell

    mode: Flee24
        init: { self.pos = self.pos:step() }
        on: Splash & { self.hp > 0 }
                => "Lich reacts"
        until: SeesPlayer
:end

mode_group: Wolf25
    has: Troll.x

    mode: Rally26
        init: { self.pos = self.pos:step() }
        on: PreyEscaped & { self.hp > 0 }
                => -! Ogre
                => { self.alert = true }
        until: EnemyInRange

    mode: Guard27
        init: { self.hp = self.hp - 1 }
        on: Cornered
                => ! Stalk(speed, power, rate = "Flee")
        until: NoiseHeard
:end

state_machine: Ogre28(rate: string)
    default: Ogre28.Roost29

    state: Roost29
        init: { self.hp = self.hp - 1 }
        on: Splash
                => "Wasp reacts"
                => ! Forage(power, power = "Patrol", rate)
        until: Splash

    state: Roost30
        init: { self.alert = true }
        on: BladeClash
                => -! Crab
                => -! Lich
        until: Splash

    state: Submerge31
        init: { self.alert = true }
        on: ArrowIncoming
                => +! Wraith(speed = slow, speed, level = 99) in: plants
        until: NoiseHeard

    state: Roost32
        init: { self.pos = self.pos:step() }
        on: SunRose & { self.fear < 5 }
                => -! Stag
                => ! Lurk(level = "Idle")
        until: BladeClash
:end
:close

## ======================================================================
## category: plants
## ======================================================================
open: menagerie.plants

on: BladeClash
        => "Stag reacts"

state_machine: Lich33(rate: string)
    default: Lich33.Guard34

    state: Guard34
        init: { self.pos = self.pos:step() }
        on: Splash & { self.range <= 10 }
                => { self.hp = self.hp - 1 }
                => Cornered(speed, speed = 33)
        until: SeesPrey

    state: Patrol35
        init: { self.hp = self.hp - 1 }
        on: NoiseHeard
                => Splash(rate = mg.x, level = 9, speed = 21)
        until: Cornered

    state: Rally36
        init: { self.alert = true }
        on: PreyEscaped
                => SeesPrey(depth, level = "Patrol")
                => RainFell()
                => -! Bandit
        until: WhipCracked

    state: Charge37
        init: { self.alert = true }
        on: NoiseHeard
                => -! Dryad
                => { self.alert = true }
                => { self.hp = self.hp - 1 }
        until: SunRose
:end
:close

## ======================================================================
## category: undead
## ======================================================================
open: menagerie.undead

state_machine: Drake38(rate: string)
    default: Drake38.Stalk39

    state: Stalk39
        init: { self.pos = self.pos:step() }
        on: SunRose
                => +! Hawk(speed = "Lurk") in: undead
                => ! Ambush()
                => "Wraith reacts"
        until: BladeClash

    state: Retreat40
        init: { self.pos = self.pos:step() }
        on: SeesPrey
                => { self.hp = self.hp - 1 }
                => Spooked(speed, speed = mode.fear)
                => -! Wizard
        until: SeesPlayer
:end

on: BladeClash
        => ! Rest()
        => ! Hunt(power, rate)
        => BladeClash()

mode_group: Moth41
    has: Raven.x

    mode: Idle42
        init: { self.alert = true }
        on: SeesPrey & { self.hp > 0 }
                => Splash(power = "Guard", rate = slow, depth)
        until: RainFell

    mode: Flee43
        init: { self.alert = true }
        on: SunRose & { self.fear < 5 }
                => -! Serpent
                => "Drake reacts"
        until: Splash

    mode: Forage44
        init: { self.pos = self.pos:step() }
        on: BladeClash
                => ! Idle(rate = fast, power, depth)
                => RainFell(power = 41, depth = sm.pos, speed)
                => "Pixie reacts"
        until: Tick
:end

mode_group: Wizard45
    has: Troll.y

    mode: Lurk46
        init: { self.alert = true }
        on: Tick
                => +! Archer(level, speed) in: moving
        until: Wounded

    mode: Patrol47
        init: { self.hp = self.hp - 1 }
        on: SeesPrey
                => "Goblin reacts"
                => +! Bandit(power) in: rules
        until: BladeClash

    mode: Flee48
        init: { self.alert = true }
        on: WhipCracked
                => ! Roost(speed, level = 19)
                => { self.hp = self.hp - 1 }
        until: SeesPlayer
:end
:close

## ======================================================================
## category: villains
## ======================================================================
open: menagerie.villains

state_machine: Bandit49(rate: string)
    default: Bandit49.Submerge50

    state: Submerge50
        init: { self.alert = true }
        on: ArrowIncoming & { self.hp > 0 }
                => +! Serpent() in: undead
        until: BladeClash

    state: Lurk51
        init: { self.alert = true }
        on: PreyEscaped & { self.range <= 10 }
                => ! Stalk(rate)
                => { self.pos = self.pos:step() }
                => "Ghoul reacts"
        until: Cornered

    state: Submerge52
        init: { self.hp = self.hp - 1 }
        on: SeesPlayer & { self.range <= 10 }
                => -! Eel
                => { self.hp = self.hp - 1 }
        until: EnemyInRange

    state: Stalk53
        init: { self.pos = self.pos:step() }
        on: ArrowIncoming
                => "Ogre reacts"
                => -! Wolf
        until: Tick
:end

state_machine: Wizard54(rate: string)
    default: Wizard54.Forage55

    state: Forage55
        init: { self.hp = self.hp - 1 }
        on: Spooked & { self.hp > 0 }
                => +! Siren(depth = fast, depth, level) in: sea
        until: SunRose

    state: Guard56
        init: { self.pos = self.pos:step() }
        on: ArrowIncoming & { self.hp > 0 }
                => -! Goblin
                => +! Ogre(level = loud) in: plants
        until: PreyEscaped

    state: Idle57
        init: { self.hp = self.hp - 1 }
        on: SeesPlayer
                => { self.pos = self.pos:step() }
                => { self.alert = true }
        until: SeesPlayer

    state: Idle58
        init: { self.hp = self.hp - 1 }
        on: Tick & { self.fear < 5 }
                => "Drake reacts"
        until: SeesPlayer
:end

on: SunRose & { self.range <= 10 }
        => { self.pos = self.pos:step() }
        => +! Ogre(power = "Rest") in: undead
        => Cornered(rate = "Forage", speed = "Lurk")
:close

## ======================================================================
## category: rules
## ======================================================================
open: menagerie.rules

state_machine: Archer59(rate: string)
    default: Archer59.Retreat60

    state: Retreat60
        init: { self.hp = self.hp - 1 }
        on: Wounded
                => { self.hp = self.hp - 1 }
        until: RainFell

    state: Ambush61
        init: { self.hp = self.hp - 1 }
        on: EnemyInRange & { self.hp > 0 }
                => { self.pos = self.pos:step() }
                => "Lich reacts"
        until: ArrowIncoming

    state: Idle62
        init: { self.pos = self.pos:step() }
        on: RainFell & { self.hp > 0 }
                => { self.hp = self.hp - 1 }
                => Tick(power, rate, depth = "Lurk")
        until: Cornered

    state: Rally63
        init: { self.hp = self.hp - 1 }
        on: Tick & { self.range <= 10 }
                => BladeClash(power = 70, level = "Hunt", rate)
                => { self.alert = true }
                => { self.pos = self.pos:step() }
        until: Spooked
:end

state_machine: Stag64(rate: string)
    default: Stag64.Rally65

    state: Rally65
        init: { self.hp = self.hp - 1 }
        on: PreyEscaped
                => -! Ghoul
                => "Raven reacts"
                => "Archer reacts"
        until: ArrowIncoming

    state: Roost66
        init: { self.hp = self.hp - 1 }
        on: Cornered
                => RainFell()
                => "Troll reacts"
        until: SeesPlayer
:end

mode_group: Bandit67
    has: Pixie.y

    mode: Patrol68
        init: { self.hp = self.hp - 1 }
        on: SeesPlayer & { self.range <= 10 }
                => { self.alert = true }
                => Tick(power = "Guard")
        until: BladeClash

    mode: Patrol69
        init: { self.pos = self.pos:step() }
        on: BladeClash & { self.fear < 5 }
                => "Pixie reacts"
        until: PreyEscaped

    mode: Guard70
        init: { self.pos = self.pos:step() }
        on: SunRose & { self.range <= 10 }
                => "Dryad reacts"
                => ! Lurk(speed = fast, depth = "Ambush", speed = "Idle")
                => +! Spider(depth = "Charge") in: plants
        until: RainFell
:end
:close

## ======================================================================
## category: sea
## ======================================================================
open: menagerie.sea

mode_group: Pixie71
    has: Sprite.y

    mode: Submerge72
        init: { self.alert = true }
        on: SeesPrey
                => RainFell(power)
        until: Splash

    mode: Stalk73
        init: { self.pos = self.pos:step() }
        on: Wounded & { self.range <= 10 }
                => -! Boar
        until: Cornered

    mode: Hunt74
        init: { self.hp = self.hp - 1 }
        on: Spooked
                => "Troll reacts"
                => ! Rest(rate = slow, speed = fast, level = 49)
        until: NoiseHeard
:end

state_machine: Drake75(rate: string)
    default: Drake75.Submerge76

    state: Submerge76
        init: { self.pos = self.pos:step() }
        on: EnemyInRange & { self.range <= 10 }
                => { self.pos = self.pos:step() }
                => { self.hp = self.hp - 1 }
        until: PreyEscaped

    state: Flee77
        init: { self.hp = self.hp - 1 }
        on: SeesPrey
                => ! Retreat(rate = sm.depth, speed = sm.fear, speed = "Rest")
                => SeesPrey(power = sm.fear)
        until: SeesPrey
:end
:close
