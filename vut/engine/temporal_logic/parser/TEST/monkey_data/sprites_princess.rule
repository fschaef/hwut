## Princess -- a mode group: concurrent behaviours, none excluding another.
mode_group: Princess(realm: string)
    init: { princess.realm = realm }

    mode: Study
        on: BookOpened => { princess.knowledge = princess.knowledge + 1 }
    until: LibraryCloses

    mode: Diplomacy(envoy: string)
        init: { princess.guest = envoy }
        on: TreatyProposed & { event.fair } => "the princess signs with {envoy}"
        on: TreatyProposed & { event.fair == false } => "the princess declines"
    until: EnvoyDeparts

    mode: Falconry
        on: FalconLaunched => ! TrackPrey()
        on: FalconReturns => "the princess rewards the falcon"
    until: DuskFalls

    has: RoyalEtiquette
:end
