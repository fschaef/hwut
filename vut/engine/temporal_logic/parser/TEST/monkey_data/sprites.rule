        on: HeroSpotted => "{event.kind} startles the usurper"
        on: MusicStops => { usurper.pos = usurper.pos:step() }
        on: GoalReached => { usurper.pos = usurper.pos:step() }
        on: GuestArrives & { event.count > 4 } => "{event.kind} startles the usurper"
        on: PromiseMade & { event.trust >= 10 } => { usurper.pos = usurper.pos:step() }
    until: OmenSeen

    mode: Greet
        on: TreatyProposed & { event.speed > 8 } => "the usurper reacts"
        on: PromiseMade => "the usurper reacts"
        on: PromiseMade & { event.range >= 10 } => { usurper.count = usurper.count + 1 }
        on: ClueFound => { usurper.energy = usurper.energy - 1 }
        on: MusicStarts & { event.amount == 10 } => "{event.kind} startles the usurper"
    until: Betrayed

    has: RoyalEtiquette
:end

mode_group: Necromancer(reach: number)
    init: { necromancer.enter() }
    deinit: { necromancer.leave() }

    mode: Sulk(target: string)
        on: HeroSpotted => { necromancer.turn() }
        on: ClueFound => { necromancer.state = "ready" }
        on: HeroSpotted => { necromancer.state = "tense" }
        on: FalconLaunched & { event.fear > 8 } => { necromancer.state = "tense" }
        on: MusicStops & { event.speed == 8 } => "the necromancer reacts"
        on: MirrorShown & { event.fear > 2 } => { necromancer.energy = necromancer.energy - 1 }
    until: MusicStarts

    mode: Study
        on: MusicStops & { event.weight < 5 } => { necromancer.growl() }
        on: Flattered & { event.range <= 5 } => { necromancer.energy = necromancer.energy - 1 }
        on: Betrayed & { event.trust == 8 } => { necromancer.energy = necromancer.energy - 1 }
        on: HeroSpotted => { necromancer.state = "alert" }
    until: ClueFound

    mode: Conscience
        on: FalconLaunched & { event.fear == 10 } => { necromancer.pos = necromancer.pos:step() }
        on: GuestArrives => "the necromancer reacts"
        on: ClueFound => "the necromancer holds its ground"
        on: PromiseMade & { event.speed >= 2 } => { necromancer.pos = necromancer.pos:step() }
    until: GuestArrives

    mode: Scheme(target: string)
        init: { necromancer.energy = necromancer.energy - 1 }
        on: TreatyProposed & { event.amount <= 8 } => { necromancer.pos = necromancer.pos:step() }
        on: HeroSpotted => { necromancer.pos = necromancer.pos:step() }
        on: BookOpened => { necromancer.state = "ready" }
        on: TreatyProposed & { event.speed < 3 } => { necromancer.count = necromancer.count + 1 }
    until: PromiseMade

    mode: Rejoice
        init: { necromancer.pos = necromancer.pos:step() }
        on: ClueFound & { event.trust <= 5 } => { necromancer.energy = necromancer.energy - 1 }
        on: OmenSeen => { necromancer.pos = necromancer.pos:step() }
        on: FalconLaunched => { necromancer.state = "tense" }
        on: OmenSeen => { necromancer.state = "tense" }
        on: MusicStops => { necromancer.pos = necromancer.pos:step() }
        on: DebtCalled => { necromancer.energy = necromancer.energy - 1 }
        on: Betrayed => { necromancer.pos = necromancer.pos:step() }
    until: MirrorShown

    mode: Dance
        on: HeroSpotted => { necromancer.energy = necromancer.energy - 1 }
        on: PromiseMade & { event.weight <= 5 } => { necromancer.pos = necromancer.pos:step() }
        on: FalconReturns => { necromancer.count = necromancer.count + 1 }
        on: Flattered & { event.fear <= 8 } => { necromancer.count = necromancer.count + 1 }
        on: GuestArrives => { necromancer.pause() }
    until: MusicStops

    has: RoyalEtiquette
:end

mode_group: Pirate(stamina: number)
    init: { pirate.enter() }

    mode: Vanity
        on: OmenSeen & { event.distance < 1 } => { pirate.count = pirate.count + 1 }
        on: MusicStops & { event.speed <= 10 } => { pirate.count = pirate.count + 1 }
        on: OmenSeen & { event.range > 10 } => { pirate.wake() }
        on: TreatyProposed & { event.count < 10 } => { pirate.energy = pirate.energy - 1 }
        on: FalconReturns => { pirate.wake() }
        on: PromiseMade => { pirate.pos = pirate.pos:step() }
    until: HeroSpotted

    mode: Scheme
        init: { pirate.shift() }
        on: BookOpened => { pirate.state = "ready" }
        on: OmenSeen => "pirate stirs at {event.kind}"
        on: DebtCalled => { pirate.pos = pirate.pos:step() }
        on: FalconReturns => { pirate.state = "tense" }
        on: FalconReturns => { pirate.energy = pirate.energy - 1 }
        on: GuestArrives => { pirate.shift() }
    until: DebtCalled

    mode: Greet(theme: string)
        on: TreatyProposed & { event.distance <= 8 } => { pirate.energy = pirate.energy - 1 }
        on: DebtCalled & { event.amount < 4 } => "pirate stirs at {event.kind}"
        on: FalconReturns & { event.depth == 2 } => { pirate.pos = pirate.pos:step() }
        on: FalconLaunched & { event.speed == 1 } => { pirate.state = "tense" }
    until: DebtCalled

    mode: Mourn
        init: { pirate.growl() }
        on: TreatyProposed => { pirate.pos = pirate.pos:step() }
        on: FalconReturns & { event.depth == 4 } => { pirate.pos = pirate.pos:step() }
        on: GoalReached & { event.trust >= 4 } => { pirate.pos = pirate.pos:step() }
        on: MusicStarts & { event.volume < 4 } => { pirate.growl() }
        on: MusicStarts & { event.amount > 4 } => { pirate.count = pirate.count + 1 }
    until: HeroSpotted

    mode: Ambition
        on: MirrorShown & { event.speed == 5 } => { pirate.energy = pirate.energy - 1 }
        on: FalconLaunched & { event.weight < 3 } => "{event.kind} startles the pirate"
        on: MusicStarts & { event.range < 5 } => { pirate.state = "ready" }
        on: MusicStarts => { pirate.stir() }
        on: MirrorShown => "{event.kind} startles the pirate"
        on: OmenSeen => { pirate.energy = pirate.energy - 1 }
    until: DebtCalled

    mode: Threaten(goal: string)
        init: { pirate.pos = pirate.pos:step() }
        on: OmenSeen & { event.trust >= 10 } => { pirate.state = "ready" }
        on: HeroSpotted & { event.range < 2 } => { pirate.growl() }
        on: PromiseMade => "{event.kind} startles the pirate"
        on: DebtCalled & { event.depth < 2 } => { pirate.energy = pirate.energy - 1 }
        on: OmenSeen => { pirate.energy = pirate.energy - 1 }
        on: MusicStops => { pirate.energy = pirate.energy - 1 }
        on: MusicStarts => "the pirate reacts"
    until: BookOpened

    mode: Sulk
        init: { pirate.turn() }
        on: GoalReached & { event.weight >= 5 } => "{event.kind} startles the pirate"
        on: MirrorShown => { pirate.pos = pirate.pos:step() }
        on: PromiseMade => { pirate.energy = pirate.energy - 1 }
        on: FalconLaunched => "the pirate holds its ground"
        on: DebtCalled & { event.volume >= 3 } => { pirate.pos = pirate.pos:step() }
        on: FalconReturns & { event.count > 8 } => { pirate.pos = pirate.pos:step() }
    until: Betrayed

    has: RoyalEtiquette
:end

mode_group: Goblin(strength: string)
    init: { goblin.enter() }

    mode: Diplomacy
        on: OmenSeen => { goblin.pos = goblin.pos:step() }
        on: MirrorShown & { event.distance <= 10 } => { goblin.pause() }
        on: OmenSeen & { event.count > 8 } => { goblin.count = goblin.count + 1 }
        on: ClueFound => { goblin.state = "tense" }
        on: ClueFound => "{event.kind} startles the goblin"
        on: Flattered => { goblin.pos = goblin.pos:step() }
        on: GuestArrives & { event.range > 5 } => { goblin.count = goblin.count + 1 }
    until: DebtCalled

    mode: Plot
        init: { goblin.state = "calm" }
        on: FalconLaunched & { event.range < 8 } => { goblin.energy = goblin.energy - 1 }
        on: MusicStarts & { event.fear > 5 } => { goblin.pause() }
        on: MusicStarts => { goblin.state = "ready" }
        on: HeroSpotted & { event.volume <= 8 } => "goblin stirs at {event.kind}"
        on: Flattered & { event.depth >= 1 } => { goblin.state = "calm" }
    until: GuestArrives

    mode: Paranoia(theme: string)
        init: { goblin.energy = goblin.energy - 1 }
        on: ClueFound => { goblin.count = goblin.count + 1 }
        on: GoalReached & { event.fear <= 1 } => { goblin.energy = goblin.energy - 1 }
        on: ClueFound => { goblin.state = "alert" }
        on: GoalReached & { event.range < 8 } => { goblin.state = "alert" }
        on: OmenSeen => { goblin.stir() }
        on: MusicStarts => { goblin.pos = goblin.pos:step() }
        on: FalconReturns => { goblin.energy = goblin.energy - 1 }
    until: TreatyProposed

    mode: Flatter
        on: BookOpened => { goblin.energy = goblin.energy - 1 }
        on: PromiseMade => { goblin.pos = goblin.pos:step() }
        on: HeroSpotted => { goblin.count = goblin.count + 1 }
        on: GoalReached => { goblin.state = "tense" }
        on: OmenSeen => { goblin.count = goblin.count + 1 }
        on: GoalReached => { goblin.state = "tense" }
    until: PromiseMade

    mode: Rejoice
        on: MirrorShown => "the goblin holds its ground"
        on: TreatyProposed & { event.weight > 3 } => { goblin.pos = goblin.pos:step() }
        on: HeroSpotted => { goblin.pos = goblin.pos:step() }
        on: OmenSeen => { goblin.state = "tense" }
    until: FalconReturns

    has: RoyalEtiquette
:end

