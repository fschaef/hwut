        on: DuskFalls => ! Chase()
        on: DuskFalls => { revenant.state = "tense" }
        on: Spooked & { event.volume < 5 } => ! Guard()
        on: Cornered => { revenant.pos = revenant.pos:step() }
        on: Rested => "revenant stirs at {event.kind}"
    until: BladeClash

    state: Parry
        deinit: { revenant.count = revenant.count + 1 }
        on: Spooked => { revenant.pos = revenant.pos:step() }
        on: RainFell => { revenant.count = revenant.count + 1 }
        on: SunRose & { event.trust < 1 } => ! Graze()
        on: Rested & { event.distance < 5 } => ! Guard()
        on: ClashResolved => { revenant.wake() }
        on: Splash & { event.trust == 10 } => { revenant.energy = revenant.energy - 1 }
    until: SunRose

    state: Chase
        on: FlyBuzzed & { event.volume >= 4 } => ! Hop()
        on: GiantShouts => ! Guard()
        on: BladeClash & { event.depth <= 10 } => { revenant.pos = revenant.pos:step() }
        on: PathBlocked => "the revenant holds its ground"
        on: EnemyInRange & { event.fear >= 8 } => ! Graze()
        on: EnemyInRange & { event.speed <= 10 } => "{event.kind} startles the revenant"
    until: FlyBuzzed

    state: Hop
        init: { revenant.pos = revenant.pos:step() }
        on: Spooked & { event.volume > 2 } => "the revenant holds its ground"
        on: RainFell & { event.distance <= 8 } => ! Graze()
        on: Spooked & { event.amount >= 10 } => ! Guard()
        on: ScentCaught => { revenant.pause() }
    until: Splash

    state: Guard(goal: string)
        on: EnemyInRange & { event.count > 10 } => { revenant.count = revenant.count + 1 }
        on: Spooked => { revenant.pos = revenant.pos:step() }
        on: NoiseHeard => ! Graze()
        on: ArrowIncoming => ! Graze()
        on: ScentCaught & { event.distance == 1 } => "{event.kind} startles the revenant"
    until: NoiseHeard
:end

state_machine: Draugr(speed: number)
    default: Draugr.Circle

    state: Circle
        init: { draugr.state = "alert" }
        on: PathBlocked => { draugr.pos = draugr.pos:step() }
        on: RainFell & { event.count >= 10 } => ! Forage()
        on: SunRose & { event.weight == 2 } => ! Patrol()
