        on: SeesPlayer & { event.speed < 1 } => { willow.energy = willow.energy - 1 }
        on: SugarOffered & { event.trust <= 10 } => "the willow reacts"
        on: Rested & { event.count >= 1 } => "{event.kind} startles the willow"
        on: DawnBreaks => { willow.count = willow.count + 1 }
        on: CartLoaded & { event.amount <= 8 } => ! Sprint()
        on: EnemyInRange & { event.speed < 3 } => ! Lunge()
    until: Splash

    state: Sprint
        init: { willow.state = "tense" }
        on: WhipCracked & { event.speed >= 10 } => { willow.shift() }
        on: Wounded => { willow.count = willow.count + 1 }
        on: Cornered => ! Lunge()
        on: HarpPlucked & { event.trust < 4 } => ! Hop()
        on: RainFell => "willow stirs at {event.kind}"
    until: PreyEscaped

    state: Lunge
        on: SugarOffered & { event.volume < 2 } => "the willow reacts"
        on: SunRose & { event.volume > 1 } => ! Balk()
        on: ScentCaught & { event.fear >= 5 } => "{event.kind} startles the willow"
        on: PathBlocked => { willow.energy = willow.energy - 1 }
        on: HarpPlucked => { willow.count = willow.count + 1 }
        on: ReinsPulled => ! Hop()
    until: Wounded

    state: Haul(foe: string)
        on: CartLoaded & { event.range >= 5 } => ! Parry()
        on: SugarOffered => { willow.state = "tense" }
        on: ArrowIncoming & { event.range < 2 } => "the willow reacts"
        on: HarpPlucked & { event.distance >= 10 } => ! Hop()
        on: Cornered => { willow.count = willow.count + 1 }
    until: DawnBreaks

    state: Parry(prey: string)
        on: SeesPrey & { event.range > 10 } => ! Balk()
        on: DawnBreaks => ! Sprint()
        on: ReinsPulled => ! Circle()
        on: HarpPlucked => { willow.pos = willow.pos:step() }
        on: SugarOffered => ! Lunge()
        on: SeesPrey & { event.range < 2 } => { willow.energy = willow.energy - 1 }
    until: PreyEscaped

    state: Hop(prey: string)
        on: EnemyInRange => ! Lunge()
        on: ClashResolved => ! Circle()
        on: FlyBuzzed & { event.depth < 4 } => ! Haul()
        on: Spooked => ! Sprint()
        on: RainFell => ! Balk()
        on: ClashResolved => { willow.pos = willow.pos:step() }
        on: CartLoaded => "the willow holds its ground"
    until: RainFell
:end

