        on: RainFell & { event.fear < 2 } => { lily.pos = lily.pos:step() }
        on: EnemyInRange & { event.range == 4 } => { lily.pos = lily.pos:step() }
        on: Spooked & { event.count <= 4 } => { lily.state = "tense" }
        on: Wounded => "the lily holds its ground"
    until: Rested

    state: Idle
        on: DawnBreaks & { event.amount <= 8 } => { lily.pause() }
        on: NoiseHeard & { event.distance >= 3 } => "{event.kind} startles the lily"
        on: WhipCracked & { event.amount == 1 } => { lily.pos = lily.pos:step() }
        on: HarpPlucked & { event.weight == 3 } => "the lily holds its ground"
        on: SunRose & { event.trust == 1 } => { lily.energy = lily.energy - 1 }
        on: SunRose & { event.fear >= 8 } => "lily stirs at {event.kind}"
    until: PathBlocked

    state: Perch
        on: SeesPlayer => { lily.count = lily.count + 1 }
        on: Cornered & { event.count > 8 } => ! Idle()
        on: FlyBuzzed & { event.fear > 5 } => { lily.pos = lily.pos:step() }
        on: RainFell => { lily.state = "calm" }
        on: Cornered & { event.count >= 8 } => ! Dive()
    until: Rested

    state: Dive
        init: { lily.energy = lily.energy - 1 }
        on: ClashResolved => "{event.kind} startles the lily"
        on: EnemyInRange & { event.trust >= 8 } => { lily.wake() }
        on: NoiseHeard => { lily.count = lily.count + 1 }
        on: SeesPrey & { event.distance < 3 } => { lily.pos = lily.pos:step() }
        on: PathBlocked => ! Chase()
        on: GiantShouts & { event.amount > 5 } => { lily.pause() }
    until: SeesPrey
:end

state_machine: Fern(cunning: string)
