mode_group: Sorcerer
    init: { sorcerer.enter() }
    deinit: { sorcerer.leave() }

    mode: Dance(theme: string)
        init: { sorcerer.pause() }
        on: MusicStops & { event.amount < 1 } => { sorcerer.shift() }
        on: BookOpened => { sorcerer.energy = sorcerer.energy - 1 }
        on: MusicStarts => { sorcerer.stir() }
        on: ClueFound & { event.speed <= 2 } => { sorcerer.energy = sorcerer.energy - 1 }
    until: OmenSeen

    mode: Ambition(envoy: string)
        init: { sorcerer.count = sorcerer.count + 1 }
        on: GoalReached & { event.range == 4 } => { sorcerer.state = "alert" }
        on: DebtCalled & { event.depth == 10 } => "{event.kind} startles the sorcerer"
        on: OmenSeen => { sorcerer.state = "alert" }
        on: GoalReached => { sorcerer.energy = sorcerer.energy - 1 }
        on: TreatyProposed => { sorcerer.state = "alert" }
        on: Flattered & { event.distance > 10 } => { sorcerer.growl() }
        on: PromiseMade => { sorcerer.pos = sorcerer.pos:step() }
    until: Flattered

    mode: Quest
        init: { sorcerer.pos = sorcerer.pos:step() }
        on: MirrorShown & { event.volume >= 5 } => { sorcerer.energy = sorcerer.energy - 1 }
        on: MusicStops => { sorcerer.stir() }
        on: Betrayed => { sorcerer.pause() }
        on: MusicStarts & { event.trust == 4 } => { sorcerer.state = "tense" }
    until: OmenSeen

    mode: Falconry
        init: { sorcerer.state = "tense" }
        on: MusicStarts & { event.depth == 2 } => { sorcerer.count = sorcerer.count + 1 }
        on: Flattered => { sorcerer.pos = sorcerer.pos:step() }
        on: FalconLaunched & { event.trust <= 10 } => { sorcerer.pos = sorcerer.pos:step() }
        on: HeroSpotted => { sorcerer.energy = sorcerer.energy - 1 }
    until: FalconLaunched

    mode: Flatter
        on: HeroSpotted => "sorcerer stirs at {event.kind}"
        on: GuestArrives & { event.weight < 3 } => { sorcerer.count = sorcerer.count + 1 }
        on: BookOpened => { sorcerer.energy = sorcerer.energy - 1 }
        on: Betrayed => "{event.kind} startles the sorcerer"
        on: TreatyProposed => { sorcerer.energy = sorcerer.energy - 1 }
        on: MirrorShown => { sorcerer.count = sorcerer.count + 1 }
    until: OmenSeen

    mode: Mourn
        on: PromiseMade & { event.volume > 8 } => { sorcerer.pos = sorcerer.pos:step() }
        on: MusicStarts => { sorcerer.count = sorcerer.count + 1 }
        on: GuestArrives => { sorcerer.state = "ready" }
        on: MirrorShown => { sorcerer.state = "alert" }
    until: TreatyProposed

    mode: Vanity
        init: { sorcerer.pos = sorcerer.pos:step() }
        on: Betrayed => { sorcerer.pos = sorcerer.pos:step() }
        on: TreatyProposed => { sorcerer.count = sorcerer.count + 1 }
        on: FalconReturns & { event.speed >= 2 } => "{event.kind} startles the sorcerer"
        on: ClueFound & { event.weight < 8 } => { sorcerer.pause() }
        on: Flattered & { event.weight == 5 } => { sorcerer.pos = sorcerer.pos:step() }
        on: DebtCalled => { sorcerer.state = "calm" }
        on: PromiseMade & { event.depth == 8 } => { sorcerer.state = "tense" }
    until: TreatyProposed
:end

