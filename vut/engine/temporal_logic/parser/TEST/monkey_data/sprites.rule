    state: Guard(goal: string)
        on: SunRose => { draugr.state = "tense" }
        on: SunRose & { event.weight > 5 } => ! Forage()
        on: Spooked => "the draugr reacts"
        on: DawnBreaks & { event.depth < 3 } => ! Patrol()
    until: Spooked

    state: Patrol(goal: string)
        init: { draugr.state = "ready" }
        deinit: { draugr.energy = draugr.energy - 1 }
        on: NoiseHeard => { draugr.pos = draugr.pos:step() }
        on: PathBlocked => { draugr.state = "calm" }
        on: NoiseHeard => ! Circle()
        on: FlyBuzzed & { event.count > 5 } => ! Charge()
        on: ScentCaught => ! Circle()
        on: WhipCracked & { event.count <= 8 } => "{event.kind} startles the draugr"
        on: PathBlocked & { event.range < 8 } => { draugr.growl() }
    until: SugarOffered

    state: Charge
        init: { draugr.pos = draugr.pos:step() }
        on: GiantShouts => "draugr stirs at {event.kind}"
        on: WhipCracked => ! Circle()
        on: ArrowIncoming & { event.depth > 3 } => ! Patrol()
        on: RainFell & { event.volume >= 8 } => "the draugr holds its ground"
        on: RainFell => ! Forage()
    until: PreyEscaped
:end

state_machine: Specter(rate: string)
    default: Specter.Circle

    state: Circle(goal: string)
        init: { spec2.state = "ready" }
        deinit: { spec2.pos = spec2.pos:step() }
        on: ScentCaught => ! Crouch()
        on: Splash & { event.weight >= 3 } => { spec2.stir() }
        on: BladeClash => { spec2.energy = spec2.energy - 1 }
        on: NoiseHeard & { event.volume >= 8 } => { spec2.state = "calm" }
        on: Spooked & { event.trust == 4 } => "the spec2 holds its ground"
        on: BladeClash & { event.volume > 5 } => { spec2.energy = spec2.energy - 1 }
        on: ClashResolved & { event.distance >= 3 } => { spec2.energy = spec2.energy - 1 }
    until: Tick

    state: Alert
        init: { spec2.count = spec2.count + 1 }
        on: SeesPrey & { event.count <= 2 } => "the spec2 reacts"
        on: Cornered & { event.trust <= 1 } => { spec2.shift() }
        on: SeesPlayer & { event.weight < 8 } => { spec2.shift() }
        on: Wounded => { spec2.pos = spec2.pos:step() }
    until: ScentCaught

    state: Chase
        init: { spec2.growl() }
        on: FlyBuzzed => { spec2.pos = spec2.pos:step() }
        on: Spooked => { spec2.count = spec2.count + 1 }
        on: ScentCaught => { spec2.state = "tense" }
        on: Wounded => "{event.kind} startles the spec2"
        on: WhipCracked => { spec2.state = "ready" }
        on: EnemyInRange => "spec2 stirs at {event.kind}"
        on: PreyEscaped & { event.distance >= 1 } => "the spec2 reacts"
    until: ArrowIncoming

    state: Crouch(prey: number)
        deinit: { spec2.pos = spec2.pos:step() }
        on: DuskFalls => ! Flee()
        on: ScentCaught & { event.count == 5 } => { spec2.state = "tense" }
        on: ScentCaught => ! Alert()
        on: ArrowIncoming & { event.amount == 5 } => { spec2.state = "ready" }
        on: DuskFalls => "spec2 stirs at {event.kind}"
    until: SunRose

    state: Flee
        deinit: { spec2.count = spec2.count + 1 }
        on: SugarOffered & { event.fear < 8 } => "spec2 stirs at {event.kind}"
        on: WhipCracked => "the spec2 holds its ground"
        on: SunRose & { event.range >= 3 } => { spec2.turn() }
        on: Splash & { event.amount > 1 } => ! Surface()
    until: EnemyInRange

    state: Surface
        init: { spec2.energy = spec2.energy - 1 }
        deinit: { spec2.state = "calm" }
        on: DuskFalls & { event.depth <= 5 } => "spec2 stirs at {event.kind}"
        on: FlyBuzzed & { event.volume == 1 } => "the spec2 holds its ground"
        on: Wounded => "the spec2 reacts"
        on: BladeClash & { event.count > 4 } => ! Crouch()
        on: SunRose => { spec2.energy = spec2.energy - 1 }
    until: CartLoaded
:end

state_machine: Wraith(reach: string)
    default: Wraith.Gallop
    init: { wr2.spawn() }

    state: Gallop(foe: string)
        on: FlyBuzzed => { wr2.state = "alert" }
        on: PathBlocked & { event.fear >= 3 } => { wr2.count = wr2.count + 1 }
        on: BladeClash & { event.amount < 4 } => { wr2.energy = wr2.energy - 1 }
        on: Cornered & { event.weight == 10 } => ! Shamble()
        on: Splash => { wr2.pos = wr2.pos:step() }
        on: DuskFalls & { event.distance == 8 } => { wr2.stir() }
    until: NoiseHeard

    state: Trot
        init: { wr2.count = wr2.count + 1 }
        on: BladeClash & { event.distance < 3 } => "wr2 stirs at {event.kind}"
        on: Cornered => { wr2.count = wr2.count + 1 }
        on: FlyBuzzed => { wr2.energy = wr2.energy - 1 }
        on: PreyEscaped & { event.count == 3 } => { wr2.energy = wr2.energy - 1 }
        on: CartLoaded & { event.depth == 3 } => ! Gallop()
        on: Cornered => { wr2.count = wr2.count + 1 }
        on: HarpPlucked => { wr2.energy = wr2.energy - 1 }
    until: ClashResolved

    state: Burrow(foe: string)
        deinit: { wr2.energy = wr2.energy - 1 }
        on: PathBlocked & { event.volume <= 10 } => "the wr2 holds its ground"
        on: EnemyInRange & { event.amount == 8 } => ! Trot()
        on: Wounded & { event.depth < 5 } => { wr2.turn() }
        on: Rested & { event.amount < 3 } => "the wr2 reacts"
    until: PathBlocked

    state: Wait
        on: ClashResolved => { wr2.state = "calm" }
        on: Splash => { wr2.pos = wr2.pos:step() }
        on: SeesPlayer & { event.weight == 4 } => { wr2.wake() }
        on: ScentCaught & { event.amount < 5 } => "the wr2 reacts"
        on: PathBlocked & { event.depth == 2 } => { wr2.wake() }
        on: EnemyInRange => "the wr2 holds its ground"
    until: Spooked

    state: Alert
        on: SunRose & { event.speed < 1 } => { wr2.count = wr2.count + 1 }
        on: CartLoaded & { event.trust >= 10 } => { wr2.count = wr2.count + 1 }
        on: Wounded => ! Shamble()
        on: GiantShouts & { event.trust <= 5 } => ! Shamble()
        on: ScentCaught => { wr2.growl() }
        on: CartLoaded => { wr2.stir() }
        on: Spooked => { wr2.count = wr2.count + 1 }
    until: RainFell

    state: Shamble(goal: number)
        on: NoiseHeard => ! Wait()
        on: DuskFalls & { event.amount >= 1 } => ! Wait()
        on: SunRose => ! Burrow()
        on: Spooked & { event.fear < 4 } => { wr2.growl() }
        on: PreyEscaped => ! Wait()
        on: NoiseHeard => { wr2.pause() }
    until: SugarOffered
:end

## =========================================================================
## sprites_villains.rule -- 10 villains (concurrent psychological drives)
