    state: Dive
        init: { fern.count = fern.count + 1 }
        on: DawnBreaks => ! Trot()
        on: PathBlocked => ! Sprint()
        on: CartLoaded => "the fern reacts"
        on: Rested => { fern.stir() }
    until: EnemyInRange

    state: Trot
        on: SunRose => ! Sprint()
        on: Cornered => { fern.state = "ready" }
        on: CartLoaded => "the fern reacts"
        on: Cornered & { event.range < 4 } => { fern.state = "tense" }
        on: PathBlocked & { event.volume == 5 } => ! Dive()
        on: ScentCaught => "fern stirs at {event.kind}"
        on: EnemyInRange => { fern.energy = fern.energy - 1 }
    until: SeesPlayer

    state: Haul
        init: { fern.count = fern.count + 1 }
        on: BladeClash & { event.depth >= 1 } => "fern stirs at {event.kind}"
        on: Wounded & { event.depth > 5 } => ! Sprint()
        on: Wounded & { event.distance <= 2 } => { fern.count = fern.count + 1 }
        on: WhipCracked => { fern.pos = fern.pos:step() }
        on: WhipCracked => ! Trot()
        on: ScentCaught => ! Scatter()
    until: ReinsPulled

    state: Sprint
        on: WhipCracked => { fern.stir() }
        on: GiantShouts => "the fern holds its ground"
        on: Tick => ! Haul()
        on: SeesPrey & { event.fear == 3 } => { fern.state = "ready" }
        on: Wounded & { event.count < 1 } => ! Trot()
        on: Wounded => ! Haul()
    until: Wounded
:end

