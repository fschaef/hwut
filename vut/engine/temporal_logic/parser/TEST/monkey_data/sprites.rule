        on: HarpPlucked => ! Pounce()
        on: ArrowIncoming & { event.speed < 8 } => { cactus.pause() }
        on: SeesPlayer & { event.depth == 2 } => { cactus.count = cactus.count + 1 }
        on: SunRose & { event.fear <= 8 } => { cactus.pos = cactus.pos:step() }
        on: HarpPlucked => "cactus stirs at {event.kind}"
    until: SeesPlayer

    state: Dive
        deinit: { cactus.turn() }
        on: WhipCracked => ! Pounce()
        on: SunRose => ! Coil()
        on: BladeClash => { cactus.state = "tense" }
        on: NoiseHeard => ! Coil()
        on: WhipCracked & { event.count < 8 } => "the cactus holds its ground"
        on: CartLoaded => { cactus.pos = cactus.pos:step() }
    until: PathBlocked

    state: Sit
        init: { cactus.state = "calm" }
        on: PathBlocked => ! Pounce()
        on: EnemyInRange & { event.amount == 1 } => { cactus.state = "ready" }
        on: WhipCracked & { event.speed >= 2 } => ! Sprint()
        on: Splash & { event.volume <= 1 } => ! Pounce()
        on: ScentCaught => ! Coil()
        on: GiantShouts => "the cactus holds its ground"
        on: SunRose => { cactus.pos = cactus.pos:step() }
    until: SeesPlayer
:end

## =========================================================================
## sprites_undead.rule -- 10 creatures
## =========================================================================

state_machine: Zombie(rate: string)
    default: Zombie.Parry

    state: Parry
        deinit: { zombie.pos = zombie.pos:step() }
        on: Splash & { event.fear == 5 } => { zombie.energy = zombie.energy - 1 }
        on: FlyBuzzed & { event.fear == 1 } => "{event.kind} startles the zombie"
        on: ReinsPulled & { event.distance >= 8 } => { zombie.energy = zombie.energy - 1 }
        on: ClashResolved & { event.distance == 3 } => { zombie.stir() }
        on: FlyBuzzed & { event.speed > 3 } => { zombie.pos = zombie.pos:step() }
    until: RainFell

    state: Hop
        on: DawnBreaks & { event.depth >= 8 } => ! Strike()
        on: ArrowIncoming => { zombie.growl() }
        on: Wounded => "zombie stirs at {event.kind}"
        on: NoiseHeard & { event.weight <= 2 } => { zombie.state = "ready" }
        on: PathBlocked & { event.trust > 4 } => { zombie.wake() }
        on: SunRose => "the zombie reacts"
        on: Spooked => ! Parry()
    until: Cornered

    state: Sit
        init: { zombie.shift() }
        on: PathBlocked & { event.range <= 1 } => ! Rest()
        on: SeesPlayer & { event.weight > 1 } => ! Parry()
        on: RainFell => ! Hop()
        on: WhipCracked & { event.count > 10 } => { zombie.energy = zombie.energy - 1 }
    until: NoiseHeard

    state: Rest(foe: number)
        on: NoiseHeard & { event.amount > 4 } => { zombie.wake() }
        on: Splash => { zombie.pos = zombie.pos:step() }
        on: DawnBreaks & { event.fear > 8 } => ! Hop()
        on: ScentCaught & { event.trust > 5 } => ! Hop()
        on: RainFell => ! Sit()
        on: HarpPlucked => ! Parry()
        on: ScentCaught & { event.amount == 4 } => { zombie.count = zombie.count + 1 }
    until: SunRose

    state: Strike(target: string)
        deinit: { zombie.turn() }
        on: Tick & { event.range >= 3 } => ! Sit()
        on: SeesPrey & { event.trust < 4 } => "zombie stirs at {event.kind}"
        on: ClashResolved & { event.trust == 10 } => { zombie.count = zombie.count + 1 }
        on: Wounded => { zombie.shift() }
        on: SeesPlayer & { event.fear > 1 } => { zombie.shift() }
    until: EnemyInRange
:end

state_machine: Skeleton(reach: number)
    default: Skeleton.Hunt
    init: { skeleton.spawn() }

    state: Hunt(target: string)
        deinit: { skeleton.state = "alert" }
        on: Wounded & { event.volume >= 10 } => { skeleton.state = "calm" }
        on: ArrowIncoming & { event.trust == 8 } => { skeleton.state = "tense" }
        on: DawnBreaks => ! Graze()
        on: DuskFalls => ! Graze()
        on: Wounded & { event.speed <= 10 } => { skeleton.growl() }
        on: SeesPlayer => { skeleton.count = skeleton.count + 1 }
    until: SunRose

    state: Guard
        init: { skeleton.count = skeleton.count + 1 }
        deinit: { skeleton.state = "ready" }
        on: GiantShouts => ! Flee()
        on: HarpPlucked & { event.distance < 10 } => { skeleton.pos = skeleton.pos:step() }
        on: Spooked => "skeleton stirs at {event.kind}"
        on: NoiseHeard & { event.range <= 1 } => { skeleton.pos = skeleton.pos:step() }
    until: GiantShouts

    state: Graze(foe: string)
        init: { skeleton.count = skeleton.count + 1 }
        on: HarpPlucked => ! Advance()
        on: EnemyInRange & { event.depth > 2 } => "the skeleton holds its ground"
        on: SunRose => ! Hunt()
        on: ReinsPulled => ! Advance()
        on: SeesPrey & { event.weight > 1 } => "{event.kind} startles the skeleton"
        on: RainFell => ! Lunge()
        on: HarpPlucked => { skeleton.count = skeleton.count + 1 }
    until: GiantShouts

    state: Flee
        on: ArrowIncoming & { event.range == 3 } => ! Dive()
        on: WhipCracked & { event.count > 1 } => ! Guard()
        on: GiantShouts => ! Guard()
        on: SeesPlayer => { skeleton.wake() }
        on: Tick => ! Hunt()
        on: Rested => ! Lunge()
        on: DuskFalls => ! Lunge()
    until: ClashResolved

    state: Dive
        init: { skeleton.stir() }
        deinit: { skeleton.energy = skeleton.energy - 1 }
        on: SugarOffered & { event.depth == 8 } => ! Lunge()
        on: Rested & { event.fear > 4 } => { skeleton.energy = skeleton.energy - 1 }
        on: Spooked => ! Graze()
        on: Rested => { skeleton.count = skeleton.count + 1 }
    until: SunRose

    state: Advance
        on: CartLoaded => "the skeleton holds its ground"
        on: ClashResolved => { skeleton.count = skeleton.count + 1 }
        on: WhipCracked => { skeleton.energy = skeleton.energy - 1 }
        on: CartLoaded => "skeleton stirs at {event.kind}"
        on: CartLoaded & { event.trust < 8 } => "the skeleton reacts"
    until: NoiseHeard

    state: Lunge
        on: FlyBuzzed & { event.count == 5 } => { skeleton.energy = skeleton.energy - 1 }
        on: Splash => { skeleton.wake() }
        on: WhipCracked & { event.count <= 8 } => ! Graze()
        on: DawnBreaks => "{event.kind} startles the skeleton"
    until: BladeClash
:end

state_machine: Lich(reach: number)
    default: Lich.Graze
    init: { lich.spawn() }

    state: Graze
        deinit: { lich.state = "calm" }
        on: RainFell & { event.depth >= 8 } => ! Parry()
        on: Splash => { lich.pos = lich.pos:step() }
        on: ClashResolved => ! Charge()
        on: SeesPrey => { lich.count = lich.count + 1 }
        on: ReinsPulled => { lich.energy = lich.energy - 1 }
        on: GiantShouts => "the lich holds its ground"
    until: SeesPlayer

    state: Parry(goal: string)
        on: GiantShouts & { event.depth == 2 } => ! Rear()
        on: SugarOffered & { event.fear == 8 } => "the lich holds its ground"
        on: SeesPlayer & { event.count <= 1 } => { lich.count = lich.count + 1 }
        on: Splash & { event.weight <= 2 } => "the lich holds its ground"
        on: Splash & { event.distance > 5 } => { lich.state = "alert" }
        on: SunRose & { event.depth < 8 } => { lich.pos = lich.pos:step() }
        on: PreyEscaped & { event.volume > 8 } => ! Rear()
    until: ScentCaught

    state: Rear
        deinit: { lich.energy = lich.energy - 1 }
        on: CartLoaded => { lich.count = lich.count + 1 }
        on: Spooked => ! Graze()
        on: FlyBuzzed & { event.speed <= 5 } => { lich.energy = lich.energy - 1 }
        on: EnemyInRange => ! Charge()
        on: EnemyInRange & { event.weight > 3 } => { lich.turn() }
    until: ReinsPulled

    state: Charge
        deinit: { lich.state = "ready" }
        on: SeesPrey & { event.amount == 1 } => ! Parry()
        on: SunRose & { event.weight > 8 } => ! Flee()
        on: ArrowIncoming => "lich stirs at {event.kind}"
        on: ReinsPulled & { event.range >= 2 } => ! Graze()
        on: SugarOffered & { event.distance < 10 } => { lich.energy = lich.energy - 1 }
        on: PathBlocked => { lich.energy = lich.energy - 1 }
        on: Rested & { event.distance == 2 } => ! Graze()
    until: Tick

    state: Flee
        init: { lich.growl() }
        on: SunRose & { event.depth >= 4 } => "lich stirs at {event.kind}"
        on: Spooked => ! Graze()
        on: Cornered & { event.depth > 2 } => ! Crouch()
        on: DuskFalls => { lich.pos = lich.pos:step() }
        on: ReinsPulled => ! Graze()
    until: SeesPrey

    state: Crouch(goal: string)
        on: Spooked & { event.depth < 8 } => { lich.state = "alert" }
        on: Rested => "the lich holds its ground"
        on: NoiseHeard & { event.fear <= 4 } => { lich.wake() }
        on: RainFell => { lich.shift() }
        on: CartLoaded & { event.range >= 5 } => ! Flee()
        on: ArrowIncoming => ! Rear()
    until: DuskFalls
:end

state_machine: Ghoul(rate: string)
    default: Ghoul.Idle
    init: { ghoul.spawn() }

    state: Idle(foe: number)
        deinit: { ghoul.energy = ghoul.energy - 1 }
        on: Spooked => ! Forage()
        on: Wounded & { event.amount >= 3 } => { ghoul.state = "calm" }
        on: SunRose & { event.distance >= 1 } => ! Crouch()
        on: GiantShouts => ! Forage()
        on: SugarOffered & { event.distance >= 2 } => ! Alert()
        on: RainFell & { event.volume > 2 } => { ghoul.energy = ghoul.energy - 1 }
        on: BladeClash & { event.trust < 3 } => "{event.kind} startles the ghoul"
    until: DuskFalls

    state: Crouch
        on: BladeClash => { ghoul.count = ghoul.count + 1 }
        on: BladeClash & { event.trust < 5 } => ! Pounce()
        on: DawnBreaks & { event.depth == 2 } => "{event.kind} startles the ghoul"
        on: PreyEscaped => "the ghoul reacts"
        on: DawnBreaks & { event.depth < 2 } => "{event.kind} startles the ghoul"
        on: HarpPlucked & { event.depth > 1 } => "the ghoul holds its ground"
        on: FlyBuzzed => { ghoul.stir() }
    until: ClashResolved

    state: Pounce
        init: { ghoul.count = ghoul.count + 1 }
        on: SeesPlayer & { event.speed == 5 } => { ghoul.count = ghoul.count + 1 }
        on: BladeClash & { event.count <= 3 } => { ghoul.energy = ghoul.energy - 1 }
        on: CartLoaded & { event.amount <= 10 } => ! Idle()
        on: ReinsPulled => "ghoul stirs at {event.kind}"
    until: GiantShouts

    state: Advance
        init: { ghoul.stir() }
        on: DuskFalls & { event.range <= 10 } => { ghoul.count = ghoul.count + 1 }
        on: WhipCracked => ! Crouch()
        on: ArrowIncoming => { ghoul.energy = ghoul.energy - 1 }
        on: WhipCracked & { event.fear < 2 } => "{event.kind} startles the ghoul"
        on: Wounded & { event.count > 4 } => ! Crouch()
        on: Wounded => ! Alert()
        on: Wounded & { event.distance <= 8 } => { ghoul.energy = ghoul.energy - 1 }
    until: CartLoaded

    state: Forage
        init: { ghoul.count = ghoul.count + 1 }
        on: Spooked => "the ghoul reacts"
        on: PreyEscaped & { event.trust > 1 } => { ghoul.count = ghoul.count + 1 }
        on: Spooked & { event.speed == 2 } => "{event.kind} startles the ghoul"
        on: ClashResolved => ! Idle()
    until: ReinsPulled

    state: Alert
        init: { ghoul.energy = ghoul.energy - 1 }
        on: GiantShouts & { event.range == 5 } => ! Advance()
        on: PathBlocked & { event.trust <= 3 } => { ghoul.count = ghoul.count + 1 }
        on: ScentCaught => { ghoul.count = ghoul.count + 1 }
        on: HarpPlucked & { event.range < 2 } => "{event.kind} startles the ghoul"
        on: SunRose & { event.distance <= 2 } => { ghoul.state = "tense" }
        on: PreyEscaped => { ghoul.pos = ghoul.pos:step() }
        on: Wounded => { ghoul.state = "ready" }
    until: SunRose
:end

state_machine: Mummy
    default: Mummy.Balk
    init: { mummy.spawn() }

    state: Balk
        init: { mummy.state = "tense" }
        on: Tick & { event.volume >= 10 } => "{event.kind} startles the mummy"
        on: SeesPrey => { mummy.stir() }
        on: ClashResolved => ! Haul()
        on: BladeClash => { mummy.energy = mummy.energy - 1 }
        on: PathBlocked => ! Advance()
        on: Spooked => { mummy.shift() }
        on: Spooked => { mummy.count = mummy.count + 1 }
    until: RainFell

    state: Advance
        deinit: { mummy.count = mummy.count + 1 }
        on: DawnBreaks => { mummy.turn() }
        on: DuskFalls & { event.amount > 10 } => ! Balk()
        on: WhipCracked & { event.trust >= 4 } => { mummy.energy = mummy.energy - 1 }
        on: Splash & { event.trust <= 5 } => ! Perch()
        on: DawnBreaks & { event.fear == 8 } => ! Hop()
        on: RainFell => { mummy.energy = mummy.energy - 1 }
        on: ArrowIncoming => ! Haul()
    until: Rested

    state: Haul(goal: number)
        on: PathBlocked & { event.volume >= 5 } => { mummy.growl() }
        on: PathBlocked & { event.weight < 8 } => { mummy.energy = mummy.energy - 1 }
        on: SeesPrey => { mummy.turn() }
        on: ClashResolved => ! Perch()
        on: PreyEscaped & { event.fear <= 1 } => { mummy.state = "ready" }
        on: SugarOffered => { mummy.energy = mummy.energy - 1 }
        on: RainFell => "the mummy holds its ground"
    until: Wounded

    state: Hop(foe: number)
        on: Rested & { event.volume > 1 } => ! Haul()
        on: SugarOffered & { event.fear >= 8 } => { mummy.count = mummy.count + 1 }
        on: GiantShouts => { mummy.count = mummy.count + 1 }
        on: ArrowIncoming & { event.fear <= 2 } => { mummy.pos = mummy.pos:step() }
        on: Splash => { mummy.count = mummy.count + 1 }
    until: ClashResolved

    state: Perch(target: string)
        init: { mummy.energy = mummy.energy - 1 }
        on: Tick => ! Haul()
        on: EnemyInRange & { event.trust < 3 } => ! Hop()
        on: EnemyInRange & { event.weight == 10 } => { mummy.pos = mummy.pos:step() }
        on: HarpPlucked & { event.volume >= 8 } => { mummy.pos = mummy.pos:step() }
        on: Cornered => { mummy.pos = mummy.pos:step() }
        on: NoiseHeard => "the mummy reacts"
    until: PreyEscaped
:end

state_machine: Wight(stamina: string)
    default: Wight.Stalk

    state: Stalk
        deinit: { wight.state = "tense" }
        on: SeesPlayer & { event.fear < 8 } => { wight.state = "tense" }
        on: HarpPlucked & { event.depth <= 8 } => ! Pounce()
        on: Splash => "wight stirs at {event.kind}"
        on: SeesPlayer => ! Forage()
        on: GiantShouts => ! Hunt()
        on: SugarOffered & { event.speed > 2 } => ! Dive()
        on: Spooked => { wight.state = "tense" }
    until: WhipCracked

    state: Chase
        on: ClashResolved => ! Pounce()
        on: Spooked => ! Hunt()
        on: Tick & { event.depth < 3 } => { wight.energy = wight.energy - 1 }
        on: CartLoaded => { wight.pause() }
        on: DawnBreaks & { event.speed > 8 } => ! Dive()
        on: Cornered & { event.amount <= 5 } => { wight.energy = wight.energy - 1 }
        on: CartLoaded & { event.fear >= 3 } => { wight.pos = wight.pos:step() }
    until: FlyBuzzed

    state: Catch
        init: { wight.stir() }
        on: Wounded & { event.weight == 2 } => { wight.pos = wight.pos:step() }
        on: SeesPlayer & { event.count >= 3 } => { wight.stir() }
        on: Tick & { event.volume < 5 } => "{event.kind} startles the wight"
        on: CartLoaded => { wight.state = "alert" }
        on: Splash & { event.distance > 2 } => "{event.kind} startles the wight"
    until: SugarOffered

    state: Forage
        init: { wight.pos = wight.pos:step() }
        on: Cornered & { event.fear >= 10 } => { wight.pos = wight.pos:step() }
        on: EnemyInRange & { event.volume == 2 } => { wight.state = "calm" }
        on: FlyBuzzed => { wight.growl() }
        on: Spooked => ! Stalk()
        on: PathBlocked & { event.volume <= 2 } => "the wight reacts"
        on: WhipCracked => "the wight reacts"
    until: FlyBuzzed

    state: Hunt
        on: SeesPlayer & { event.range < 3 } => ! Catch()
        on: SugarOffered => "{event.kind} startles the wight"
        on: WhipCracked & { event.weight >= 5 } => ! Stalk()
        on: DawnBreaks => ! Pounce()
    until: DawnBreaks

    state: Pounce
        deinit: { wight.count = wight.count + 1 }
        on: DawnBreaks & { event.distance >= 1 } => "wight stirs at {event.kind}"
        on: ArrowIncoming & { event.count > 1 } => { wight.wake() }
        on: CartLoaded & { event.volume == 2 } => "{event.kind} startles the wight"
        on: Tick => ! Dive()
        on: NoiseHeard & { event.speed <= 4 } => ! Hunt()
    until: SeesPrey

    state: Dive
        deinit: { wight.stir() }
        on: ReinsPulled => ! Pounce()
        on: SeesPrey => { wight.pos = wight.pos:step() }
        on: SeesPlayer & { event.weight < 8 } => { wight.energy = wight.energy - 1 }
        on: Spooked & { event.depth >= 4 } => { wight.energy = wight.energy - 1 }
        on: DawnBreaks => ! Catch()
        on: HarpPlucked & { event.count >= 2 } => ! Chase()
        on: ArrowIncoming & { event.speed <= 1 } => ! Catch()
    until: ScentCaught
:end

state_machine: Revenant(strength: number)
    default: Revenant.Graze
    init: { revenant.spawn() }

    state: Graze(target: string)
        init: { revenant.energy = revenant.energy - 1 }
        on: Cornered & { event.speed <= 1 } => ! Hop()
        on: SunRose & { event.trust == 5 } => ! Guard()
        on: ClashResolved & { event.range >= 8 } => { revenant.state = "tense" }
        on: RainFell => ! Guard()
        on: DawnBreaks => "revenant stirs at {event.kind}"
