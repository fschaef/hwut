    state: Forage
        on: HarpPlucked => { draugr.energy = draugr.energy - 1 }
        on: HarpPlucked => ! Guard()
        on: FlyBuzzed => { draugr.pos = draugr.pos:step() }
        on: FlyBuzzed & { event.volume >= 5 } => ! Guard()
