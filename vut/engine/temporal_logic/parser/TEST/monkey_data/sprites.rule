## =========================================================================
## menagerie -- ROOT: shared vocabulary, then mounts every category
## =========================================================================


include: "events_common.rule"    into: menagerie
include: "sprites_moving.rule"    into: menagerie.moving
include: "sprites_plants.rule"    into: menagerie.plants
include: "sprites_undead.rule"    into: menagerie.undead
include: "sprites_villains.rule"  into: menagerie.villains
include: "sprites_rules.rule"     into: menagerie.rules


## =========================================================================
## events_common -- shared event, clock and forward-decl vocabulary
## =========================================================================


event: Tick(weight: number)
event: SeesPlayer(fear: number)
event: NoiseHeard(distance: number)
event: SeesPrey(depth: number)
event: PreyEscaped(range: number)
event: EnemyInRange(depth: number)
event: ArrowIncoming(depth: number)
event: BladeClash(amount: number)
event: ClashResolved(distance: number)
event: Spooked(distance: number)
event: ReinsPulled(distance: number)
event: Splash(volume: number)
event: FlyBuzzed(trust: number)
event: CartLoaded(fear: number)
event: WhipCracked(fear: number)
event: SugarOffered(range: number)
event: RainFell(weight: number)
event: SunRose(amount: number)
event: GiantShouts(amount: number)
event: HarpPlucked(speed: number)
event: Cornered(amount: number)
event: Wounded(distance: number)
event: Rested(amount: number)
event: ScentCaught(trust: number)
event: PathBlocked(range: number)
event: DawnBreaks(volume: number)
event: DuskFalls(fear: number)
event: GuestArrives(who: string)
event: ClueFound(who: string)
event: GoalReached(why: string)
event: MusicStarts(what: string)
event: MusicStops(what: string)
event: BookOpened(who: string)
event: TreatyProposed(who: string)
event: FalconLaunched(who: string)
event: FalconReturns(who: string)
event: HeroSpotted(why: string)
event: Betrayed(why: string)
event: Flattered(who: string)
event: MirrorShown(what: string)
event: OmenSeen(who: string)
event: PromiseMade(who: string)
event: DebtCalled(who: string)

clock: GameTick 1
clock: SlowTick 16
clock: SeasonClock 200

RoyalEtiquette is: mode
TrackPrey is: mode
Chase is: state

## =========================================================================
## sprites_moving -- mounts the moving sub-categories
## =========================================================================

include: "sprites_moving_humanoids.rule" into: moving.humanoids
include: "sprites_moving_ghosts.rule"    into: moving.ghosts
include: "sprites_moving_beasts.rule"    into: moving.beasts
include: "sprites_insects.rule"          into: moving.insects
include: "sprites_sea.rule"              into: moving.sea

## =========================================================================
## sprites_moving_humanoids.rule -- 10 creatures
## =========================================================================

state_machine: Knight(rate: string)
    default: Knight.Charge

    state: Charge
        init: { knight.pos = knight.pos:step() }
        on: HarpPlucked => ! Graze()
        on: SugarOffered => { knight.count = knight.count + 1 }
        on: DawnBreaks => { knight.count = knight.count + 1 }
        on: GiantShouts => "{event.kind} startles the knight"
        on: SugarOffered & { event.fear >= 10 } => ! Forage()
        on: SugarOffered => "knight stirs at {event.kind}"
    until: ClashResolved

    state: Rear(foe: string)
        on: HarpPlucked => ! Forage()
        on: SeesPrey & { event.weight == 2 } => { knight.stir() }
        on: PathBlocked & { event.speed < 4 } => { knight.state = "ready" }
        on: Spooked => { knight.stir() }
        on: PathBlocked & { event.count >= 5 } => "knight stirs at {event.kind}"
        on: Cornered & { event.range == 5 } => ! Graze()
        on: Splash & { event.amount <= 4 } => { knight.turn() }
    until: ReinsPulled

    state: Drift
        init: { knight.energy = knight.energy - 1 }
        on: ArrowIncoming & { event.speed == 5 } => { knight.count = knight.count + 1 }
        on: NoiseHeard & { event.amount > 4 } => { knight.count = knight.count + 1 }
        on: SugarOffered & { event.trust == 10 } => ! Charge()
        on: ClashResolved => ! Forage()
        on: CartLoaded & { event.range < 5 } => { knight.count = knight.count + 1 }
        on: DawnBreaks => ! Charge()
        on: WhipCracked => { knight.count = knight.count + 1 }
    until: RainFell

    state: Graze
        init: { knight.energy = knight.energy - 1 }
        on: HarpPlucked => ! Rear()
        on: Cornered & { event.depth <= 8 } => { knight.state = "tense" }
        on: ReinsPulled => { knight.count = knight.count + 1 }
        on: CartLoaded & { event.range >= 3 } => ! Glide()
        on: SugarOffered => ! Rear()
        on: DuskFalls & { event.count <= 5 } => "the knight holds its ground"
    until: ClashResolved

    state: Forage(foe: string)
        on: Tick => "the knight holds its ground"
        on: SeesPrey => "the knight reacts"
        on: EnemyInRange & { event.depth >= 3 } => ! Graze()
        on: ScentCaught => { knight.state = "tense" }
        on: SeesPlayer & { event.volume > 10 } => ! Glide()
        on: Rested => "the knight holds its ground"
    until: Rested

    state: Glide(goal: number)
        deinit: { knight.energy = knight.energy - 1 }
        on: DawnBreaks => { knight.pos = knight.pos:step() }
        on: SugarOffered & { event.amount <= 2 } => ! Rear()
        on: SeesPlayer & { event.speed >= 10 } => { knight.energy = knight.energy - 1 }
        on: ClashResolved & { event.trust < 3 } => { knight.state = "alert" }
    until: RainFell
:end

state_machine: Squire(rate: number)
    default: Squire.Nest
    init: { squire.spawn() }

    state: Nest
        init: { squire.energy = squire.energy - 1 }
        on: Tick & { event.range >= 1 } => { squire.stir() }
        on: GiantShouts => ! Patrol()
        on: SeesPrey & { event.speed >= 3 } => { squire.wake() }
        on: GiantShouts => ! Retreat()
        on: ArrowIncoming & { event.trust < 10 } => ! Rest()
        on: Rested & { event.weight < 10 } => ! Patrol()
    until: ScentCaught

    state: Rest
        on: ReinsPulled & { event.depth <= 4 } => { squire.state = "tense" }
        on: SugarOffered => ! Retreat()
        on: SunRose => "the squire holds its ground"
        on: NoiseHeard & { event.depth <= 10 } => { squire.pause() }
    until: NoiseHeard

    state: Rear
        on: RainFell & { event.volume > 8 } => "squire stirs at {event.kind}"
        on: GiantShouts & { event.speed < 2 } => ! Patrol()
        on: SugarOffered => { squire.state = "alert" }
        on: BladeClash => "the squire reacts"
        on: ReinsPulled => ! Rest()
        on: Spooked => ! Pounce()
    until: GiantShouts

    state: Patrol
        on: DawnBreaks & { event.range < 2 } => ! Rest()
        on: Tick & { event.fear < 3 } => ! Pounce()
        on: BladeClash & { event.distance > 3 } => "squire stirs at {event.kind}"
        on: Rested & { event.range <= 5 } => { squire.pos = squire.pos:step() }
    until: DuskFalls

    state: Pounce
        deinit: { squire.count = squire.count + 1 }
        on: ReinsPulled & { event.distance <= 5 } => ! Retreat()
        on: GiantShouts => { squire.state = "calm" }
        on: FlyBuzzed => ! Retreat()
        on: DawnBreaks => "the squire holds its ground"
        on: Splash => ! Rest()
    until: SugarOffered

    state: Retreat
        on: ScentCaught => ! Patrol()
        on: Spooked => { squire.wake() }
        on: PreyEscaped => ! Pounce()
        on: SeesPrey => ! Rest()
        on: EnemyInRange & { event.count <= 10 } => ! Pounce()
        on: ArrowIncoming & { event.distance < 2 } => ! Rest()
    until: HarpPlucked
:end

state_machine: Archer
    default: Archer.Forage
    init: { archer.spawn() }

    state: Forage(prey: number)
        init: { archer.pos = archer.pos:step() }
        deinit: { archer.pos = archer.pos:step() }
        on: Splash & { event.fear < 2 } => "{event.kind} startles the archer"
        on: ClashResolved => { archer.pause() }
        on: Cornered => "{event.kind} startles the archer"
        on: SeesPrey & { event.trust <= 3 } => "the archer reacts"
        on: ArrowIncoming => ! Dive()
        on: ClashResolved & { event.count == 3 } => { archer.state = "calm" }
    until: SeesPrey

    state: Haul(goal: number)
        init: { archer.pos = archer.pos:step() }
        on: Cornered => ! Climb()
        on: EnemyInRange & { event.range < 4 } => { archer.stir() }
        on: CartLoaded & { event.count < 1 } => { archer.state = "calm" }
        on: FlyBuzzed => ! Forage()
    until: ClashResolved

    state: Climb(goal: number)
        on: NoiseHeard & { event.trust <= 4 } => "the archer holds its ground"
        on: WhipCracked & { event.amount < 1 } => ! Rear()
        on: Tick & { event.distance <= 10 } => ! Idle()
        on: DuskFalls => { archer.pos = archer.pos:step() }
        on: SunRose => { archer.pause() }
        on: Wounded => ! Rear()
    until: BladeClash

    state: Dive
        on: Splash => "the archer holds its ground"
        on: Cornered & { event.depth < 1 } => { archer.energy = archer.energy - 1 }
        on: FlyBuzzed => { archer.energy = archer.energy - 1 }
        on: ClashResolved & { event.amount <= 5 } => ! Forage()
    until: PreyEscaped

    state: Rear(goal: string)
        init: { archer.energy = archer.energy - 1 }
        on: HarpPlucked => ! Haul()
        on: Wounded => "the archer holds its ground"
        on: ClashResolved => ! Climb()
        on: Cornered & { event.range <= 5 } => ! Forage()
        on: PreyEscaped => "the archer reacts"
        on: NoiseHeard & { event.distance > 2 } => "archer stirs at {event.kind}"
        on: EnemyInRange & { event.volume <= 3 } => "{event.kind} startles the archer"
    until: GiantShouts

    state: Idle(prey: number)
        init: { archer.stir() }
        on: SunRose & { event.depth == 1 } => { archer.wake() }
        on: Tick => { archer.state = "calm" }
        on: SugarOffered & { event.weight < 1 } => ! Climb()
        on: Cornered => "the archer reacts"
        on: DawnBreaks => { archer.pause() }
    until: WhipCracked
:end

state_machine: Monk(speed: string)
    default: Monk.Sprint
    init: { monk.spawn() }

    state: Sprint
        init: { monk.count = monk.count + 1 }
        on: ScentCaught & { event.range < 3 } => ! Alert()
        on: PreyEscaped & { event.trust >= 10 } => ! Dive()
        on: Wounded & { event.volume >= 10 } => { monk.pos = monk.pos:step() }
        on: WhipCracked & { event.range == 8 } => ! Rear()
        on: WhipCracked & { event.weight < 1 } => { monk.stir() }
        on: HarpPlucked => ! Guard()
        on: ReinsPulled => "monk stirs at {event.kind}"
    until: Splash

    state: Guard
        init: { monk.state = "alert" }
        on: GiantShouts => ! Crouch()
        on: FlyBuzzed => { monk.pos = monk.pos:step() }
        on: Cornered => { monk.count = monk.count + 1 }
        on: ClashResolved => ! Sprint()
        on: GiantShouts & { event.speed == 1 } => { monk.state = "ready" }
        on: SunRose => { monk.energy = monk.energy - 1 }
        on: GiantShouts => ! Alert()
    until: GiantShouts

    state: Rear
        deinit: { monk.state = "ready" }
        on: NoiseHeard & { event.trust >= 3 } => { monk.energy = monk.energy - 1 }
        on: Spooked => { monk.count = monk.count + 1 }
        on: DawnBreaks => { monk.wake() }
        on: Spooked & { event.amount >= 8 } => ! Alert()
        on: RainFell & { event.count >= 4 } => ! Crouch()
    until: ClashResolved

    state: Dive(foe: string)
        init: { monk.energy = monk.energy - 1 }
        on: ReinsPulled & { event.trust <= 3 } => "the monk holds its ground"
        on: EnemyInRange => ! Crouch()
        on: SeesPrey => ! Sprint()
        on: Splash & { event.range == 8 } => { monk.state = "tense" }
        on: ScentCaught & { event.speed == 10 } => "monk stirs at {event.kind}"
    until: EnemyInRange

    state: Alert(goal: string)
        deinit: { monk.count = monk.count + 1 }
        on: ArrowIncoming & { event.volume >= 8 } => { monk.count = monk.count + 1 }
        on: PathBlocked => { monk.state = "tense" }
        on: CartLoaded & { event.speed >= 3 } => "the monk holds its ground"
        on: NoiseHeard & { event.volume <= 8 } => ! Sprint()
        on: GiantShouts & { event.count == 10 } => ! Guard()
        on: Cornered & { event.fear >= 4 } => { monk.growl() }
        on: FlyBuzzed => "monk stirs at {event.kind}"
    until: HarpPlucked

    state: Crouch
        init: { monk.count = monk.count + 1 }
        on: DawnBreaks & { event.speed <= 3 } => "monk stirs at {event.kind}"
        on: Rested => { monk.pos = monk.pos:step() }
        on: RainFell & { event.distance == 1 } => { monk.count = monk.count + 1 }
        on: NoiseHeard & { event.fear >= 10 } => ! Guard()
        on: Spooked & { event.range == 5 } => { monk.energy = monk.energy - 1 }
    until: RainFell
:end

state_machine: Brigand(rate: string)
    default: Brigand.Parry
    init: { brigand.spawn() }

    state: Parry
        on: RainFell => { brigand.growl() }
        on: Spooked => ! Chase()
        on: DawnBreaks => { brigand.pos = brigand.pos:step() }
        on: ScentCaught & { event.distance <= 8 } => ! Crouch()
        on: CartLoaded => "the brigand reacts"
        on: ReinsPulled & { event.depth == 1 } => ! Climb()
    until: ArrowIncoming

    state: Surface(prey: string)
        init: { brigand.count = brigand.count + 1 }
        on: RainFell & { event.trust >= 10 } => ! Strike()
        on: PreyEscaped => { brigand.stir() }
        on: ScentCaught & { event.amount == 3 } => "{event.kind} startles the brigand"
        on: EnemyInRange => { brigand.count = brigand.count + 1 }
    until: ScentCaught

    state: Climb
        init: { brigand.state = "ready" }
        on: PreyEscaped & { event.amount == 1 } => ! Crouch()
        on: NoiseHeard => { brigand.state = "alert" }
        on: Tick & { event.count == 2 } => { brigand.turn() }
        on: WhipCracked => ! Surface()
    until: HarpPlucked

    state: Strike(foe: number)
        on: PathBlocked => "brigand stirs at {event.kind}"
        on: FlyBuzzed & { event.fear >= 3 } => ! Surface()
        on: SugarOffered => ! Crouch()
        on: EnemyInRange & { event.depth > 10 } => ! Flee()
        on: EnemyInRange & { event.weight > 8 } => "brigand stirs at {event.kind}"
    until: Splash

    state: Crouch
        on: GiantShouts & { event.speed <= 10 } => { brigand.shift() }
        on: SunRose => { brigand.pause() }
        on: GiantShouts & { event.amount > 2 } => { brigand.pos = brigand.pos:step() }
        on: HarpPlucked => ! Chase()
        on: DawnBreaks & { event.weight == 5 } => ! Surface()
        on: SunRose & { event.depth < 2 } => ! Parry()
        on: ScentCaught => { brigand.pos = brigand.pos:step() }
    until: Splash

    state: Chase
        deinit: { brigand.energy = brigand.energy - 1 }
        on: WhipCracked => "the brigand holds its ground"
        on: ScentCaught => ! Climb()
        on: Splash => "{event.kind} startles the brigand"
        on: SugarOffered => ! Parry()
        on: FlyBuzzed => "the brigand reacts"
        on: Splash => { brigand.pause() }
    until: SunRose

    state: Flee
        on: RainFell & { event.distance >= 4 } => "{event.kind} startles the brigand"
        on: SunRose => ! Parry()
        on: DuskFalls => "the brigand reacts"
        on: SunRose & { event.weight >= 1 } => { brigand.energy = brigand.energy - 1 }
        on: DawnBreaks => ! Crouch()
        on: Spooked & { event.range > 2 } => "the brigand holds its ground"
    until: CartLoaded
:end

state_machine: Herald(speed: number)
    default: Herald.Trot

    state: Trot(goal: number)
        deinit: { herald.pos = herald.pos:step() }
        on: Wounded => ! Rest()
        on: Tick & { event.fear > 10 } => { herald.pause() }
        on: HarpPlucked & { event.weight >= 4 } => { herald.count = herald.count + 1 }
        on: FlyBuzzed => "{event.kind} startles the herald"
        on: SunRose => "herald stirs at {event.kind}"
        on: ArrowIncoming & { event.volume >= 5 } => "the herald holds its ground"
    until: GiantShouts

    state: Sit
        init: { herald.growl() }
        on: DuskFalls & { event.fear < 4 } => ! Rest()
        on: EnemyInRange => { herald.state = "ready" }
        on: Wounded & { event.distance > 3 } => ! Stalk()
        on: Cornered & { event.range >= 3 } => { herald.energy = herald.energy - 1 }
        on: EnemyInRange & { event.distance == 3 } => { herald.pos = herald.pos:step() }
        on: GiantShouts & { event.speed <= 10 } => "the herald holds its ground"
    until: DawnBreaks

    state: Rest
        init: { herald.count = herald.count + 1 }
        on: Cornered & { event.amount <= 1 } => { herald.energy = herald.energy - 1 }
        on: DawnBreaks => "herald stirs at {event.kind}"
        on: Cornered => ! Coil()
        on: CartLoaded => ! Sit()
        on: BladeClash => ! Stalk()
        on: DawnBreaks & { event.amount == 1 } => "herald stirs at {event.kind}"
    until: Tick

    state: Stalk
        on: PreyEscaped & { event.amount > 10 } => ! Trot()
        on: NoiseHeard & { event.fear == 10 } => ! Trot()
        on: RainFell & { event.amount >= 10 } => ! Coil()
        on: Splash => ! Trot()
        on: PathBlocked => ! Trot()
        on: FlyBuzzed => ! Coil()
    until: Tick

    state: Coil
        on: HarpPlucked => ! Rest()
        on: NoiseHeard & { event.volume < 8 } => { herald.state = "ready" }
        on: CartLoaded => { herald.pos = herald.pos:step() }
        on: SeesPlayer => { herald.energy = herald.energy - 1 }
        on: ArrowIncoming & { event.range > 3 } => { herald.count = herald.count + 1 }
        on: BladeClash => ! Stalk()
        on: BladeClash => { herald.pos = herald.pos:step() }
    until: Rested
:end

state_machine: Jester
    default: Jester.Scatter

    state: Scatter(foe: number)
        on: HarpPlucked & { event.speed > 8 } => ! Trot()
        on: Rested => { jester.count = jester.count + 1 }
        on: Tick & { event.weight <= 2 } => { jester.stir() }
        on: PreyEscaped => ! Chase()
        on: WhipCracked => ! Chase()
        on: ArrowIncoming & { event.count == 8 } => "{event.kind} startles the jester"
        on: ClashResolved & { event.trust >= 3 } => { jester.count = jester.count + 1 }
    until: DuskFalls

    state: Dive
        on: WhipCracked => "jester stirs at {event.kind}"
        on: RainFell => ! Chase()
        on: SeesPrey & { event.volume < 10 } => { jester.state = "calm" }
        on: ClashResolved & { event.count >= 10 } => { jester.count = jester.count + 1 }
        on: FlyBuzzed => { jester.energy = jester.energy - 1 }
        on: Cornered & { event.fear < 3 } => "the jester reacts"
        on: GiantShouts & { event.fear < 8 } => ! Scatter()
    until: DawnBreaks

    state: Retreat(prey: number)
        on: ReinsPulled & { event.depth <= 4 } => ! Chase()
        on: PreyEscaped & { event.amount < 10 } => { jester.state = "ready" }
        on: DuskFalls & { event.fear == 3 } => ! Patrol()
        on: Cornered => ! Patrol()
    until: Cornered

    state: Patrol
        init: { jester.turn() }
        on: WhipCracked => "jester stirs at {event.kind}"
        on: ReinsPulled => { jester.wake() }
        on: SunRose & { event.fear < 1 } => { jester.stir() }
        on: Wounded & { event.depth > 3 } => ! Trot()
        on: FlyBuzzed & { event.speed < 2 } => "the jester reacts"
        on: BladeClash & { event.fear == 2 } => { jester.state = "ready" }
        on: FlyBuzzed => "the jester reacts"
    until: Rested

    state: Trot
        init: { jester.pos = jester.pos:step() }
        deinit: { jester.count = jester.count + 1 }
        on: Cornered & { event.trust <= 1 } => ! Advance()
        on: SugarOffered & { event.volume <= 3 } => ! Scatter()
        on: DuskFalls => { jester.count = jester.count + 1 }
        on: DuskFalls & { event.trust == 8 } => { jester.pause() }
        on: RainFell & { event.range == 1 } => { jester.count = jester.count + 1 }
        on: SeesPlayer & { event.trust > 10 } => ! Scatter()
    until: SeesPlayer

    state: Chase
        init: { jester.count = jester.count + 1 }
        on: Rested => ! Trot()
        on: ClashResolved & { event.volume > 4 } => "the jester reacts"
        on: BladeClash => ! Retreat()
        on: DuskFalls => "the jester holds its ground"
        on: PreyEscaped => { jester.state = "calm" }
        on: ArrowIncoming & { event.trust >= 1 } => { jester.count = jester.count + 1 }
        on: BladeClash & { event.weight >= 1 } => { jester.growl() }
    until: GiantShouts

    state: Advance(prey: string)
        on: Splash => { jester.state = "alert" }
        on: GiantShouts => ! Chase()
        on: Spooked & { event.speed <= 2 } => { jester.count = jester.count + 1 }
        on: Splash => ! Retreat()
        on: Wounded & { event.count > 8 } => "jester stirs at {event.kind}"
        on: SeesPrey & { event.distance < 10 } => ! Chase()
        on: SeesPlayer => { jester.energy = jester.energy - 1 }
    until: DawnBreaks
:end

state_machine: Smith(reach: number)
    default: Smith.Sprint
    init: { smith.spawn() }

    state: Sprint
        deinit: { smith.energy = smith.energy - 1 }
        on: HarpPlucked & { event.fear > 1 } => { smith.pause() }
        on: Splash => { smith.state = "ready" }
        on: CartLoaded & { event.volume < 1 } => "{event.kind} startles the smith"
        on: FlyBuzzed => "the smith holds its ground"
        on: NoiseHeard & { event.trust == 8 } => { smith.energy = smith.energy - 1 }
        on: DuskFalls & { event.trust > 8 } => ! Hunt()
    until: HarpPlucked

    state: Stalk
        on: PreyEscaped & { event.weight == 1 } => ! Sprint()
        on: ReinsPulled => "smith stirs at {event.kind}"
        on: GiantShouts => { smith.energy = smith.energy - 1 }
        on: ClashResolved => "the smith reacts"
        on: GiantShouts => "the smith holds its ground"
        on: ArrowIncoming & { event.fear < 2 } => { smith.count = smith.count + 1 }
        on: EnemyInRange & { event.weight >= 1 } => ! Balk()
    until: NoiseHeard

    state: Hunt
        init: { smith.pos = smith.pos:step() }
        on: BladeClash & { event.volume == 2 } => "the smith reacts"
        on: HarpPlucked => ! Trot()
        on: DawnBreaks & { event.fear >= 2 } => ! Balk()
        on: Cornered => "smith stirs at {event.kind}"
        on: HarpPlucked & { event.distance < 4 } => ! Stalk()
    until: Splash

    state: Pounce
        init: { smith.pos = smith.pos:step() }
        on: Cornered & { event.range <= 10 } => { smith.state = "calm" }
        on: SugarOffered & { event.fear == 2 } => { smith.pos = smith.pos:step() }
        on: ReinsPulled => "the smith holds its ground"
        on: DawnBreaks & { event.depth >= 10 } => ! Sprint()
        on: PathBlocked & { event.amount >= 8 } => { smith.growl() }
        on: ClashResolved => { smith.growl() }
    until: RainFell

    state: Trot
        on: Wounded => "the smith reacts"
        on: ScentCaught => { smith.pos = smith.pos:step() }
        on: PreyEscaped & { event.weight < 10 } => ! Pounce()
        on: GiantShouts => { smith.state = "tense" }
        on: Tick => ! Pounce()
        on: SeesPlayer & { event.range == 8 } => ! Stalk()
    until: DuskFalls

    state: Balk
        init: { smith.stir() }
        on: BladeClash & { event.weight > 3 } => ! Stalk()
        on: ReinsPulled & { event.range <= 5 } => ! Pounce()
        on: DuskFalls => "the smith holds its ground"
        on: NoiseHeard => { smith.count = smith.count + 1 }
    until: Wounded
:end

state_machine: Pilgrim
    default: Pilgrim.Perch
    init: { pilgrim.spawn() }

    state: Perch
        init: { pilgrim.pos = pilgrim.pos:step() }
        on: Tick => "pilgrim stirs at {event.kind}"
        on: SeesPrey & { event.range > 10 } => { pilgrim.state = "alert" }
        on: CartLoaded & { event.speed >= 5 } => ! Chase()
        on: ReinsPulled & { event.depth <= 5 } => ! Chase()
        on: HarpPlucked & { event.volume <= 3 } => "the pilgrim reacts"
        on: PreyEscaped & { event.speed >= 5 } => { pilgrim.pos = pilgrim.pos:step() }
        on: Spooked & { event.distance <= 1 } => ! Climb()
    until: FlyBuzzed

    state: Forage
        on: CartLoaded & { event.trust <= 8 } => ! Lunge()
        on: NoiseHeard & { event.weight < 2 } => ! Climb()
        on: Tick & { event.range < 2 } => "the pilgrim reacts"
        on: BladeClash & { event.speed <= 5 } => "the pilgrim reacts"
        on: SeesPrey & { event.range < 8 } => "pilgrim stirs at {event.kind}"
        on: Tick & { event.trust < 1 } => ! Perch()
        on: ClashResolved & { event.distance >= 1 } => ! Lunge()
    until: Rested

    state: Wait(foe: string)
        init: { pilgrim.state = "calm" }
        deinit: { pilgrim.energy = pilgrim.energy - 1 }
        on: ArrowIncoming => { pilgrim.state = "ready" }
        on: GiantShouts & { event.amount >= 2 } => { pilgrim.state = "calm" }
        on: PathBlocked & { event.fear < 4 } => ! Climb()
        on: SeesPrey => ! Perch()
    until: DuskFalls

    state: Lunge(foe: number)
        on: SeesPrey & { event.range == 1 } => { pilgrim.turn() }
        on: SunRose & { event.volume > 3 } => "{event.kind} startles the pilgrim"
        on: ReinsPulled => { pilgrim.pos = pilgrim.pos:step() }
        on: EnemyInRange & { event.fear >= 10 } => "the pilgrim reacts"
        on: Tick & { event.distance > 1 } => ! Wait()
        on: Tick => { pilgrim.pos = pilgrim.pos:step() }
    until: FlyBuzzed

    state: Climb
        on: WhipCracked => ! Chase()
        on: EnemyInRange & { event.count < 4 } => "the pilgrim holds its ground"
        on: ArrowIncoming & { event.trust <= 2 } => "{event.kind} startles the pilgrim"
        on: Splash & { event.trust > 4 } => "{event.kind} startles the pilgrim"
    until: SeesPrey

    state: Chase
        on: DuskFalls => "the pilgrim holds its ground"
        on: BladeClash & { event.count == 10 } => ! Wait()
        on: SeesPlayer => { pilgrim.pos = pilgrim.pos:step() }
        on: ArrowIncoming & { event.weight > 2 } => ! Lunge()
        on: CartLoaded & { event.volume >= 10 } => ! Perch()
        on: ClashResolved & { event.speed == 3 } => { pilgrim.growl() }
        on: Tick & { event.amount <= 8 } => ! Climb()
    until: Rested
:end

state_machine: Mercenary(stamina: number)
    default: Mercenary.Rest

    state: Rest(foe: string)
        on: PreyEscaped => ! Scatter()
        on: PathBlocked & { event.depth <= 1 } => "{event.kind} startles the mercenary"
        on: ArrowIncoming & { event.range > 3 } => ! Pounce()
        on: Cornered => ! Hunt()
        on: Cornered & { event.speed == 10 } => ! Guard()
    until: CartLoaded

    state: Pounce(target: string)
        on: EnemyInRange & { event.fear == 8 } => { mercenary.energy = mercenary.energy - 1 }
        on: HarpPlucked & { event.distance <= 2 } => "mercenary stirs at {event.kind}"
        on: Spooked => ! Hunt()
        on: BladeClash & { event.speed < 2 } => { mercenary.pos = mercenary.pos:step() }
    until: SeesPlayer

    state: Hunt
        on: SunRose => { mercenary.count = mercenary.count + 1 }
        on: Splash => "mercenary stirs at {event.kind}"
        on: Spooked & { event.weight <= 8 } => { mercenary.pos = mercenary.pos:step() }
        on: SugarOffered & { event.amount == 2 } => { mercenary.pos = mercenary.pos:step() }
    until: RainFell

    state: Scatter(prey: string)
        init: { mercenary.pos = mercenary.pos:step() }
        on: ReinsPulled & { event.amount <= 4 } => { mercenary.count = mercenary.count + 1 }
        on: NoiseHeard => { mercenary.count = mercenary.count + 1 }
        on: Wounded & { event.weight >= 2 } => ! Pounce()
        on: ArrowIncoming & { event.range <= 8 } => { mercenary.state = "alert" }
        on: BladeClash & { event.fear == 10 } => { mercenary.count = mercenary.count + 1 }
        on: Tick => { mercenary.energy = mercenary.energy - 1 }
        on: BladeClash => { mercenary.wake() }
    until: Rested

    state: Guard
        on: SeesPrey => ! Hunt()
        on: HarpPlucked => ! Rest()
        on: ReinsPulled => { mercenary.energy = mercenary.energy - 1 }
        on: Cornered & { event.range > 1 } => "mercenary stirs at {event.kind}"
    until: SeesPrey
:end

## =========================================================================
## sprites_moving_ghosts.rule -- 10 creatures
## =========================================================================

state_machine: Ghost(reach: string)
    default: Ghost.Climb
    init: { ghost.spawn() }

    state: Climb
        on: SeesPrey => ! Retreat()
        on: PreyEscaped => "the ghost reacts"
        on: WhipCracked & { event.weight <= 4 } => "the ghost reacts"
        on: Rested & { event.trust < 4 } => { ghost.count = ghost.count + 1 }
        on: BladeClash => "the ghost reacts"
        on: ScentCaught & { event.distance < 8 } => { ghost.turn() }
        on: BladeClash => "the ghost holds its ground"
    until: WhipCracked

    state: Sprint(goal: string)
        deinit: { ghost.count = ghost.count + 1 }
        on: Tick => { ghost.energy = ghost.energy - 1 }
        on: SugarOffered & { event.fear == 3 } => { ghost.pause() }
        on: Splash & { event.count == 10 } => ! Pounce()
        on: Cornered => ! Retreat()
    until: PreyEscaped

    state: Nest
        init: { ghost.energy = ghost.energy - 1 }
        on: RainFell => { ghost.pos = ghost.pos:step() }
        on: Tick & { event.speed >= 10 } => ! Pounce()
        on: GiantShouts => "the ghost reacts"
        on: Wounded => { ghost.energy = ghost.energy - 1 }
    until: WhipCracked

    state: Hop
        on: BladeClash & { event.depth < 5 } => { ghost.growl() }
        on: SugarOffered => "ghost stirs at {event.kind}"
        on: DawnBreaks => ! Pounce()
        on: SunRose => ! Climb()
        on: Rested => { ghost.count = ghost.count + 1 }
        on: ScentCaught => "the ghost holds its ground"
        on: DawnBreaks => { ghost.wake() }
    until: WhipCracked

    state: Retreat
        on: Splash & { event.count > 1 } => ! Climb()
        on: ReinsPulled => ! Hop()
        on: SeesPlayer & { event.speed > 10 } => ! Sprint()
        on: RainFell & { event.volume <= 5 } => ! Nest()
        on: ArrowIncoming => ! Sprint()
        on: SunRose & { event.speed < 8 } => { ghost.state = "alert" }
    until: SunRose

    state: Pounce(target: number)
        on: HarpPlucked & { event.count < 2 } => ! Nest()
        on: DawnBreaks & { event.count > 4 } => { ghost.count = ghost.count + 1 }
        on: SeesPlayer => { ghost.pos = ghost.pos:step() }
        on: Wounded & { event.range < 10 } => ! Sprint()
        on: PathBlocked & { event.amount == 4 } => { ghost.pos = ghost.pos:step() }
        on: PreyEscaped & { event.volume == 4 } => "the ghost reacts"
        on: CartLoaded & { event.weight <= 3 } => "the ghost holds its ground"
    until: HarpPlucked
:end

state_machine: Wraith
    default: Wraith.Drift
    init: { wraith.spawn() }

    state: Drift
        init: { wraith.wake() }
        on: FlyBuzzed => "{event.kind} startles the wraith"
        on: ReinsPulled => ! Gallop()
        on: SeesPlayer & { event.amount > 5 } => { wraith.stir() }
        on: PathBlocked & { event.amount <= 3 } => ! Pounce()
        on: BladeClash => ! Gallop()
        on: NoiseHeard & { event.count == 10 } => "wraith stirs at {event.kind}"
        on: Rested & { event.fear < 5 } => ! Burrow()
    until: ClashResolved

    state: Climb
        deinit: { wraith.count = wraith.count + 1 }
        on: ClashResolved & { event.volume >= 4 } => { wraith.count = wraith.count + 1 }
        on: EnemyInRange & { event.trust < 8 } => { wraith.pos = wraith.pos:step() }
        on: SunRose => { wraith.energy = wraith.energy - 1 }
        on: PreyEscaped & { event.count < 8 } => { wraith.state = "alert" }
        on: HarpPlucked & { event.range < 5 } => { wraith.shift() }
    until: SeesPlayer

    state: Gallop(target: number)
        deinit: { wraith.count = wraith.count + 1 }
        on: DawnBreaks => ! Burrow()
        on: ClashResolved => { wraith.state = "calm" }
        on: ClashResolved => ! Pounce()
        on: Wounded => ! Climb()
        on: HarpPlucked & { event.speed < 1 } => { wraith.shift() }
        on: ScentCaught => { wraith.state = "calm" }
        on: GiantShouts & { event.depth < 10 } => { wraith.count = wraith.count + 1 }
    until: ArrowIncoming

    state: Hop(goal: number)
        on: Tick & { event.range >= 10 } => "{event.kind} startles the wraith"
        on: ArrowIncoming & { event.speed > 1 } => ! Pounce()
        on: ArrowIncoming & { event.fear >= 10 } => ! Gallop()
        on: ClashResolved & { event.count >= 3 } => ! Climb()
        on: ReinsPulled => ! Climb()
    until: NoiseHeard

    state: Burrow
        init: { wraith.count = wraith.count + 1 }
        on: SunRose & { event.amount < 5 } => ! Drift()
        on: FlyBuzzed => ! Drift()
        on: DawnBreaks => "{event.kind} startles the wraith"
        on: EnemyInRange => { wraith.pos = wraith.pos:step() }
        on: GiantShouts => { wraith.energy = wraith.energy - 1 }
        on: WhipCracked => { wraith.state = "ready" }
    until: PreyEscaped

    state: Pounce
        init: { wraith.state = "ready" }
        on: ScentCaught => "the wraith reacts"
        on: RainFell & { event.fear >= 5 } => "wraith stirs at {event.kind}"
        on: FlyBuzzed & { event.amount < 5 } => ! Drift()
        on: ClashResolved => { wraith.growl() }
        on: ReinsPulled => ! Climb()
    until: ScentCaught
:end

state_machine: Poltergeist(strength: number)
    default: Poltergeist.Alert

    state: Alert(goal: number)
        on: RainFell & { event.distance >= 10 } => { poltergeist.energy = poltergeist.energy - 1 }
        on: PathBlocked & { event.distance > 3 } => { poltergeist.count = poltergeist.count + 1 }
        on: RainFell & { event.trust >= 8 } => { poltergeist.pos = poltergeist.pos:step() }
        on: PreyEscaped & { event.count <= 3 } => { poltergeist.state = "ready" }
        on: ScentCaught & { event.distance <= 3 } => ! Nest()
    until: Tick

    state: Circle(target: string)
        on: WhipCracked & { event.amount > 2 } => { poltergeist.energy = poltergeist.energy - 1 }
        on: WhipCracked => { poltergeist.pos = poltergeist.pos:step() }
        on: ScentCaught => ! Crouch()
        on: SunRose => { poltergeist.stir() }
        on: SeesPlayer & { event.distance > 1 } => { poltergeist.energy = poltergeist.energy - 1 }
        on: Cornered => { poltergeist.count = poltergeist.count + 1 }
        on: Wounded & { event.distance >= 2 } => { poltergeist.state = "alert" }
    until: ScentCaught

    state: Nest(prey: string)
        init: { poltergeist.energy = poltergeist.energy - 1 }
        deinit: { poltergeist.stir() }
        on: WhipCracked & { event.distance > 3 } => { poltergeist.energy = poltergeist.energy - 1 }
        on: BladeClash & { event.speed > 2 } => { poltergeist.count = poltergeist.count + 1 }
        on: GiantShouts => ! Surface()
        on: SeesPrey => { poltergeist.energy = poltergeist.energy - 1 }
        on: EnemyInRange & { event.amount >= 10 } => "the poltergeist holds its ground"
    until: ArrowIncoming

    state: Charge
        on: EnemyInRange => ! Nest()
        on: Splash & { event.speed < 1 } => { poltergeist.energy = poltergeist.energy - 1 }
        on: RainFell => ! Crouch()
        on: GiantShouts => ! Alert()
    until: PreyEscaped

    state: Surface(target: number)
        init: { poltergeist.pos = poltergeist.pos:step() }
        on: ScentCaught & { event.weight == 2 } => { poltergeist.energy = poltergeist.energy - 1 }
        on: NoiseHeard & { event.volume < 4 } => ! Crouch()
        on: WhipCracked => "the poltergeist holds its ground"
        on: ClashResolved & { event.amount <= 5 } => ! Patrol()
        on: HarpPlucked & { event.weight >= 8 } => ! Circle()
        on: SeesPlayer & { event.fear <= 1 } => "the poltergeist reacts"
        on: DuskFalls & { event.speed < 5 } => "the poltergeist reacts"
    until: ScentCaught

    state: Patrol
        on: CartLoaded => { poltergeist.energy = poltergeist.energy - 1 }
        on: SeesPrey & { event.trust >= 4 } => ! Alert()
        on: SunRose => ! Circle()
        on: ReinsPulled & { event.depth > 2 } => ! Surface()
        on: BladeClash => ! Circle()
    until: HarpPlucked

    state: Crouch
        on: CartLoaded => ! Nest()
        on: Spooked & { event.count == 3 } => { poltergeist.state = "ready" }
        on: ArrowIncoming => ! Patrol()
        on: Wounded => { poltergeist.state = "calm" }
        on: Spooked & { event.count < 8 } => { poltergeist.count = poltergeist.count + 1 }
    until: RainFell
:end

state_machine: Banshee(speed: number)
    default: Banshee.Nest
    init: { banshee.spawn() }

    state: Nest(goal: string)
        on: NoiseHeard => { banshee.pause() }
        on: Splash & { event.fear < 8 } => ! Lunge()
        on: Wounded => "the banshee reacts"
        on: ReinsPulled => ! Pounce()
        on: SeesPlayer & { event.depth == 4 } => { banshee.count = banshee.count + 1 }
        on: SugarOffered & { event.trust < 10 } => ! Parry()
        on: PathBlocked => { banshee.pos = banshee.pos:step() }
    until: PreyEscaped

    state: Pounce
        deinit: { banshee.shift() }
        on: FlyBuzzed => "banshee stirs at {event.kind}"
        on: ArrowIncoming => "the banshee holds its ground"
        on: ArrowIncoming & { event.volume > 8 } => { banshee.count = banshee.count + 1 }
        on: SunRose => ! Nest()
        on: FlyBuzzed => "the banshee reacts"
        on: SeesPrey => "{event.kind} startles the banshee"
        on: Wounded & { event.fear <= 8 } => ! Swarm()
    until: WhipCracked

    state: Parry
        init: { banshee.pos = banshee.pos:step() }
        deinit: { banshee.state = "calm" }
        on: Rested => "the banshee reacts"
        on: Cornered => ! Graze()
        on: ClashResolved & { event.depth > 5 } => { banshee.state = "tense" }
        on: RainFell => ! Graze()
        on: PreyEscaped & { event.amount > 10 } => ! Swarm()
    until: Cornered

    state: Graze(target: number)
        init: { banshee.state = "ready" }
        on: RainFell & { event.amount >= 3 } => ! Parry()
        on: ArrowIncoming & { event.volume == 5 } => ! Alert()
        on: EnemyInRange => { banshee.state = "tense" }
        on: PreyEscaped & { event.speed < 2 } => { banshee.energy = banshee.energy - 1 }
        on: SunRose => { banshee.growl() }
    until: FlyBuzzed

    state: Lunge(target: number)
        on: ArrowIncoming => ! Nest()
        on: PreyEscaped => { banshee.stir() }
        on: PathBlocked & { event.range > 5 } => ! Alert()
        on: SeesPlayer & { event.range >= 2 } => ! Parry()
        on: PathBlocked & { event.speed < 10 } => ! Alert()
    until: SunRose

    state: Swarm
        on: Spooked & { event.range == 1 } => { banshee.count = banshee.count + 1 }
        on: CartLoaded & { event.count >= 3 } => ! Pounce()
        on: SugarOffered & { event.fear > 5 } => ! Graze()
        on: ReinsPulled => { banshee.pos = banshee.pos:step() }
        on: WhipCracked & { event.amount <= 2 } => { banshee.energy = banshee.energy - 1 }
        on: Rested & { event.weight > 4 } => ! Nest()
    until: PreyEscaped

    state: Alert
        init: { banshee.growl() }
        deinit: { banshee.pos = banshee.pos:step() }
        on: ArrowIncoming => ! Swarm()
        on: Splash => "banshee stirs at {event.kind}"
        on: SeesPlayer & { event.speed == 8 } => { banshee.pos = banshee.pos:step() }
        on: Wounded => ! Pounce()
        on: WhipCracked & { event.distance <= 10 } => ! Lunge()
        on: PathBlocked => { banshee.turn() }
        on: FlyBuzzed => "banshee stirs at {event.kind}"
    until: NoiseHeard
:end

state_machine: Shade(cunning: string)
    default: Shade.Nest
    init: { shade.spawn() }

    state: Nest
        on: SugarOffered => ! Circle()
        on: ScentCaught & { event.range >= 10 } => ! Hunt()
        on: Splash => ! Hunt()
        on: SugarOffered & { event.trust > 10 } => "shade stirs at {event.kind}"
    until: SeesPlayer

    state: Swarm(goal: number)
        on: SeesPlayer => { shade.energy = shade.energy - 1 }
        on: DuskFalls & { event.amount >= 5 } => "shade stirs at {event.kind}"
        on: DuskFalls => { shade.pos = shade.pos:step() }
        on: SugarOffered & { event.weight <= 1 } => ! Circle()
        on: SunRose => ! Circle()
        on: HarpPlucked & { event.fear < 5 } => { shade.count = shade.count + 1 }
    until: SugarOffered

    state: Idle
        init: { shade.state = "tense" }
        on: PathBlocked => ! Circle()
        on: SeesPrey & { event.distance <= 5 } => ! Nest()
        on: PathBlocked => { shade.count = shade.count + 1 }
        on: SunRose => { shade.shift() }
        on: PreyEscaped & { event.weight < 10 } => "the shade reacts"
        on: Cornered & { event.volume <= 4 } => "the shade holds its ground"
    until: Spooked

    state: Circle
        init: { shade.pos = shade.pos:step() }
        on: Rested & { event.range <= 8 } => ! Swarm()
        on: ScentCaught => "shade stirs at {event.kind}"
        on: BladeClash & { event.speed >= 1 } => { shade.count = shade.count + 1 }
        on: ScentCaught => ! Nest()
    until: ArrowIncoming

    state: Strike(foe: number)
        on: GiantShouts & { event.weight >= 5 } => "shade stirs at {event.kind}"
        on: DawnBreaks => ! Circle()
        on: WhipCracked => ! Idle()
        on: NoiseHeard => ! Nest()
        on: ReinsPulled => { shade.state = "ready" }
        on: Splash & { event.fear >= 4 } => ! Swarm()
    until: SeesPrey

    state: Retreat
        on: DuskFalls => ! Swarm()
        on: Splash & { event.weight == 4 } => { shade.state = "ready" }
        on: DuskFalls & { event.amount > 2 } => ! Hunt()
        on: SeesPrey => { shade.stir() }
    until: Splash

    state: Hunt(target: number)
        on: DuskFalls => { shade.growl() }
        on: ScentCaught & { event.fear <= 5 } => ! Circle()
        on: ArrowIncoming & { event.range <= 8 } => "{event.kind} startles the shade"
        on: RainFell => "{event.kind} startles the shade"
        on: RainFell & { event.weight >= 5 } => ! Strike()
        on: HarpPlucked => ! Nest()
        on: ScentCaught => ! Idle()
    until: Tick
:end

state_machine: Specter
    default: Specter.Alert

    state: Alert(foe: number)
        init: { specter.pos = specter.pos:step() }
        on: GiantShouts => { specter.pos = specter.pos:step() }
        on: Tick & { event.weight < 4 } => { specter.count = specter.count + 1 }
        on: GiantShouts & { event.fear > 10 } => { specter.energy = specter.energy - 1 }
        on: Wounded & { event.speed > 2 } => ! Sprint()
        on: ReinsPulled & { event.weight == 8 } => ! Graze()
        on: PreyEscaped => { specter.pos = specter.pos:step() }
        on: PathBlocked & { event.weight > 5 } => { specter.pos = specter.pos:step() }
    until: WhipCracked

    state: Charge
        on: FlyBuzzed => "specter stirs at {event.kind}"
        on: GiantShouts => ! Advance()
        on: SeesPlayer => ! Stalk()
        on: RainFell & { event.distance <= 2 } => ! Graze()
        on: PathBlocked & { event.range <= 8 } => { specter.state = "ready" }
        on: SugarOffered & { event.fear <= 4 } => "specter stirs at {event.kind}"
    until: Splash

    state: Graze
        deinit: { specter.pause() }
        on: NoiseHeard => { specter.state = "tense" }
        on: Splash & { event.volume > 3 } => { specter.turn() }
        on: SeesPlayer & { event.speed > 5 } => { specter.turn() }
        on: Tick & { event.fear <= 10 } => { specter.count = specter.count + 1 }
        on: BladeClash & { event.range <= 10 } => ! Balk()
    until: CartLoaded

    state: Balk(foe: number)
        on: ScentCaught & { event.speed <= 8 } => { specter.state = "alert" }
        on: Spooked & { event.volume <= 2 } => ! Sprint()
        on: PathBlocked => { specter.count = specter.count + 1 }
        on: Wounded => ! Stalk()
    until: Splash

    state: Stalk
        on: PreyEscaped & { event.weight <= 10 } => "the specter holds its ground"
        on: Rested & { event.weight > 3 } => { specter.state = "ready" }
        on: Tick => ! Charge()
        on: PreyEscaped => { specter.state = "tense" }
        on: Spooked & { event.range >= 2 } => "the specter holds its ground"
        on: CartLoaded & { event.count >= 10 } => "specter stirs at {event.kind}"
    until: EnemyInRange

    state: Advance
        init: { specter.energy = specter.energy - 1 }
        on: Splash & { event.volume == 10 } => ! Charge()
        on: DawnBreaks & { event.count >= 4 } => { specter.state = "calm" }
        on: Splash & { event.fear < 5 } => { specter.state = "ready" }
        on: PathBlocked & { event.depth > 4 } => { specter.state = "calm" }
        on: PreyEscaped => { specter.pos = specter.pos:step() }
        on: Cornered & { event.trust > 8 } => ! Charge()
    until: HarpPlucked

    state: Sprint
        deinit: { specter.energy = specter.energy - 1 }
        on: ClashResolved => ! Balk()
        on: ReinsPulled & { event.trust <= 2 } => ! Balk()
        on: ReinsPulled & { event.trust < 5 } => ! Stalk()
        on: PathBlocked & { event.range < 8 } => { specter.pos = specter.pos:step() }
    until: ScentCaught
:end

state_machine: Phantom
    default: Phantom.Idle
    init: { phantom.spawn() }

    state: Idle
        on: NoiseHeard & { event.volume == 10 } => ! Perch()
        on: Splash & { event.speed >= 4 } => { phantom.state = "calm" }
        on: Spooked => { phantom.count = phantom.count + 1 }
        on: NoiseHeard => ! Perch()
    until: PreyEscaped

    state: Dive(goal: string)
        init: { phantom.count = phantom.count + 1 }
        on: HarpPlucked => "the phantom holds its ground"
        on: Wounded => "the phantom holds its ground"
        on: ScentCaught => ! Sit()
        on: Splash => { phantom.pos = phantom.pos:step() }
        on: Splash => { phantom.count = phantom.count + 1 }
        on: PreyEscaped & { event.speed == 3 } => ! Idle()
    until: CartLoaded

    state: Sit
        on: EnemyInRange => ! Idle()
        on: ClashResolved & { event.amount < 8 } => ! Idle()
        on: ArrowIncoming => { phantom.energy = phantom.energy - 1 }
        on: Wounded => { phantom.state = "calm" }
    until: BladeClash

    state: Perch
        on: Spooked & { event.fear <= 1 } => ! Idle()
        on: ScentCaught & { event.weight <= 10 } => { phantom.energy = phantom.energy - 1 }
        on: SeesPlayer & { event.speed >= 2 } => "the phantom holds its ground"
        on: ArrowIncoming => "the phantom reacts"
        on: Rested => ! Sit()
        on: HarpPlucked & { event.fear >= 3 } => { phantom.pos = phantom.pos:step() }
    until: HarpPlucked

    state: Advance
        on: HarpPlucked & { event.count > 5 } => { phantom.pos = phantom.pos:step() }
        on: ReinsPulled => { phantom.energy = phantom.energy - 1 }
        on: Rested => ! Sit()
        on: Cornered => { phantom.pos = phantom.pos:step() }
        on: Wounded & { event.volume >= 1 } => { phantom.energy = phantom.energy - 1 }
    until: DawnBreaks
:end

state_machine: Apparition(reach: number)
    default: Apparition.Wait

    state: Wait(foe: number)
        on: Rested & { event.amount < 5 } => ! Hunt()
        on: Rested => "the apparition holds its ground"
        on: Wounded & { event.fear > 10 } => { apparition.pos = apparition.pos:step() }
        on: CartLoaded => { apparition.state = "ready" }
        on: ScentCaught & { event.trust > 10 } => ! Graze()
        on: DuskFalls & { event.fear < 3 } => { apparition.energy = apparition.energy - 1 }
    until: WhipCracked

    state: Advance
        on: SugarOffered & { event.count <= 8 } => { apparition.state = "ready" }
        on: SeesPlayer => "the apparition reacts"
        on: WhipCracked & { event.range < 10 } => ! Graze()
        on: BladeClash => ! Hunt()
        on: ScentCaught & { event.speed <= 1 } => ! Circle()
        on: PathBlocked & { event.fear <= 8 } => ! Climb()
    until: ScentCaught

    state: Hunt(foe: string)
        on: CartLoaded & { event.count <= 10 } => ! Circle()
        on: CartLoaded & { event.distance <= 4 } => ! Wait()
        on: BladeClash & { event.count >= 3 } => ! Graze()
        on: CartLoaded => "the apparition holds its ground"
    until: DawnBreaks

    state: Graze
        on: Rested => "the apparition reacts"
        on: ArrowIncoming & { event.fear == 1 } => ! Climb()
        on: DuskFalls => ! Glide()
        on: SeesPlayer => { apparition.stir() }
        on: HarpPlucked => "the apparition reacts"
        on: SunRose => "apparition stirs at {event.kind}"
        on: EnemyInRange => { apparition.count = apparition.count + 1 }
    until: Spooked

    state: Glide(foe: number)
        on: ReinsPulled => ! Climb()
        on: BladeClash & { event.amount > 2 } => ! Climb()
        on: WhipCracked & { event.count <= 3 } => ! Hunt()
        on: ScentCaught => { apparition.shift() }
        on: BladeClash => { apparition.count = apparition.count + 1 }
    until: FlyBuzzed

    state: Circle
        on: WhipCracked & { event.count < 8 } => { apparition.count = apparition.count + 1 }
        on: GiantShouts & { event.depth >= 3 } => "the apparition reacts"
        on: ScentCaught => { apparition.shift() }
        on: WhipCracked & { event.trust <= 2 } => "the apparition holds its ground"
        on: DawnBreaks => ! Wait()
        on: FlyBuzzed & { event.weight >= 5 } => ! Glide()
        on: Cornered => "the apparition reacts"
    until: BladeClash

    state: Climb
        init: { apparition.state = "ready" }
        on: SugarOffered => ! Hunt()
        on: HarpPlucked & { event.depth >= 5 } => "apparition stirs at {event.kind}"
        on: SunRose & { event.volume >= 10 } => ! Wait()
        on: SunRose & { event.fear < 5 } => ! Circle()
    until: ClashResolved
:end

state_machine: Spirit
    default: Spirit.Swarm

    state: Swarm
        deinit: { spirit.pos = spirit.pos:step() }
        on: NoiseHeard => ! Catch()
        on: DuskFalls & { event.count <= 2 } => { spirit.stir() }
        on: GiantShouts => ! Trot()
        on: ClashResolved => ! Trot()
        on: DuskFalls => ! Catch()
        on: FlyBuzzed & { event.weight < 2 } => { spirit.pause() }
        on: ClashResolved => ! Retreat()
    until: CartLoaded

    state: Catch
        init: { spirit.shift() }
        on: SugarOffered => "spirit stirs at {event.kind}"
        on: RainFell & { event.volume <= 8 } => { spirit.count = spirit.count + 1 }
        on: ScentCaught & { event.fear > 4 } => { spirit.count = spirit.count + 1 }
        on: PathBlocked => ! Swarm()
        on: WhipCracked & { event.volume <= 4 } => { spirit.growl() }
        on: DawnBreaks & { event.trust > 1 } => "spirit stirs at {event.kind}"
    until: HarpPlucked

    state: Retreat
        on: Rested => { spirit.count = spirit.count + 1 }
        on: SunRose & { event.speed <= 10 } => ! Trot()
        on: WhipCracked => "the spirit reacts"
        on: PreyEscaped & { event.fear > 10 } => { spirit.count = spirit.count + 1 }
        on: SeesPrey => ! Trot()
        on: CartLoaded & { event.fear < 8 } => ! Trot()
        on: Spooked & { event.speed <= 3 } => { spirit.energy = spirit.energy - 1 }
    until: Rested

    state: Chase(target: number)
        on: EnemyInRange & { event.weight == 2 } => "{event.kind} startles the spirit"
        on: WhipCracked & { event.depth > 3 } => { spirit.energy = spirit.energy - 1 }
        on: SunRose => ! Retreat()
        on: BladeClash => ! Strike()
        on: PathBlocked & { event.fear <= 10 } => ! Coil()
        on: PreyEscaped & { event.volume == 1 } => { spirit.energy = spirit.energy - 1 }
    until: WhipCracked

    state: Trot
        init: { spirit.state = "calm" }
        on: CartLoaded & { event.depth < 3 } => ! Retreat()
        on: Cornered => ! Retreat()
        on: PathBlocked & { event.trust > 10 } => "the spirit holds its ground"
        on: Spooked & { event.weight == 10 } => ! Catch()
        on: WhipCracked & { event.count < 2 } => "{event.kind} startles the spirit"
        on: NoiseHeard & { event.speed < 5 } => ! Coil()
        on: BladeClash & { event.trust <= 8 } => "{event.kind} startles the spirit"
    until: NoiseHeard

    state: Coil(foe: string)
        on: DawnBreaks & { event.amount > 10 } => { spirit.count = spirit.count + 1 }
        on: ClashResolved & { event.range <= 2 } => "the spirit reacts"
        on: Rested => ! Swarm()
        on: NoiseHeard & { event.range >= 10 } => { spirit.energy = spirit.energy - 1 }
    until: SeesPlayer

    state: Strike
        on: Rested => ! Chase()
        on: PathBlocked & { event.speed == 8 } => { spirit.count = spirit.count + 1 }
        on: GiantShouts & { event.volume >= 1 } => "spirit stirs at {event.kind}"
        on: Splash => ! Swarm()
        on: SugarOffered => ! Chase()
        on: NoiseHeard => "the spirit holds its ground"
    until: ReinsPulled
:end

state_machine: Haunt(strength: string)
    default: Haunt.Hop
    init: { haunt.spawn() }

    state: Hop
        on: EnemyInRange => { haunt.state = "ready" }
        on: Wounded => ! Parry()
        on: ScentCaught & { event.depth < 10 } => { haunt.count = haunt.count + 1 }
        on: SeesPrey => ! Coil()
        on: ReinsPulled => "haunt stirs at {event.kind}"
        on: Tick & { event.count > 3 } => ! Coil()
    until: ReinsPulled

    state: Circle
        on: SugarOffered & { event.depth > 3 } => ! Graze()
        on: GiantShouts => ! Parry()
        on: NoiseHeard => { haunt.state = "tense" }
        on: BladeClash & { event.trust >= 1 } => { haunt.state = "alert" }
    until: GiantShouts

    state: Haul
        on: CartLoaded => "the haunt holds its ground"
        on: PreyEscaped & { event.weight >= 3 } => "the haunt reacts"
        on: ClashResolved => ! Circle()
        on: ArrowIncoming & { event.range == 4 } => ! Hop()
    until: EnemyInRange

    state: Graze
        init: { haunt.turn() }
        on: HarpPlucked & { event.range <= 1 } => { haunt.turn() }
        on: BladeClash => { haunt.energy = haunt.energy - 1 }
        on: RainFell & { event.distance == 2 } => { haunt.shift() }
        on: NoiseHeard & { event.trust >= 8 } => ! Coil()
        on: NoiseHeard => { haunt.state = "tense" }
    until: SeesPlayer

    state: Parry
        init: { haunt.count = haunt.count + 1 }
        on: ArrowIncoming => "{event.kind} startles the haunt"
        on: Rested => { haunt.growl() }
        on: Cornered & { event.amount == 1 } => { haunt.energy = haunt.energy - 1 }
        on: BladeClash => ! Circle()
        on: DawnBreaks & { event.depth > 1 } => "the haunt holds its ground"
        on: GiantShouts => { haunt.stir() }
    until: Wounded

    state: Coil
        init: { haunt.stir() }
        deinit: { haunt.pos = haunt.pos:step() }
        on: Rested => { haunt.energy = haunt.energy - 1 }
        on: Spooked & { event.weight >= 10 } => { haunt.energy = haunt.energy - 1 }
        on: DawnBreaks & { event.speed >= 3 } => ! Circle()
        on: Cornered & { event.distance < 8 } => "the haunt holds its ground"
        on: WhipCracked => "the haunt reacts"
        on: SeesPrey & { event.amount <= 4 } => ! Graze()
        on: Rested & { event.fear <= 4 } => ! Hop()
    until: BladeClash
:end

## =========================================================================
## sprites_moving_beasts.rule -- 12 creatures
## =========================================================================

state_machine: Frog(cunning: number)
    default: Frog.Pounce

    state: Pounce
        on: SeesPrey & { event.range == 3 } => { frog.pos = frog.pos:step() }
        on: Splash => { frog.pos = frog.pos:step() }
        on: SunRose & { event.distance <= 4 } => { frog.energy = frog.energy - 1 }
        on: FlyBuzzed => ! Burrow()
        on: Spooked & { event.distance > 4 } => { frog.pos = frog.pos:step() }
        on: BladeClash => { frog.energy = frog.energy - 1 }
    until: SugarOffered

    state: Sit
        on: SugarOffered => "the frog reacts"
        on: CartLoaded => "frog stirs at {event.kind}"
        on: SeesPlayer => { frog.shift() }
        on: WhipCracked & { event.weight == 1 } => { frog.count = frog.count + 1 }
        on: SeesPrey => ! Scatter()
    until: GiantShouts

    state: Scatter
        init: { frog.energy = frog.energy - 1 }
        on: DawnBreaks => { frog.state = "calm" }
        on: Splash => { frog.pos = frog.pos:step() }
        on: ScentCaught => ! Burrow()
        on: WhipCracked & { event.count == 10 } => ! Sit()
        on: SeesPrey & { event.volume >= 8 } => ! Sit()
        on: FlyBuzzed & { event.depth < 8 } => { frog.pos = frog.pos:step() }
    until: ReinsPulled

    state: Burrow(goal: string)
        init: { frog.count = frog.count + 1 }
        on: Splash & { event.range < 4 } => ! Sit()
        on: GiantShouts & { event.speed == 5 } => { frog.state = "ready" }
        on: SeesPrey & { event.distance == 5 } => ! Scatter()
        on: CartLoaded => ! Pounce()
        on: Rested & { event.fear > 4 } => ! Sit()
    until: SugarOffered

    state: Guard
        on: EnemyInRange & { event.range < 10 } => { frog.count = frog.count + 1 }
        on: EnemyInRange => { frog.state = "calm" }
        on: ArrowIncoming & { event.amount < 4 } => { frog.turn() }
        on: DuskFalls => { frog.state = "tense" }
        on: CartLoaded => "frog stirs at {event.kind}"
        on: DuskFalls => { frog.count = frog.count + 1 }
    until: SeesPlayer

    state: Flee
        on: GiantShouts & { event.speed < 4 } => "the frog reacts"
        on: Tick => ! Guard()
        on: ArrowIncoming & { event.distance <= 3 } => { frog.energy = frog.energy - 1 }
        on: HarpPlucked => ! Burrow()
        on: SugarOffered => { frog.pos = frog.pos:step() }
    until: GiantShouts
:end

state_machine: Donkey(cunning: string)
    default: Donkey.Lunge
    init: { donkey.spawn() }

    state: Lunge
        on: ClashResolved => { donkey.count = donkey.count + 1 }
        on: ScentCaught & { event.weight == 2 } => ! Shamble()
        on: ArrowIncoming & { event.range > 10 } => ! Graze()
        on: ReinsPulled & { event.trust > 2 } => ! Guard()
        on: SugarOffered & { event.volume < 8 } => { donkey.stir() }
        on: SeesPlayer => { donkey.energy = donkey.energy - 1 }
        on: GiantShouts & { event.depth < 1 } => "{event.kind} startles the donkey"
    until: WhipCracked

    state: Guard(goal: string)
        init: { donkey.pause() }
        on: ReinsPulled & { event.amount == 10 } => ! Shamble()
        on: Spooked & { event.weight > 4 } => { donkey.energy = donkey.energy - 1 }
        on: ScentCaught => ! Wait()
        on: FlyBuzzed => { donkey.count = donkey.count + 1 }
        on: DuskFalls => ! Rest()
        on: SunRose => "the donkey reacts"
    until: PreyEscaped

    state: Shamble
        on: DuskFalls => "the donkey reacts"
        on: PreyEscaped & { event.count < 2 } => { donkey.pos = donkey.pos:step() }
        on: Splash & { event.fear <= 3 } => "the donkey holds its ground"
        on: SunRose & { event.volume <= 1 } => ! Guard()
        on: EnemyInRange => ! Guard()
        on: GiantShouts & { event.trust > 4 } => ! Guard()
    until: ReinsPulled

    state: Graze(goal: string)
        deinit: { donkey.energy = donkey.energy - 1 }
        on: ScentCaught & { event.speed == 10 } => "donkey stirs at {event.kind}"
        on: SugarOffered & { event.amount == 3 } => { donkey.count = donkey.count + 1 }
        on: EnemyInRange => ! Guard()
        on: ArrowIncoming & { event.speed > 3 } => ! Rest()
    until: Splash

    state: Trot
        deinit: { donkey.count = donkey.count + 1 }
        on: Tick => { donkey.pos = donkey.pos:step() }
        on: BladeClash & { event.volume <= 1 } => ! Wait()
        on: GiantShouts => ! Lunge()
        on: NoiseHeard & { event.amount <= 3 } => "the donkey reacts"
    until: EnemyInRange

    state: Rest
        deinit: { donkey.energy = donkey.energy - 1 }
        on: FlyBuzzed => { donkey.state = "calm" }
        on: Wounded => { donkey.energy = donkey.energy - 1 }
        on: FlyBuzzed => "donkey stirs at {event.kind}"
        on: Rested => "the donkey reacts"
        on: PathBlocked & { event.volume == 1 } => { donkey.pos = donkey.pos:step() }
        on: ReinsPulled & { event.volume > 2 } => { donkey.state = "calm" }
        on: Wounded & { event.count <= 2 } => ! Lunge()
    until: ArrowIncoming

    state: Wait(target: number)
        init: { donkey.state = "calm" }
        on: FlyBuzzed & { event.amount < 5 } => ! Guard()
        on: ReinsPulled => { donkey.count = donkey.count + 1 }
        on: DawnBreaks & { event.speed >= 2 } => ! Trot()
        on: DawnBreaks & { event.weight <= 5 } => { donkey.count = donkey.count + 1 }
        on: PreyEscaped => { donkey.count = donkey.count + 1 }
        on: HarpPlucked => { donkey.state = "ready" }
    until: NoiseHeard
:end

state_machine: Horse(reach: string)
    default: Horse.Forage
    init: { horse.spawn() }

    state: Forage(goal: number)
        init: { horse.energy = horse.energy - 1 }
        on: PreyEscaped & { event.trust <= 5 } => "the horse reacts"
        on: RainFell => "the horse holds its ground"
        on: DuskFalls => "{event.kind} startles the horse"
        on: Tick => "the horse reacts"
    until: EnemyInRange

    state: Sit(foe: string)
        init: { horse.count = horse.count + 1 }
        on: Spooked => ! Balk()
        on: Spooked => "horse stirs at {event.kind}"
        on: DuskFalls & { event.trust > 2 } => { horse.pos = horse.pos:step() }
        on: Rested & { event.trust >= 4 } => ! Forage()
        on: Tick & { event.range <= 5 } => "{event.kind} startles the horse"
        on: SeesPlayer => { horse.shift() }
    until: SugarOffered

    state: Climb
        on: ClashResolved & { event.fear <= 3 } => ! Glide()
        on: SeesPlayer => ! Parry()
        on: FlyBuzzed => "{event.kind} startles the horse"
        on: SunRose => { horse.energy = horse.energy - 1 }
        on: HarpPlucked & { event.volume < 5 } => { horse.state = "calm" }
        on: DuskFalls => { horse.count = horse.count + 1 }
        on: CartLoaded => "{event.kind} startles the horse"
    until: SeesPlayer

    state: Glide
        on: PreyEscaped & { event.speed > 5 } => { horse.state = "ready" }
        on: Wounded & { event.depth < 5 } => ! Forage()
        on: Tick & { event.count > 4 } => ! Forage()
        on: NoiseHeard => ! Climb()
        on: DawnBreaks & { event.range <= 8 } => "horse stirs at {event.kind}"
        on: Tick => { horse.state = "alert" }
    until: PathBlocked

    state: Parry(target: string)
        on: WhipCracked => { horse.count = horse.count + 1 }
        on: DuskFalls & { event.range >= 4 } => "{event.kind} startles the horse"
        on: Spooked & { event.amount <= 2 } => ! Balk()
        on: DuskFalls & { event.count >= 3 } => "horse stirs at {event.kind}"
        on: NoiseHeard & { event.speed >= 1 } => "the horse reacts"
    until: ArrowIncoming

    state: Lunge
        init: { horse.shift() }
        on: WhipCracked & { event.trust == 3 } => { horse.count = horse.count + 1 }
        on: DuskFalls & { event.range >= 3 } => "the horse holds its ground"
        on: EnemyInRange & { event.trust >= 3 } => { horse.pos = horse.pos:step() }
        on: DuskFalls => { horse.energy = horse.energy - 1 }
    until: Rested

    state: Balk(goal: number)
        init: { horse.energy = horse.energy - 1 }
        on: ClashResolved => { horse.state = "alert" }
        on: SeesPlayer & { event.amount > 8 } => { horse.count = horse.count + 1 }
        on: ClashResolved => "{event.kind} startles the horse"
        on: HarpPlucked => { horse.state = "calm" }
        on: EnemyInRange => "the horse reacts"
    until: ClashResolved
:end

state_machine: Hound(stamina: number)
    default: Hound.Graze
    init: { hound.spawn() }

    state: Graze
        init: { hound.pos = hound.pos:step() }
        on: SunRose & { event.trust == 5 } => { hound.pos = hound.pos:step() }
        on: RainFell => { hound.energy = hound.energy - 1 }
        on: NoiseHeard => { hound.state = "tense" }
        on: RainFell & { event.speed <= 3 } => ! Strike()
        on: RainFell & { event.range <= 8 } => "hound stirs at {event.kind}"
    until: Spooked

    state: Charge(goal: number)
        on: WhipCracked & { event.count < 4 } => ! Alert()
        on: Wounded & { event.distance > 10 } => "the hound holds its ground"
        on: RainFell => { hound.count = hound.count + 1 }
        on: DuskFalls & { event.range <= 8 } => { hound.turn() }
    until: ArrowIncoming

    state: Alert(foe: string)
        init: { hound.count = hound.count + 1 }
        on: RainFell => ! Graze()
        on: SugarOffered & { event.distance == 10 } => ! Strike()
        on: RainFell & { event.depth <= 4 } => "the hound reacts"
        on: Spooked & { event.speed <= 2 } => { hound.energy = hound.energy - 1 }
        on: Splash => { hound.state = "alert" }
        on: HarpPlucked & { event.count >= 5 } => "hound stirs at {event.kind}"
        on: BladeClash & { event.trust <= 3 } => ! Charge()
    until: WhipCracked

    state: Strike
        init: { hound.energy = hound.energy - 1 }
        on: CartLoaded & { event.fear <= 10 } => "{event.kind} startles the hound"
        on: PathBlocked & { event.fear == 4 } => { hound.count = hound.count + 1 }
        on: EnemyInRange & { event.volume == 5 } => ! Drift()
        on: PathBlocked => { hound.energy = hound.energy - 1 }
        on: Wounded => { hound.state = "calm" }
        on: SugarOffered => "{event.kind} startles the hound"
    until: Wounded

    state: Drift
        init: { hound.energy = hound.energy - 1 }
        on: DuskFalls & { event.weight <= 2 } => ! Alert()
        on: Wounded & { event.volume == 4 } => "the hound reacts"
        on: Splash & { event.trust == 10 } => { hound.pos = hound.pos:step() }
        on: CartLoaded & { event.depth <= 10 } => ! Strike()
    until: ClashResolved
:end

state_machine: Cat(cunning: number)
    default: Cat.Rear
    init: { cat.spawn() }

    state: Rear
        init: { cat.energy = cat.energy - 1 }
        on: SugarOffered & { event.count < 10 } => ! Coil()
        on: RainFell => ! Sprint()
        on: FlyBuzzed => ! Catch()
        on: WhipCracked => { cat.count = cat.count + 1 }
        on: DuskFalls & { event.weight <= 3 } => "{event.kind} startles the cat"
    until: ClashResolved

    state: Sprint(prey: number)
        deinit: { cat.state = "alert" }
        on: PreyEscaped => { cat.count = cat.count + 1 }
        on: NoiseHeard => ! Rear()
        on: Rested & { event.amount == 4 } => "the cat holds its ground"
        on: Rested & { event.volume > 10 } => { cat.count = cat.count + 1 }
        on: PathBlocked => { cat.energy = cat.energy - 1 }
    until: Tick

    state: Perch
        deinit: { cat.state = "calm" }
        on: BladeClash => ! Rear()
        on: SeesPlayer => ! Catch()
        on: WhipCracked => ! Sprint()
        on: DuskFalls & { event.distance < 10 } => ! Sprint()
    until: Spooked

    state: Coil
        on: Cornered & { event.trust < 3 } => ! Catch()
        on: SunRose & { event.volume > 4 } => ! Rear()
        on: Spooked & { event.distance > 10 } => ! Catch()
        on: WhipCracked & { event.weight < 3 } => "cat stirs at {event.kind}"
        on: BladeClash & { event.speed <= 8 } => { cat.energy = cat.energy - 1 }
    until: NoiseHeard

    state: Catch
        on: PathBlocked & { event.speed < 5 } => ! Perch()
        on: Spooked & { event.fear < 4 } => ! Perch()
        on: DawnBreaks & { event.distance > 1 } => { cat.pos = cat.pos:step() }
        on: Spooked => "the cat reacts"
        on: ScentCaught & { event.volume < 10 } => { cat.state = "tense" }
        on: ArrowIncoming => { cat.count = cat.count + 1 }
        on: ReinsPulled & { event.weight < 4 } => { cat.pos = cat.pos:step() }
    until: Spooked
:end

state_machine: Hare(strength: number)
    default: Hare.Patrol
    init: { hare.spawn() }

    state: Patrol
        on: NoiseHeard => { hare.shift() }
        on: Tick => ! Stalk()
        on: CartLoaded & { event.speed == 3 } => ! Strike()
        on: WhipCracked => { hare.count = hare.count + 1 }
        on: GiantShouts => { hare.energy = hare.energy - 1 }
        on: EnemyInRange => ! Strike()
        on: Wounded => { hare.state = "tense" }
    until: SunRose

    state: Idle
        on: Cornered => { hare.count = hare.count + 1 }
        on: CartLoaded & { event.amount <= 4 } => { hare.energy = hare.energy - 1 }
        on: SeesPrey & { event.range <= 10 } => { hare.count = hare.count + 1 }
        on: Wounded => ! Coil()
        on: PathBlocked => ! Strike()
        on: PreyEscaped => ! Coil()
    until: GiantShouts

    state: Coil
        on: BladeClash => "hare stirs at {event.kind}"
        on: GiantShouts & { event.count < 4 } => { hare.pos = hare.pos:step() }
        on: FlyBuzzed => "{event.kind} startles the hare"
        on: NoiseHeard => { hare.stir() }
        on: NoiseHeard & { event.depth == 5 } => ! Strike()
        on: DuskFalls => { hare.energy = hare.energy - 1 }
    until: PreyEscaped

    state: Stalk(goal: string)
        on: NoiseHeard => ! Patrol()
        on: Splash => { hare.state = "tense" }
        on: Cornered & { event.weight < 10 } => ! Strike()
        on: Rested => { hare.state = "ready" }
        on: PreyEscaped => { hare.pos = hare.pos:step() }
        on: Tick & { event.amount > 1 } => { hare.energy = hare.energy - 1 }
    until: EnemyInRange

    state: Strike(foe: string)
        init: { hare.count = hare.count + 1 }
        deinit: { hare.energy = hare.energy - 1 }
        on: Spooked & { event.distance <= 8 } => ! Stalk()
        on: ReinsPulled => { hare.state = "ready" }
        on: ScentCaught & { event.distance == 3 } => { hare.state = "tense" }
        on: Rested => { hare.pos = hare.pos:step() }
    until: ReinsPulled

    state: Climb
        on: ClashResolved & { event.weight >= 2 } => ! Strike()
        on: Tick & { event.weight >= 4 } => ! Coil()
        on: Spooked & { event.amount < 2 } => ! Idle()
        on: SeesPrey => "the hare reacts"
    until: Wounded
:end

state_machine: Stag(reach: number)
    default: Stag.Hunt

    state: Hunt
        on: Splash & { event.range == 5 } => "the stag holds its ground"
        on: CartLoaded => ! Charge()
        on: SeesPlayer & { event.speed <= 2 } => ! Alert()
        on: SeesPrey & { event.depth <= 8 } => "{event.kind} startles the stag"
    until: ReinsPulled

    state: Retreat
        on: DawnBreaks => "stag stirs at {event.kind}"
        on: Rested => { stag.count = stag.count + 1 }
        on: Splash => { stag.turn() }
        on: SunRose & { event.count < 8 } => { stag.stir() }
        on: Tick => ! Hunt()
        on: CartLoaded => "the stag reacts"
        on: SeesPlayer & { event.trust < 10 } => ! Charge()
    until: ScentCaught

    state: Gallop
        deinit: { stag.wake() }
        on: RainFell & { event.range < 10 } => { stag.growl() }
        on: PreyEscaped => "the stag holds its ground"
        on: Splash & { event.depth >= 1 } => ! Hunt()
        on: Wounded & { event.depth < 8 } => ! Alert()
        on: Spooked => { stag.energy = stag.energy - 1 }
        on: Tick => ! Retreat()
    until: SunRose

    state: Alert(goal: number)
        on: Splash => ! Charge()
        on: Splash => { stag.wake() }
        on: SugarOffered & { event.trust >= 3 } => { stag.energy = stag.energy - 1 }
        on: ReinsPulled & { event.count >= 5 } => ! Gallop()
    until: RainFell

    state: Charge
        deinit: { stag.pos = stag.pos:step() }
        on: ScentCaught & { event.volume <= 5 } => ! Hunt()
        on: Spooked & { event.fear >= 5 } => ! Hunt()
        on: BladeClash & { event.fear == 2 } => { stag.energy = stag.energy - 1 }
        on: GiantShouts & { event.range < 3 } => { stag.pos = stag.pos:step() }
        on: PreyEscaped & { event.trust >= 8 } => { stag.count = stag.count + 1 }
        on: DawnBreaks & { event.fear > 5 } => { stag.energy = stag.energy - 1 }
        on: SunRose & { event.fear <= 4 } => { stag.energy = stag.energy - 1 }
    until: BladeClash
:end

state_machine: Boar
    default: Boar.Nest
    init: { boar.spawn() }

    state: Nest
        on: WhipCracked & { event.distance >= 2 } => "boar stirs at {event.kind}"
        on: GiantShouts & { event.trust == 4 } => "the boar holds its ground"
        on: FlyBuzzed => ! Hunt()
        on: RainFell => ! Dive()
    until: SugarOffered

    state: Hunt(target: string)
        on: SunRose & { event.weight <= 8 } => ! Dive()
        on: EnemyInRange & { event.trust >= 3 } => ! Nest()
        on: Splash => { boar.state = "alert" }
        on: ArrowIncoming & { event.depth < 3 } => { boar.turn() }
        on: Splash => ! Haul()
        on: ArrowIncoming & { event.count == 4 } => { boar.growl() }
        on: WhipCracked => ! Dive()
    until: SunRose

    state: Patrol
        init: { boar.pos = boar.pos:step() }
        on: ClashResolved => { boar.pause() }
        on: Cornered & { event.depth < 5 } => "boar stirs at {event.kind}"
        on: Splash & { event.speed == 1 } => { boar.turn() }
        on: Spooked => { boar.pause() }
    until: RainFell

    state: Haul
        deinit: { boar.pos = boar.pos:step() }
        on: BladeClash & { event.distance > 10 } => { boar.growl() }
        on: Wounded & { event.speed > 10 } => "boar stirs at {event.kind}"
        on: SeesPlayer & { event.count > 8 } => ! Hunt()
        on: DuskFalls & { event.amount == 5 } => { boar.state = "ready" }
        on: WhipCracked => ! Hunt()
        on: WhipCracked => ! Hunt()
    until: Spooked

    state: Dive(target: number)
        on: Wounded => ! Haul()
        on: Cornered => { boar.state = "ready" }
        on: FlyBuzzed & { event.distance > 5 } => ! Patrol()
        on: EnemyInRange => "the boar holds its ground"
        on: SeesPlayer & { event.count > 10 } => { boar.state = "calm" }
    until: WhipCracked

    state: Glide
        on: SunRose => ! Dive()
        on: HarpPlucked & { event.fear >= 1 } => { boar.state = "tense" }
        on: Cornered & { event.weight >= 3 } => ! Patrol()
        on: HarpPlucked => ! Nest()
    until: HarpPlucked
:end

state_machine: Falcon(speed: string)
    default: Falcon.Scatter
    init: { falcon.spawn() }

    state: Scatter
        init: { falcon.shift() }
        on: RainFell => { falcon.stir() }
        on: SugarOffered => ! Surface()
        on: Rested & { event.weight < 10 } => { falcon.energy = falcon.energy - 1 }
        on: HarpPlucked => { falcon.count = falcon.count + 1 }
        on: PreyEscaped => { falcon.count = falcon.count + 1 }
    until: ArrowIncoming

    state: Lunge
        init: { falcon.count = falcon.count + 1 }
        on: NoiseHeard & { event.weight == 10 } => { falcon.count = falcon.count + 1 }
        on: ScentCaught & { event.speed >= 1 } => ! Surface()
        on: GiantShouts & { event.volume == 4 } => ! Balk()
        on: SugarOffered & { event.speed >= 10 } => { falcon.pos = falcon.pos:step() }
        on: CartLoaded => ! Forage()
        on: ArrowIncoming => ! Balk()
    until: Rested

    state: Surface
        init: { falcon.count = falcon.count + 1 }
        on: ReinsPulled & { event.trust > 8 } => { falcon.shift() }
        on: ScentCaught => ! Forage()
        on: FlyBuzzed & { event.amount > 5 } => ! Coil()
        on: SunRose => { falcon.count = falcon.count + 1 }
        on: Spooked => ! Scatter()
        on: Splash => { falcon.wake() }
    until: SunRose

    state: Balk
        on: DawnBreaks & { event.speed == 8 } => ! Coil()
        on: CartLoaded => { falcon.count = falcon.count + 1 }
        on: Tick => "the falcon holds its ground"
        on: NoiseHeard => { falcon.count = falcon.count + 1 }
        on: Rested & { event.amount <= 1 } => ! Coil()
        on: Splash => { falcon.pause() }
        on: HarpPlucked & { event.depth == 5 } => ! Scatter()
    until: ScentCaught

    state: Patrol
        deinit: { falcon.state = "tense" }
        on: NoiseHeard => ! Surface()
        on: Rested & { event.distance == 4 } => "the falcon reacts"
        on: WhipCracked => ! Lunge()
        on: SeesPrey & { event.distance < 10 } => { falcon.count = falcon.count + 1 }
        on: ClashResolved & { event.speed > 5 } => ! Forage()
        on: DawnBreaks & { event.amount == 10 } => { falcon.pos = falcon.pos:step() }
    until: Wounded

    state: Coil
        on: PreyEscaped & { event.fear < 2 } => { falcon.pos = falcon.pos:step() }
        on: RainFell => { falcon.count = falcon.count + 1 }
        on: Spooked => ! Surface()
        on: CartLoaded => { falcon.growl() }
        on: SunRose & { event.weight <= 10 } => ! Surface()
    until: SunRose

    state: Forage(goal: string)
        on: EnemyInRange & { event.weight < 5 } => ! Coil()
        on: ScentCaught => ! Coil()
        on: SugarOffered => { falcon.energy = falcon.energy - 1 }
        on: NoiseHeard => { falcon.energy = falcon.energy - 1 }
    until: SugarOffered
:end

state_machine: Wolf(speed: number)
    default: Wolf.Stalk
    init: { wolf.spawn() }

    state: Stalk
        deinit: { wolf.pos = wolf.pos:step() }
        on: SugarOffered & { event.amount < 1 } => ! Patrol()
        on: DuskFalls & { event.trust > 5 } => ! Patrol()
        on: DuskFalls & { event.volume <= 1 } => { wolf.energy = wolf.energy - 1 }
        on: DuskFalls => { wolf.stir() }
    until: PathBlocked

    state: Guard
        on: Cornered & { event.amount >= 1 } => "the wolf holds its ground"
        on: RainFell => { wolf.state = "calm" }
        on: SunRose & { event.depth >= 5 } => { wolf.pos = wolf.pos:step() }
        on: PathBlocked => ! Stalk()
        on: ArrowIncoming & { event.depth == 8 } => { wolf.stir() }
    until: Splash

    state: Patrol(foe: number)
        deinit: { wolf.shift() }
        on: CartLoaded => ! Retreat()
        on: DawnBreaks => ! Guard()
        on: ArrowIncoming & { event.count == 3 } => "wolf stirs at {event.kind}"
        on: NoiseHeard => ! Stalk()
        on: FlyBuzzed => { wolf.pos = wolf.pos:step() }
        on: FlyBuzzed & { event.distance == 2 } => ! Guard()
    until: HarpPlucked

    state: Retreat(target: number)
        on: Cornered & { event.range < 4 } => ! Stalk()
        on: ScentCaught => { wolf.pos = wolf.pos:step() }
        on: PreyEscaped & { event.range <= 3 } => ! Guard()
        on: Spooked => ! Guard()
        on: FlyBuzzed & { event.depth <= 2 } => { wolf.energy = wolf.energy - 1 }
        on: Tick & { event.distance > 1 } => ! Guard()
        on: Tick => { wolf.state = "tense" }
    until: Tick

    state: Trot(goal: string)
        init: { wolf.pos = wolf.pos:step() }
        on: ReinsPulled => { wolf.energy = wolf.energy - 1 }
        on: ClashResolved => ! Patrol()
        on: Tick & { event.fear >= 1 } => ! Patrol()
        on: SeesPlayer => ! Retreat()
        on: CartLoaded & { event.speed == 1 } => ! Guard()
        on: DawnBreaks & { event.distance == 5 } => ! Retreat()
    until: ArrowIncoming
:end

state_machine: Bear
    default: Bear.Forage
    init: { bear.spawn() }

    state: Forage
        init: { bear.state = "calm" }
        on: HarpPlucked => { bear.state = "calm" }
        on: Tick & { event.speed <= 3 } => { bear.count = bear.count + 1 }
        on: EnemyInRange => "bear stirs at {event.kind}"
        on: PreyEscaped & { event.range == 5 } => { bear.pos = bear.pos:step() }
    until: PathBlocked

    state: Drift
        init: { bear.shift() }
        on: Cornered & { event.depth <= 1 } => ! Patrol()
        on: ScentCaught & { event.distance <= 4 } => ! Patrol()
        on: Rested & { event.depth < 5 } => { bear.state = "calm" }
        on: Cornered => { bear.state = "ready" }
    until: Tick

    state: Rear(foe: string)
        on: FlyBuzzed => ! Swarm()
        on: Spooked & { event.range == 1 } => { bear.state = "tense" }
        on: WhipCracked & { event.speed >= 5 } => { bear.state = "calm" }
        on: Wounded & { event.fear == 10 } => ! Strike()
        on: ClashResolved & { event.distance == 1 } => "bear stirs at {event.kind}"
        on: DuskFalls & { event.volume <= 5 } => { bear.state = "tense" }
        on: SeesPlayer => { bear.energy = bear.energy - 1 }
    until: Cornered

    state: Strike(goal: string)
        init: { bear.pos = bear.pos:step() }
        deinit: { bear.state = "alert" }
        on: RainFell & { event.weight > 3 } => ! Haul()
        on: FlyBuzzed & { event.volume == 5 } => ! Patrol()
        on: EnemyInRange => ! Rear()
        on: ScentCaught => { bear.state = "calm" }
        on: SugarOffered => ! Forage()
    until: ClashResolved

    state: Swarm
        on: WhipCracked => ! Rear()
        on: ClashResolved & { event.trust <= 8 } => { bear.energy = bear.energy - 1 }
        on: CartLoaded & { event.volume >= 2 } => ! Haul()
        on: GiantShouts & { event.depth <= 3 } => "bear stirs at {event.kind}"
    until: Spooked

    state: Haul
        init: { bear.count = bear.count + 1 }
        on: NoiseHeard & { event.distance == 8 } => ! Rear()
        on: Splash => { bear.count = bear.count + 1 }
        on: PathBlocked & { event.fear <= 1 } => ! Forage()
        on: FlyBuzzed & { event.volume == 2 } => { bear.pos = bear.pos:step() }
        on: Splash => { bear.wake() }
        on: EnemyInRange => { bear.energy = bear.energy - 1 }
    until: ScentCaught

    state: Patrol(goal: string)
        init: { bear.wake() }
        on: SugarOffered & { event.trust >= 1 } => { bear.energy = bear.energy - 1 }
        on: SeesPlayer => { bear.shift() }
        on: Wounded & { event.distance > 2 } => { bear.state = "tense" }
        on: Spooked & { event.depth >= 8 } => ! Rear()
        on: Splash => ! Strike()
        on: GiantShouts => ! Haul()
    until: ClashResolved
:end

state_machine: Otter(rate: number)
    default: Otter.Graze

    state: Graze
        deinit: { otter.count = otter.count + 1 }
        on: Splash & { event.range <= 4 } => "otter stirs at {event.kind}"
        on: Tick & { event.count < 3 } => ! Guard()
        on: DawnBreaks & { event.range == 8 } => { otter.energy = otter.energy - 1 }
        on: SeesPrey & { event.range > 5 } => { otter.energy = otter.energy - 1 }
        on: RainFell & { event.volume >= 4 } => ! Idle()
        on: BladeClash => ! Strike()
    until: HarpPlucked

    state: Shamble
        on: Wounded => ! Catch()
        on: ReinsPulled & { event.trust <= 4 } => ! Graze()
        on: Spooked => ! Catch()
        on: BladeClash => { otter.energy = otter.energy - 1 }
        on: FlyBuzzed & { event.amount >= 8 } => { otter.energy = otter.energy - 1 }
    until: EnemyInRange

    state: Advance(target: string)
        on: DawnBreaks => ! Guard()
        on: EnemyInRange & { event.volume == 4 } => { otter.count = otter.count + 1 }
        on: ReinsPulled & { event.weight >= 4 } => "the otter holds its ground"
        on: SeesPlayer => { otter.count = otter.count + 1 }
        on: NoiseHeard => "the otter holds its ground"
        on: BladeClash => ! Guard()
    until: Splash

    state: Guard
        on: WhipCracked => ! Strike()
        on: Splash => "the otter reacts"
        on: Cornered & { event.speed <= 8 } => { otter.energy = otter.energy - 1 }
        on: BladeClash => { otter.count = otter.count + 1 }
        on: HarpPlucked & { event.distance == 5 } => ! Catch()
        on: Spooked => "the otter reacts"
    until: PreyEscaped

    state: Strike(foe: number)
        on: ArrowIncoming & { event.distance < 10 } => { otter.pos = otter.pos:step() }
        on: RainFell => ! Shamble()
        on: Wounded => ! Graze()
        on: PathBlocked => { otter.stir() }
        on: SugarOffered & { event.distance >= 3 } => { otter.energy = otter.energy - 1 }
    until: EnemyInRange

    state: Idle
        init: { otter.energy = otter.energy - 1 }
        on: ReinsPulled & { event.volume == 8 } => { otter.pos = otter.pos:step() }
        on: Cornered => { otter.energy = otter.energy - 1 }
        on: DuskFalls => "the otter holds its ground"
        on: DuskFalls & { event.fear >= 8 } => "otter stirs at {event.kind}"
    until: DuskFalls

    state: Catch
        init: { otter.energy = otter.energy - 1 }
        deinit: { otter.energy = otter.energy - 1 }
        on: RainFell & { event.distance < 3 } => "otter stirs at {event.kind}"
        on: DuskFalls => ! Strike()
        on: NoiseHeard & { event.speed >= 4 } => "otter stirs at {event.kind}"
        on: DuskFalls & { event.speed == 3 } => { otter.energy = otter.energy - 1 }
    until: SunRose
:end

## =========================================================================
## sprites_insects.rule -- 10 creatures
## =========================================================================

state_machine: Ant
    default: Ant.Chase

    state: Chase(foe: string)
        on: RainFell & { event.count > 3 } => { ant.pos = ant.pos:step() }
        on: DuskFalls & { event.fear == 3 } => ! Rear()
        on: HarpPlucked => ! Advance()
        on: PreyEscaped => { ant.pos = ant.pos:step() }
        on: SeesPrey => ! Advance()
    until: BladeClash

    state: Climb
        on: Wounded => { ant.count = ant.count + 1 }
        on: HarpPlucked & { event.speed <= 8 } => ! Rear()
        on: FlyBuzzed & { event.volume == 1 } => "ant stirs at {event.kind}"
        on: ClashResolved => "the ant reacts"
        on: Wounded & { event.depth == 5 } => { ant.energy = ant.energy - 1 }
        on: FlyBuzzed => ! Rear()
    until: Rested

    state: Graze(target: string)
        init: { ant.energy = ant.energy - 1 }
        on: SugarOffered => { ant.state = "calm" }
        on: ReinsPulled => { ant.energy = ant.energy - 1 }
        on: SeesPlayer & { event.trust > 3 } => ! Advance()
        on: NoiseHeard & { event.trust > 5 } => ! Climb()
        on: DawnBreaks & { event.weight == 5 } => "ant stirs at {event.kind}"
        on: Tick => ! Rear()
        on: Splash & { event.distance < 8 } => "the ant reacts"
    until: WhipCracked

    state: Advance(target: number)
        deinit: { ant.energy = ant.energy - 1 }
        on: SugarOffered & { event.fear > 10 } => { ant.state = "calm" }
        on: ReinsPulled => { ant.stir() }
        on: CartLoaded => ! Climb()
        on: ScentCaught => { ant.stir() }
    until: FlyBuzzed

    state: Rear
        init: { ant.count = ant.count + 1 }
        on: ArrowIncoming & { event.depth == 2 } => ! Advance()
        on: ReinsPulled => ! Climb()
        on: Tick & { event.speed <= 5 } => { ant.count = ant.count + 1 }
        on: GiantShouts => { ant.count = ant.count + 1 }
    until: HarpPlucked
:end

state_machine: Bee
    default: Bee.Circle
    init: { bee.spawn() }

    state: Circle
        init: { bee.stir() }
        on: BladeClash => ! Charge()
        on: Cornered & { event.depth <= 2 } => { bee.wake() }
        on: Cornered & { event.distance <= 8 } => { bee.count = bee.count + 1 }
        on: SunRose => { bee.pos = bee.pos:step() }
        on: NoiseHeard => "the bee reacts"
    until: ReinsPulled

    state: Crouch
        init: { bee.energy = bee.energy - 1 }
        deinit: { bee.state = "ready" }
        on: SeesPlayer & { event.weight == 8 } => { bee.turn() }
        on: PreyEscaped => ! Charge()
        on: SunRose & { event.count == 2 } => "{event.kind} startles the bee"
        on: PathBlocked & { event.fear >= 2 } => ! Guard()
        on: SugarOffered => "{event.kind} startles the bee"
    until: Splash

    state: Sprint(target: string)
        on: BladeClash & { event.distance == 2 } => { bee.pause() }
        on: GiantShouts & { event.distance <= 4 } => { bee.state = "alert" }
        on: PathBlocked => { bee.energy = bee.energy - 1 }
        on: PathBlocked => { bee.pause() }
        on: ArrowIncoming & { event.range == 5 } => { bee.pos = bee.pos:step() }
        on: FlyBuzzed & { event.distance < 3 } => "{event.kind} startles the bee"
        on: NoiseHeard => "bee stirs at {event.kind}"
    until: ScentCaught

    state: Scatter
        init: { bee.state = "tense" }
        on: FlyBuzzed => "the bee holds its ground"
        on: Splash => { bee.count = bee.count + 1 }
        on: ScentCaught & { event.trust == 3 } => ! Guard()
        on: NoiseHeard => { bee.count = bee.count + 1 }
        on: Spooked => { bee.shift() }
        on: WhipCracked & { event.range < 10 } => ! Circle()
        on: Tick => { bee.count = bee.count + 1 }
    until: ScentCaught

    state: Guard(target: string)
        init: { bee.energy = bee.energy - 1 }
        on: EnemyInRange => ! Crouch()
        on: GiantShouts => ! Crouch()
        on: ClashResolved => { bee.state = "tense" }
        on: ScentCaught => { bee.state = "ready" }
    until: Cornered

    state: Burrow(foe: string)
        on: SeesPrey => ! Circle()
        on: Spooked & { event.volume < 1 } => ! Scatter()
        on: SeesPlayer => ! Guard()
        on: GiantShouts => { bee.energy = bee.energy - 1 }
        on: SugarOffered & { event.weight >= 2 } => { bee.state = "alert" }
    until: WhipCracked

    state: Charge(target: number)
        on: NoiseHeard & { event.trust >= 5 } => { bee.state = "tense" }
        on: ArrowIncoming & { event.range == 1 } => { bee.energy = bee.energy - 1 }
        on: GiantShouts & { event.volume < 10 } => ! Crouch()
        on: RainFell => ! Crouch()
        on: DawnBreaks & { event.volume >= 10 } => "the bee holds its ground"
    until: HarpPlucked
:end

state_machine: Beetle
    default: Beetle.Pounce
    init: { beetle.spawn() }

    state: Pounce(goal: string)
        on: Wounded & { event.depth <= 8 } => "the beetle reacts"
        on: Wounded => ! Sprint()
        on: SugarOffered & { event.distance <= 10 } => ! Sprint()
        on: Wounded & { event.volume >= 3 } => "the beetle reacts"
        on: ReinsPulled => ! Drift()
        on: SeesPrey => { beetle.growl() }
        on: DuskFalls => ! Drift()
    until: Spooked

    state: Sprint
        on: ScentCaught & { event.volume <= 10 } => "the beetle holds its ground"
        on: EnemyInRange & { event.weight == 3 } => ! Patrol()
        on: Wounded => ! Patrol()
        on: PathBlocked => ! Climb()
        on: DuskFalls => ! Climb()
    until: Wounded

    state: Patrol
        init: { beetle.state = "tense" }
        on: SunRose & { event.fear > 8 } => ! Pounce()
        on: ScentCaught => ! Climb()
        on: DawnBreaks => ! Drift()
        on: Splash => ! Climb()
        on: NoiseHeard & { event.range <= 3 } => ! Sprint()
    until: Spooked

    state: Drift
        on: DuskFalls => ! Perch()
        on: RainFell & { event.distance >= 1 } => { beetle.energy = beetle.energy - 1 }
        on: WhipCracked => ! Climb()
        on: SunRose => ! Pounce()
    until: ScentCaught

    state: Perch(target: number)
        init: { beetle.count = beetle.count + 1 }
        on: NoiseHeard & { event.weight <= 3 } => ! Climb()
        on: SeesPrey => { beetle.shift() }
        on: ReinsPulled & { event.count < 4 } => "{event.kind} startles the beetle"
        on: ReinsPulled & { event.trust <= 3 } => { beetle.stir() }
        on: Spooked & { event.weight <= 2 } => ! Pounce()
        on: RainFell & { event.volume >= 5 } => ! Drift()
        on: Wounded & { event.speed < 3 } => ! Sprint()
    until: ArrowIncoming

    state: Climb(foe: number)
        on: DuskFalls => ! Drift()
        on: BladeClash & { event.count <= 1 } => ! Drift()
        on: ReinsPulled & { event.amount >= 5 } => ! Patrol()
        on: PreyEscaped & { event.trust > 8 } => { beetle.pos = beetle.pos:step() }
        on: PreyEscaped & { event.count < 8 } => { beetle.turn() }
        on: ScentCaught & { event.volume >= 4 } => "the beetle reacts"
        on: Tick => ! Perch()
    until: ClashResolved
:end

state_machine: Moth(cunning: number)
    default: Moth.Catch
    init: { moth.spawn() }

    state: Catch
        on: CartLoaded & { event.count == 1 } => "the moth holds its ground"
        on: SugarOffered => ! Hop()
        on: Cornered & { event.depth < 1 } => { moth.count = moth.count + 1 }
        on: RainFell & { event.volume >= 5 } => ! Circle()
        on: FlyBuzzed => ! Surface()
        on: CartLoaded => ! Surface()
        on: WhipCracked & { event.speed == 8 } => { moth.count = moth.count + 1 }
    until: NoiseHeard

    state: Retreat
        on: CartLoaded & { event.count < 5 } => ! Hop()
        on: SeesPrey => "the moth reacts"
        on: Tick => { moth.pos = moth.pos:step() }
        on: SeesPrey & { event.volume < 1 } => { moth.energy = moth.energy - 1 }
    until: SunRose

    state: Circle
        init: { moth.state = "tense" }
        on: SeesPlayer => ! Hop()
        on: ReinsPulled => ! Surface()
        on: Wounded => ! Patrol()
        on: CartLoaded & { event.range < 3 } => { moth.count = moth.count + 1 }
    until: NoiseHeard

    state: Surface(goal: string)
        init: { moth.stir() }
        on: EnemyInRange & { event.speed >= 8 } => ! Patrol()
        on: NoiseHeard & { event.amount == 4 } => "the moth holds its ground"
        on: FlyBuzzed & { event.volume <= 4 } => { moth.state = "calm" }
        on: Rested => ! Catch()
        on: EnemyInRange & { event.count < 5 } => { moth.pos = moth.pos:step() }
    until: NoiseHeard

    state: Hop(prey: number)
        on: CartLoaded & { event.distance <= 3 } => ! Surface()
        on: ReinsPulled => { moth.state = "alert" }
        on: Spooked & { event.speed > 3 } => ! Circle()
        on: SeesPlayer => ! Retreat()
        on: SugarOffered => "{event.kind} startles the moth"
        on: NoiseHeard & { event.weight >= 8 } => "moth stirs at {event.kind}"
        on: Spooked => "{event.kind} startles the moth"
    until: GiantShouts

    state: Patrol(goal: number)
        deinit: { moth.stir() }
        on: Splash => ! Surface()
        on: ReinsPulled & { event.weight > 10 } => { moth.shift() }
        on: ScentCaught & { event.weight >= 8 } => { moth.pause() }
        on: ScentCaught => "moth stirs at {event.kind}"
        on: Spooked & { event.amount < 1 } => { moth.count = moth.count + 1 }
    until: SugarOffered
:end

state_machine: Spider(stamina: string)
    default: Spider.Balk

    state: Balk
        init: { spider.pos = spider.pos:step() }
        on: SeesPrey & { event.depth < 3 } => ! Forage()
        on: SugarOffered & { event.range > 8 } => ! Coil()
        on: GiantShouts & { event.fear == 10 } => { spider.state = "calm" }
        on: GiantShouts => ! Pounce()
        on: ClashResolved & { event.trust <= 5 } => ! Sit()
        on: NoiseHeard & { event.depth == 8 } => ! Sit()
        on: BladeClash & { event.count < 2 } => ! Sit()
    until: PreyEscaped

    state: Coil
        init: { spider.count = spider.count + 1 }
        on: EnemyInRange & { event.weight == 4 } => ! Sit()
        on: EnemyInRange => "the spider reacts"
        on: HarpPlucked & { event.range == 4 } => { spider.state = "alert" }
        on: SeesPlayer => "the spider reacts"
        on: CartLoaded & { event.speed == 10 } => ! Sit()
        on: DawnBreaks & { event.range > 5 } => "the spider holds its ground"
        on: PathBlocked => "spider stirs at {event.kind}"
    until: PathBlocked

    state: Forage
        init: { spider.stir() }
        on: ReinsPulled => { spider.count = spider.count + 1 }
        on: SunRose => ! Sit()
        on: WhipCracked & { event.weight >= 10 } => ! Pounce()
        on: RainFell => ! Pounce()
        on: SeesPrey => ! Pounce()
        on: PreyEscaped & { event.weight == 10 } => { spider.count = spider.count + 1 }
    until: Cornered

    state: Pounce
        deinit: { spider.count = spider.count + 1 }
        on: SunRose => ! Forage()
        on: CartLoaded & { event.speed >= 3 } => { spider.shift() }
        on: Splash & { event.range < 2 } => ! Forage()
        on: ReinsPulled => { spider.state = "ready" }
        on: BladeClash => "spider stirs at {event.kind}"
    until: SugarOffered

    state: Sit
        init: { spider.pause() }
        on: FlyBuzzed & { event.range == 4 } => { spider.turn() }
        on: HarpPlucked => ! Forage()
        on: SeesPlayer & { event.range <= 10 } => ! Balk()
        on: HarpPlucked => ! Coil()
        on: RainFell & { event.trust == 5 } => "spider stirs at {event.kind}"
        on: Rested => { spider.state = "alert" }
    until: EnemyInRange
:end

state_machine: Mantis(rate: number)
    default: Mantis.Advance
    init: { mantis.spawn() }

    state: Advance
        on: GiantShouts => "the mantis reacts"
        on: NoiseHeard => { mantis.state = "tense" }
        on: Splash & { event.trust == 3 } => { mantis.shift() }
        on: WhipCracked => { mantis.energy = mantis.energy - 1 }
    until: EnemyInRange

    state: Alert(target: number)
        init: { mantis.state = "alert" }
        on: FlyBuzzed => ! Drift()
        on: DawnBreaks & { event.range >= 8 } => ! Advance()
        on: Splash => ! Glide()
        on: Cornered & { event.amount > 1 } => { mantis.count = mantis.count + 1 }
        on: DawnBreaks & { event.count <= 2 } => { mantis.state = "ready" }
    until: Wounded

    state: Rear
        deinit: { mantis.pause() }
        on: CartLoaded => "the mantis holds its ground"
        on: HarpPlucked => { mantis.state = "ready" }
        on: Spooked => { mantis.energy = mantis.energy - 1 }
        on: NoiseHeard & { event.volume > 2 } => ! Catch()
        on: Wounded => { mantis.pos = mantis.pos:step() }
        on: WhipCracked => { mantis.count = mantis.count + 1 }
        on: Cornered & { event.amount == 1 } => { mantis.energy = mantis.energy - 1 }
    until: PreyEscaped

    state: Glide
        init: { mantis.pos = mantis.pos:step() }
        on: Cornered & { event.trust <= 8 } => { mantis.pos = mantis.pos:step() }
        on: Spooked => ! Catch()
        on: Splash & { event.trust <= 5 } => "the mantis reacts"
        on: CartLoaded => { mantis.pos = mantis.pos:step() }
        on: SeesPlayer => "{event.kind} startles the mantis"
        on: SugarOffered & { event.depth < 2 } => "{event.kind} startles the mantis"
    until: BladeClash

    state: Drift(target: string)
        deinit: { mantis.pos = mantis.pos:step() }
        on: SunRose => { mantis.turn() }
        on: WhipCracked => ! Rear()
        on: NoiseHeard & { event.weight > 1 } => ! Catch()
        on: EnemyInRange & { event.weight == 10 } => { mantis.shift() }
        on: Tick => { mantis.state = "alert" }
    until: FlyBuzzed

    state: Catch
        init: { mantis.count = mantis.count + 1 }
        on: PreyEscaped => { mantis.state = "ready" }
        on: Splash & { event.distance < 4 } => ! Advance()
        on: Rested & { event.range < 4 } => { mantis.pause() }
        on: FlyBuzzed => { mantis.wake() }
        on: SeesPlayer & { event.trust > 1 } => ! Alert()
        on: EnemyInRange => { mantis.pos = mantis.pos:step() }
    until: EnemyInRange
:end

state_machine: Cricket(rate: number)
    default: Cricket.Glide
    init: { cricket.spawn() }

    state: Glide
        on: WhipCracked => "cricket stirs at {event.kind}"
        on: SunRose => ! Sit()
        on: Wounded => ! Sit()
        on: PreyEscaped & { event.trust >= 1 } => { cricket.state = "tense" }
        on: FlyBuzzed & { event.amount > 5 } => "the cricket holds its ground"
        on: ArrowIncoming => { cricket.pos = cricket.pos:step() }
        on: PathBlocked & { event.speed >= 8 } => { cricket.energy = cricket.energy - 1 }
    until: SeesPrey

    state: Forage(goal: number)
        init: { cricket.pos = cricket.pos:step() }
        on: Cornered & { event.trust > 8 } => ! Sit()
        on: SeesPlayer => ! Chase()
        on: PreyEscaped => ! Nest()
        on: DuskFalls & { event.trust >= 8 } => { cricket.energy = cricket.energy - 1 }
    until: Rested

    state: Chase
        init: { cricket.energy = cricket.energy - 1 }
        on: DuskFalls & { event.range <= 5 } => "cricket stirs at {event.kind}"
        on: DawnBreaks => ! Alert()
        on: PathBlocked => ! Nest()
        on: SunRose => ! Sit()
        on: DuskFalls & { event.volume <= 3 } => { cricket.state = "alert" }
        on: Wounded => "{event.kind} startles the cricket"
    until: NoiseHeard

    state: Pounce
        init: { cricket.shift() }
        on: RainFell => "cricket stirs at {event.kind}"
        on: ArrowIncoming & { event.weight <= 1 } => "the cricket holds its ground"
        on: PreyEscaped & { event.range < 2 } => "the cricket reacts"
        on: RainFell => ! Alert()
        on: RainFell & { event.trust < 1 } => { cricket.count = cricket.count + 1 }
        on: SunRose & { event.range == 4 } => { cricket.count = cricket.count + 1 }
    until: PreyEscaped

    state: Alert
        deinit: { cricket.pos = cricket.pos:step() }
        on: PathBlocked & { event.count == 8 } => { cricket.stir() }
        on: PathBlocked & { event.distance > 3 } => ! Pounce()
        on: DawnBreaks & { event.fear < 3 } => { cricket.energy = cricket.energy - 1 }
        on: DuskFalls & { event.count < 3 } => "{event.kind} startles the cricket"
    until: CartLoaded

    state: Nest
        init: { cricket.state = "calm" }
        on: PreyEscaped & { event.amount <= 1 } => { cricket.energy = cricket.energy - 1 }
        on: Splash & { event.speed <= 10 } => { cricket.energy = cricket.energy - 1 }
        on: ArrowIncoming => ! Glide()
        on: SugarOffered & { event.amount > 8 } => { cricket.pos = cricket.pos:step() }
        on: FlyBuzzed => "cricket stirs at {event.kind}"
    until: Tick

    state: Sit(prey: number)
        init: { cricket.pos = cricket.pos:step() }
        on: Cornered => { cricket.count = cricket.count + 1 }
        on: BladeClash & { event.depth < 4 } => ! Nest()
        on: PreyEscaped & { event.amount <= 2 } => ! Pounce()
        on: PathBlocked => { cricket.energy = cricket.energy - 1 }
        on: PreyEscaped & { event.depth >= 10 } => { cricket.count = cricket.count + 1 }
        on: SugarOffered => { cricket.state = "ready" }
    until: Rested
:end

state_machine: Dragonfly(rate: string)
    default: Dragonfly.Hop

    state: Hop
        init: { dragonfly.count = dragonfly.count + 1 }
        deinit: { dragonfly.count = dragonfly.count + 1 }
        on: GiantShouts => "{event.kind} startles the dragonfly"
        on: Rested => ! Coil()
        on: FlyBuzzed => ! Patrol()
        on: CartLoaded => { dragonfly.count = dragonfly.count + 1 }
        on: CartLoaded => ! Coil()
        on: DuskFalls & { event.distance == 2 } => ! Shamble()
    until: Splash

    state: Shamble
        on: DawnBreaks => { dragonfly.energy = dragonfly.energy - 1 }
        on: WhipCracked & { event.fear >= 10 } => { dragonfly.shift() }
        on: PathBlocked => ! Lunge()
        on: BladeClash & { event.count <= 4 } => ! Sprint()
        on: ScentCaught & { event.volume <= 5 } => { dragonfly.pos = dragonfly.pos:step() }
        on: HarpPlucked & { event.count <= 4 } => ! Hop()
        on: WhipCracked => { dragonfly.energy = dragonfly.energy - 1 }
    until: DawnBreaks

    state: Lunge(prey: number)
        deinit: { dragonfly.pause() }
        on: SeesPlayer & { event.count <= 10 } => ! Hop()
        on: BladeClash => ! Patrol()
        on: SunRose => ! Coil()
        on: Splash => { dragonfly.state = "tense" }
        on: DuskFalls & { event.fear >= 2 } => ! Drift()
    until: DuskFalls

    state: Coil(goal: string)
        on: PathBlocked & { event.fear < 8 } => ! Shamble()
        on: Tick => { dragonfly.energy = dragonfly.energy - 1 }
        on: DawnBreaks & { event.volume < 1 } => { dragonfly.count = dragonfly.count + 1 }
        on: CartLoaded & { event.volume > 3 } => ! Hop()
        on: RainFell => "the dragonfly reacts"
        on: ClashResolved => ! Hop()
        on: ScentCaught & { event.speed > 5 } => { dragonfly.count = dragonfly.count + 1 }
    until: Spooked

    state: Drift(target: string)
        on: DuskFalls => { dragonfly.pause() }
        on: ArrowIncoming & { event.depth == 3 } => "the dragonfly holds its ground"
        on: Spooked & { event.speed == 10 } => ! Lunge()
        on: Wounded & { event.range == 10 } => { dragonfly.pos = dragonfly.pos:step() }
        on: DawnBreaks => "{event.kind} startles the dragonfly"
        on: BladeClash => { dragonfly.count = dragonfly.count + 1 }
    until: SeesPlayer

    state: Patrol
        on: GiantShouts & { event.speed == 1 } => { dragonfly.pos = dragonfly.pos:step() }
        on: EnemyInRange & { event.weight < 10 } => "{event.kind} startles the dragonfly"
        on: SeesPlayer => ! Sprint()
        on: ReinsPulled & { event.speed >= 5 } => { dragonfly.state = "tense" }
    until: BladeClash

    state: Sprint
        init: { dragonfly.wake() }
        on: ClashResolved => ! Lunge()
        on: Splash => { dragonfly.state = "tense" }
        on: EnemyInRange => { dragonfly.wake() }
        on: FlyBuzzed & { event.trust == 5 } => ! Hop()
        on: RainFell => { dragonfly.turn() }
        on: ClashResolved & { event.amount >= 8 } => ! Patrol()
        on: FlyBuzzed & { event.count <= 2 } => { dragonfly.pos = dragonfly.pos:step() }
    until: CartLoaded
:end

state_machine: Wasp
    default: Wasp.Flee

    state: Flee
        init: { wasp.turn() }
        on: EnemyInRange => "the wasp holds its ground"
        on: WhipCracked => { wasp.shift() }
        on: Spooked => "the wasp holds its ground"
        on: ReinsPulled => ! Burrow()
    until: GiantShouts

    state: Burrow
        on: Tick & { event.count < 1 } => { wasp.pos = wasp.pos:step() }
        on: ReinsPulled => { wasp.wake() }
        on: NoiseHeard & { event.count >= 10 } => { wasp.stir() }
        on: Cornered => { wasp.count = wasp.count + 1 }
        on: SugarOffered & { event.speed <= 3 } => ! Flee()
        on: GiantShouts => ! Guard()
        on: FlyBuzzed => ! Guard()
    until: RainFell

    state: Rest
        on: SugarOffered & { event.weight == 8 } => "the wasp reacts"
        on: SeesPrey => "{event.kind} startles the wasp"
        on: DuskFalls & { event.trust > 3 } => ! Burrow()
        on: GiantShouts & { event.range > 1 } => ! Flee()
    until: NoiseHeard

    state: Perch(prey: string)
        deinit: { wasp.pos = wasp.pos:step() }
        on: Cornered => { wasp.state = "alert" }
        on: DuskFalls & { event.range == 10 } => { wasp.pos = wasp.pos:step() }
        on: WhipCracked & { event.range <= 4 } => { wasp.state = "ready" }
        on: NoiseHeard => { wasp.energy = wasp.energy - 1 }
        on: SeesPrey & { event.amount >= 2 } => { wasp.state = "ready" }
    until: WhipCracked

    state: Drift
        init: { wasp.count = wasp.count + 1 }
        on: DuskFalls => { wasp.pos = wasp.pos:step() }
        on: SugarOffered => { wasp.count = wasp.count + 1 }
        on: GiantShouts => { wasp.pause() }
        on: Splash & { event.weight < 1 } => { wasp.count = wasp.count + 1 }
    until: Wounded

    state: Hop
        init: { wasp.stir() }
        on: Cornered & { event.speed < 4 } => { wasp.energy = wasp.energy - 1 }
        on: Tick & { event.amount == 4 } => { wasp.state = "ready" }
        on: ScentCaught => { wasp.state = "tense" }
        on: Splash => { wasp.pos = wasp.pos:step() }
        on: PathBlocked => "the wasp holds its ground"
    until: Tick

    state: Guard
        deinit: { wasp.wake() }
        on: Splash & { event.amount >= 5 } => { wasp.count = wasp.count + 1 }
        on: HarpPlucked => ! Drift()
        on: ReinsPulled => "wasp stirs at {event.kind}"
        on: SeesPlayer & { event.amount <= 3 } => ! Hop()
        on: FlyBuzzed & { event.count >= 5 } => "the wasp holds its ground"
        on: PathBlocked & { event.volume >= 10 } => { wasp.count = wasp.count + 1 }
    until: GiantShouts
:end

state_machine: Firefly
    default: Firefly.Alert
    init: { firefly.spawn() }

    state: Alert
        on: FlyBuzzed => { firefly.stir() }
        on: PathBlocked & { event.fear == 2 } => ! Strike()
        on: ArrowIncoming => { firefly.stir() }
        on: ClashResolved & { event.range < 5 } => ! Balk()
        on: BladeClash & { event.fear <= 8 } => ! Idle()
        on: EnemyInRange & { event.fear > 4 } => ! Swarm()
        on: ClashResolved => { firefly.turn() }
    until: RainFell

    state: Idle
        init: { firefly.pos = firefly.pos:step() }
        deinit: { firefly.count = firefly.count + 1 }
        on: SeesPrey => ! Alert()
        on: ArrowIncoming & { event.fear > 1 } => { firefly.pos = firefly.pos:step() }
        on: FlyBuzzed => { firefly.energy = firefly.energy - 1 }
        on: Splash => { firefly.growl() }
    until: BladeClash

    state: Shamble
        init: { firefly.stir() }
        deinit: { firefly.state = "alert" }
        on: GiantShouts & { event.trust < 3 } => ! Alert()
        on: GiantShouts => { firefly.pos = firefly.pos:step() }
        on: RainFell & { event.count < 8 } => { firefly.energy = firefly.energy - 1 }
        on: SeesPlayer => { firefly.energy = firefly.energy - 1 }
        on: GiantShouts => ! Balk()
        on: Splash => "{event.kind} startles the firefly"
        on: ScentCaught & { event.count >= 2 } => { firefly.energy = firefly.energy - 1 }
    until: FlyBuzzed

    state: Strike
        deinit: { firefly.energy = firefly.energy - 1 }
        on: CartLoaded => { firefly.state = "calm" }
        on: BladeClash => { firefly.energy = firefly.energy - 1 }
        on: Spooked => ! Idle()
        on: Tick & { event.distance < 8 } => ! Balk()
        on: Spooked => { firefly.state = "tense" }
    until: CartLoaded

    state: Pounce(prey: number)
        init: { firefly.energy = firefly.energy - 1 }
        on: ClashResolved => "{event.kind} startles the firefly"
        on: HarpPlucked & { event.weight >= 8 } => "{event.kind} startles the firefly"
        on: BladeClash & { event.depth <= 1 } => { firefly.energy = firefly.energy - 1 }
        on: SunRose & { event.count > 3 } => "{event.kind} startles the firefly"
    until: BladeClash

    state: Swarm
        init: { firefly.energy = firefly.energy - 1 }
        on: WhipCracked => ! Strike()
        on: ArrowIncoming & { event.fear < 2 } => ! Alert()
        on: FlyBuzzed => ! Alert()
        on: SugarOffered => { firefly.pos = firefly.pos:step() }
        on: SeesPrey => { firefly.count = firefly.count + 1 }
    until: DawnBreaks

    state: Balk
        init: { firefly.count = firefly.count + 1 }
        deinit: { firefly.state = "calm" }
        on: SeesPrey => { firefly.turn() }
        on: SeesPlayer & { event.depth < 8 } => { firefly.stir() }
        on: ArrowIncoming & { event.volume >= 5 } => "the firefly reacts"
        on: GiantShouts & { event.distance > 3 } => { firefly.count = firefly.count + 1 }
        on: Tick & { event.depth > 5 } => ! Alert()
        on: RainFell => "{event.kind} startles the firefly"
    until: SunRose
:end

## =========================================================================
## sprites_sea.rule -- 10 creatures
## =========================================================================

state_machine: Crab(rate: string)
    default: Crab.Idle

    state: Idle
        init: { crab.pause() }
        on: ReinsPulled & { event.count >= 5 } => "the crab holds its ground"
        on: SugarOffered & { event.volume > 1 } => ! Sprint()
        on: Splash & { event.volume <= 2 } => "the crab holds its ground"
        on: Spooked => ! Sprint()
    until: Rested

    state: Strike
        init: { crab.count = crab.count + 1 }
        deinit: { crab.state = "ready" }
        on: Tick => { crab.pos = crab.pos:step() }
        on: SugarOffered & { event.depth > 3 } => ! Sprint()
        on: WhipCracked => { crab.count = crab.count + 1 }
        on: RainFell => "{event.kind} startles the crab"
        on: Wounded => ! Balk()
        on: SunRose & { event.amount >= 5 } => ! Sprint()
    until: DuskFalls

    state: Haul(goal: string)
        init: { crab.growl() }
        on: ClashResolved => ! Strike()
        on: Spooked => { crab.shift() }
        on: ReinsPulled & { event.volume >= 4 } => ! Strike()
        on: Wounded => "the crab reacts"
        on: SeesPlayer => ! Idle()
    until: SeesPrey

    state: Alert
        on: SunRose => ! Balk()
        on: Rested => "the crab reacts"
        on: FlyBuzzed => ! Balk()
        on: GiantShouts & { event.range == 5 } => ! Sprint()
    until: SeesPlayer

    state: Flee
        on: Rested & { event.fear <= 10 } => { crab.stir() }
        on: Tick => ! Haul()
        on: Rested => ! Alert()
        on: GiantShouts => { crab.energy = crab.energy - 1 }
        on: ArrowIncoming & { event.fear > 10 } => ! Haul()
        on: Wounded => "the crab reacts"
        on: ReinsPulled & { event.speed == 3 } => ! Sprint()
    until: Wounded

    state: Sprint
        on: GiantShouts => ! Alert()
        on: FlyBuzzed & { event.distance == 4 } => { crab.energy = crab.energy - 1 }
        on: NoiseHeard => "{event.kind} startles the crab"
        on: ClashResolved & { event.range >= 8 } => ! Haul()
        on: ArrowIncoming & { event.trust == 1 } => ! Idle()
        on: PreyEscaped => { crab.state = "tense" }
        on: RainFell => ! Flee()
    until: SugarOffered

    state: Balk
        init: { crab.shift() }
        on: NoiseHeard => "the crab holds its ground"
        on: ReinsPulled & { event.fear == 3 } => { crab.energy = crab.energy - 1 }
        on: SunRose & { event.trust == 5 } => ! Idle()
        on: CartLoaded & { event.depth < 8 } => ! Idle()
        on: Cornered & { event.speed >= 1 } => "{event.kind} startles the crab"
    until: ScentCaught
:end

state_machine: Eel(cunning: number)
    default: Eel.Crouch
    init: { eel.spawn() }

    state: Crouch(prey: number)
        init: { eel.pos = eel.pos:step() }
        deinit: { eel.pos = eel.pos:step() }
        on: WhipCracked => "eel stirs at {event.kind}"
        on: Wounded => ! Guard()
        on: HarpPlucked => "the eel reacts"
        on: FlyBuzzed => ! Shamble()
    until: Wounded

    state: Guard
        on: Tick & { event.count <= 4 } => { eel.pause() }
        on: Rested => "the eel reacts"
        on: DawnBreaks & { event.count < 1 } => ! Shamble()
        on: WhipCracked & { event.weight >= 4 } => { eel.state = "tense" }
        on: PreyEscaped => { eel.pos = eel.pos:step() }
        on: EnemyInRange => ! Burrow()
    until: CartLoaded

    state: Advance
        init: { eel.turn() }
        deinit: { eel.count = eel.count + 1 }
        on: ReinsPulled => "eel stirs at {event.kind}"
        on: Tick => ! Guard()
        on: SugarOffered => ! Shamble()
        on: SeesPrey & { event.depth <= 4 } => ! Crouch()
        on: PathBlocked => ! Crouch()
        on: WhipCracked => "the eel holds its ground"
    until: Tick

    state: Burrow
        on: SunRose => ! Guard()
        on: ScentCaught => "the eel holds its ground"
        on: GiantShouts => { eel.pos = eel.pos:step() }
        on: ReinsPulled & { event.volume >= 10 } => ! Advance()
        on: Splash & { event.depth <= 5 } => "the eel holds its ground"
        on: Splash & { event.trust < 3 } => "the eel reacts"
    until: Rested

    state: Wait
        init: { eel.state = "calm" }
        on: RainFell => ! Advance()
        on: BladeClash & { event.volume >= 3 } => ! Crouch()
        on: PathBlocked => { eel.turn() }
        on: PreyEscaped & { event.distance >= 4 } => { eel.count = eel.count + 1 }
        on: ClashResolved & { event.speed > 8 } => { eel.pos = eel.pos:step() }
        on: GiantShouts & { event.amount == 10 } => { eel.energy = eel.energy - 1 }
    until: ArrowIncoming

    state: Shamble
        on: PreyEscaped & { event.volume > 5 } => { eel.pos = eel.pos:step() }
        on: RainFell => { eel.pause() }
        on: WhipCracked & { event.distance == 2 } => ! Crouch()
        on: ClashResolved => { eel.count = eel.count + 1 }
        on: Splash => { eel.state = "tense" }
        on: HarpPlucked => "the eel reacts"
        on: EnemyInRange => { eel.pos = eel.pos:step() }
    until: EnemyInRange
:end

state_machine: Octopus(stamina: number)
    default: Octopus.Surface
    init: { octopus.spawn() }

    state: Surface
        init: { octopus.state = "alert" }
        on: HarpPlucked & { event.volume <= 3 } => { octopus.state = "alert" }
        on: Cornered & { event.fear == 5 } => { octopus.count = octopus.count + 1 }
        on: Wounded => ! Gallop()
        on: RainFell & { event.range <= 10 } => ! Nest()
    until: ArrowIncoming

    state: Gallop
        on: NoiseHeard => { octopus.energy = octopus.energy - 1 }
        on: Spooked & { event.range < 2 } => ! Nest()
        on: FlyBuzzed => "{event.kind} startles the octopus"
        on: EnemyInRange => { octopus.energy = octopus.energy - 1 }
        on: Splash => { octopus.energy = octopus.energy - 1 }
    until: ReinsPulled

    state: Pounce
        on: ReinsPulled => { octopus.pos = octopus.pos:step() }
        on: ArrowIncoming & { event.fear > 10 } => { octopus.energy = octopus.energy - 1 }
        on: GiantShouts & { event.weight <= 4 } => ! Nest()
        on: Spooked & { event.amount <= 5 } => { octopus.growl() }
    until: EnemyInRange

    state: Trot
        deinit: { octopus.stir() }
        on: SugarOffered => "the octopus holds its ground"
        on: PathBlocked => ! Pounce()
        on: RainFell & { event.count == 1 } => "octopus stirs at {event.kind}"
        on: ClashResolved => ! Surface()
    until: RainFell

    state: Nest(prey: number)
        on: SeesPlayer & { event.depth > 10 } => "the octopus holds its ground"
        on: ArrowIncoming => { octopus.count = octopus.count + 1 }
        on: DawnBreaks => { octopus.shift() }
        on: ArrowIncoming => ! Pounce()
        on: ClashResolved => ! Surface()
        on: Splash => "{event.kind} startles the octopus"
    until: ReinsPulled

    state: Retreat(foe: number)
        init: { octopus.count = octopus.count + 1 }
        on: GiantShouts => { octopus.shift() }
        on: ArrowIncoming => { octopus.pos = octopus.pos:step() }
        on: SugarOffered => { octopus.count = octopus.count + 1 }
        on: PathBlocked & { event.trust > 1 } => ! Pounce()
        on: SugarOffered & { event.distance > 4 } => "the octopus holds its ground"
        on: NoiseHeard => { octopus.pos = octopus.pos:step() }
    until: PreyEscaped

    state: Dive(goal: string)
        on: WhipCracked & { event.count == 8 } => { octopus.count = octopus.count + 1 }
        on: Wounded & { event.depth == 2 } => { octopus.pos = octopus.pos:step() }
        on: EnemyInRange => ! Retreat()
        on: DawnBreaks => { octopus.pos = octopus.pos:step() }
        on: Tick & { event.fear == 10 } => ! Trot()
        on: ClashResolved => ! Trot()
        on: WhipCracked & { event.distance <= 3 } => { octopus.energy = octopus.energy - 1 }
    until: SugarOffered
:end

state_machine: Seal
    default: Seal.Gallop
    init: { seal.spawn() }

    state: Gallop
        on: ArrowIncoming => "seal stirs at {event.kind}"
        on: ScentCaught => ! Glide()
        on: SeesPrey & { event.trust >= 5 } => ! Burrow()
        on: Splash & { event.trust <= 1 } => ! Circle()
        on: PathBlocked => ! Glide()
        on: WhipCracked => ! Idle()
    until: FlyBuzzed

    state: Shamble(goal: string)
        on: GiantShouts & { event.depth > 3 } => "the seal holds its ground"
        on: RainFell & { event.depth <= 10 } => ! Glide()
        on: SugarOffered => ! Glide()
        on: SeesPlayer => "{event.kind} startles the seal"
        on: SeesPrey & { event.count >= 5 } => ! Circle()
        on: CartLoaded => "{event.kind} startles the seal"
    until: PreyEscaped

    state: Advance
        on: Wounded => ! Gallop()
        on: GiantShouts & { event.fear < 1 } => ! Circle()
        on: ScentCaught & { event.count > 2 } => { seal.state = "ready" }
        on: GiantShouts & { event.range < 5 } => "the seal holds its ground"
        on: ScentCaught => "the seal holds its ground"
    until: ScentCaught

    state: Glide
        init: { seal.count = seal.count + 1 }
        on: Wounded & { event.volume >= 10 } => ! Idle()
        on: WhipCracked => ! Circle()
        on: ReinsPulled => ! Advance()
        on: SeesPlayer & { event.volume == 3 } => "the seal reacts"
        on: ClashResolved & { event.volume == 8 } => ! Gallop()
    until: NoiseHeard

    state: Burrow
        init: { seal.pause() }
        deinit: { seal.state = "ready" }
        on: Tick & { event.volume <= 3 } => { seal.pos = seal.pos:step() }
        on: PathBlocked => ! Shamble()
        on: GiantShouts & { event.fear == 10 } => ! Advance()
        on: Wounded => ! Idle()
    until: SugarOffered

    state: Idle
        deinit: { seal.energy = seal.energy - 1 }
        on: EnemyInRange => { seal.shift() }
        on: DuskFalls => "the seal reacts"
        on: DawnBreaks => ! Glide()
        on: NoiseHeard => ! Shamble()
        on: PathBlocked => ! Gallop()
        on: PathBlocked & { event.distance > 4 } => "{event.kind} startles the seal"
    until: CartLoaded

    state: Circle(foe: string)
        on: Tick & { event.distance == 1 } => { seal.stir() }
        on: Wounded => "the seal holds its ground"
        on: HarpPlucked & { event.weight == 1 } => "the seal reacts"
        on: DuskFalls & { event.fear <= 2 } => ! Burrow()
        on: SugarOffered => { seal.energy = seal.energy - 1 }
        on: HarpPlucked & { event.depth > 10 } => ! Gallop()
        on: Rested => { seal.energy = seal.energy - 1 }
    until: SunRose
:end

state_machine: Turtle(rate: string)
    default: Turtle.Crouch
    init: { turtle.spawn() }

    state: Crouch
        on: ScentCaught & { event.amount == 1 } => "turtle stirs at {event.kind}"
        on: Wounded & { event.fear > 1 } => { turtle.energy = turtle.energy - 1 }
        on: Cornered & { event.trust == 2 } => ! Patrol()
        on: EnemyInRange & { event.weight < 5 } => ! Patrol()
        on: Spooked & { event.weight >= 10 } => { turtle.state = "ready" }
        on: FlyBuzzed & { event.fear <= 5 } => { turtle.state = "alert" }
    until: Tick

    state: Hunt
        on: Cornered => ! Patrol()
        on: DawnBreaks => "the turtle reacts"
        on: Rested => { turtle.state = "tense" }
        on: Cornered => ! Forage()
        on: PreyEscaped & { event.trust > 3 } => "turtle stirs at {event.kind}"
        on: GiantShouts & { event.range > 1 } => ! Crouch()
        on: HarpPlucked & { event.count > 10 } => ! Guard()
    until: Splash

    state: Patrol
        on: NoiseHeard & { event.fear <= 2 } => "{event.kind} startles the turtle"
        on: RainFell & { event.trust <= 3 } => { turtle.turn() }
        on: ClashResolved & { event.fear == 1 } => "the turtle holds its ground"
        on: Spooked & { event.range < 1 } => { turtle.pos = turtle.pos:step() }
    until: NoiseHeard

    state: Nest
        init: { turtle.pos = turtle.pos:step() }
        on: SugarOffered => "the turtle holds its ground"
        on: DuskFalls => { turtle.count = turtle.count + 1 }
        on: NoiseHeard => { turtle.pause() }
        on: DawnBreaks & { event.count <= 2 } => { turtle.energy = turtle.energy - 1 }
        on: HarpPlucked => ! Guard()
        on: EnemyInRange => { turtle.count = turtle.count + 1 }
    until: GiantShouts

    state: Guard(target: string)
        init: { turtle.state = "calm" }
        deinit: { turtle.count = turtle.count + 1 }
        on: WhipCracked => ! Forage()
        on: ReinsPulled => ! Balk()
        on: FlyBuzzed => "the turtle holds its ground"
        on: GiantShouts => ! Crouch()
        on: Tick & { event.count > 5 } => ! Patrol()
        on: ScentCaught & { event.trust == 10 } => ! Crouch()
        on: FlyBuzzed => ! Balk()
    until: EnemyInRange

    state: Balk(foe: number)
        on: SeesPlayer & { event.distance >= 4 } => "the turtle reacts"
        on: Splash => { turtle.pos = turtle.pos:step() }
        on: SeesPlayer => ! Guard()
        on: Cornered & { event.amount >= 2 } => "{event.kind} startles the turtle"
    until: EnemyInRange

    state: Forage
        on: FlyBuzzed & { event.amount < 2 } => { turtle.pos = turtle.pos:step() }
        on: FlyBuzzed & { event.distance <= 4 } => ! Guard()
        on: Rested => { turtle.energy = turtle.energy - 1 }
        on: WhipCracked & { event.weight == 1 } => ! Guard()
        on: Wounded => { turtle.turn() }
        on: Wounded & { event.count <= 1 } => ! Crouch()
        on: PathBlocked => "turtle stirs at {event.kind}"
    until: EnemyInRange
:end

state_machine: Shark(cunning: string)
    default: Shark.Swarm

    state: Swarm
        on: Splash => ! Pounce()
        on: DuskFalls => "the shark holds its ground"
        on: Tick & { event.weight > 5 } => "{event.kind} startles the shark"
        on: Cornered & { event.count >= 4 } => { shark.count = shark.count + 1 }
        on: Cornered => ! Advance()
    until: Splash

    state: Climb
        on: SunRose & { event.trust == 10 } => ! Flee()
        on: DuskFalls & { event.trust <= 4 } => { shark.energy = shark.energy - 1 }
        on: Wounded & { event.amount >= 3 } => { shark.state = "ready" }
        on: DawnBreaks & { event.trust >= 10 } => { shark.wake() }
    until: SeesPrey

    state: Flee
        on: DuskFalls & { event.speed >= 2 } => ! Climb()
        on: Splash => ! Pounce()
        on: SeesPrey => ! Pounce()
        on: DuskFalls & { event.count == 5 } => ! Pounce()
    until: ArrowIncoming

    state: Advance
        on: WhipCracked & { event.range < 10 } => ! Flee()
        on: Splash => { shark.count = shark.count + 1 }
        on: SugarOffered => ! Swarm()
        on: CartLoaded & { event.volume >= 5 } => "shark stirs at {event.kind}"
        on: PathBlocked & { event.amount == 1 } => "the shark holds its ground"
        on: SunRose & { event.distance == 3 } => { shark.energy = shark.energy - 1 }
        on: ScentCaught => { shark.energy = shark.energy - 1 }
    until: DawnBreaks

    state: Pounce
        deinit: { shark.pos = shark.pos:step() }
        on: Splash => { shark.count = shark.count + 1 }
        on: Wounded => { shark.pos = shark.pos:step() }
        on: BladeClash & { event.range <= 4 } => "the shark reacts"
        on: ReinsPulled => { shark.state = "tense" }
        on: SugarOffered & { event.trust > 2 } => { shark.state = "tense" }
    until: HarpPlucked
:end

state_machine: Jellyfish(strength: string)
    default: Jellyfish.Lunge

    state: Lunge
        on: DuskFalls => "jelly stirs at {event.kind}"
        on: DuskFalls => ! Gallop()
        on: Splash => ! Gallop()
        on: NoiseHeard => ! Graze()
        on: ArrowIncoming & { event.trust == 3 } => { jelly.pos = jelly.pos:step() }
        on: RainFell => ! Graze()
        on: DawnBreaks & { event.depth <= 1 } => { jelly.state = "calm" }
    until: RainFell

    state: Gallop(target: string)
        on: RainFell => ! Strike()
        on: Splash & { event.depth >= 1 } => ! Pounce()
        on: DuskFalls => "{event.kind} startles the jelly"
        on: SeesPrey => "the jelly reacts"
    until: Wounded

    state: Graze(foe: string)
        on: ArrowIncoming & { event.speed > 10 } => ! Gallop()
        on: Spooked & { event.range < 3 } => ! Gallop()
        on: ArrowIncoming & { event.depth < 2 } => "jelly stirs at {event.kind}"
        on: ArrowIncoming => { jelly.pos = jelly.pos:step() }
        on: CartLoaded => ! Scatter()
    until: BladeClash

    state: Scatter
        init: { jelly.energy = jelly.energy - 1 }
        on: ReinsPulled & { event.fear > 3 } => "{event.kind} startles the jelly"
        on: GiantShouts => "the jelly reacts"
        on: Spooked => "the jelly reacts"
        on: BladeClash & { event.depth <= 2 } => { jelly.stir() }
        on: DuskFalls & { event.weight == 4 } => ! Strike()
    until: EnemyInRange

    state: Strike
        init: { jelly.count = jelly.count + 1 }
        on: GiantShouts => { jelly.count = jelly.count + 1 }
        on: Spooked & { event.volume <= 4 } => { jelly.pos = jelly.pos:step() }
        on: NoiseHeard & { event.range >= 10 } => ! Scatter()
        on: DawnBreaks & { event.trust >= 10 } => "jelly stirs at {event.kind}"
        on: EnemyInRange & { event.depth < 10 } => { jelly.pos = jelly.pos:step() }
    until: ArrowIncoming

    state: Pounce(foe: string)
        init: { jelly.pos = jelly.pos:step() }
        on: SeesPlayer & { event.amount <= 2 } => ! Scatter()
        on: FlyBuzzed => ! Strike()
        on: SeesPrey => ! Graze()
        on: Spooked => { jelly.state = "calm" }
    until: ScentCaught
:end

state_machine: Starfish
    default: Starfish.Stalk
    init: { starfish.spawn() }

    state: Stalk
        on: BladeClash => { starfish.count = starfish.count + 1 }
        on: WhipCracked & { event.fear >= 5 } => ! Guard()
        on: PathBlocked & { event.trust == 8 } => "the starfish holds its ground"
        on: Wounded => ! Rest()
    until: Wounded

    state: Rest
        deinit: { starfish.wake() }
        on: Wounded & { event.fear == 4 } => ! Guard()
        on: ArrowIncoming & { event.amount >= 4 } => ! Guard()
        on: RainFell & { event.depth < 4 } => ! Stalk()
        on: Spooked => ! Burrow()
        on: PreyEscaped & { event.volume <= 4 } => { starfish.count = starfish.count + 1 }
    until: SugarOffered

    state: Charge
        init: { starfish.stir() }
        on: Spooked & { event.weight >= 10 } => { starfish.pos = starfish.pos:step() }
        on: SeesPlayer => { starfish.state = "tense" }
        on: SugarOffered => { starfish.count = starfish.count + 1 }
        on: GiantShouts => ! Burrow()
        on: RainFell => { starfish.energy = starfish.energy - 1 }
        on: SeesPlayer & { event.trust >= 3 } => "starfish stirs at {event.kind}"
        on: CartLoaded => { starfish.energy = starfish.energy - 1 }
    until: CartLoaded

    state: Burrow
        on: Tick & { event.count == 10 } => ! Stalk()
        on: Rested => { starfish.pos = starfish.pos:step() }
        on: DuskFalls => ! Charge()
        on: Cornered & { event.weight == 10 } => { starfish.growl() }
    until: BladeClash

    state: Retreat
        init: { starfish.energy = starfish.energy - 1 }
        on: Wounded & { event.fear > 10 } => { starfish.state = "tense" }
        on: SeesPrey => { starfish.turn() }
        on: SugarOffered => ! Stalk()
        on: ScentCaught => { starfish.state = "calm" }
    until: ScentCaught

    state: Guard
        deinit: { starfish.count = starfish.count + 1 }
        on: CartLoaded & { event.range > 3 } => ! Retreat()
        on: CartLoaded => { starfish.pos = starfish.pos:step() }
        on: NoiseHeard & { event.volume <= 4 } => { starfish.count = starfish.count + 1 }
        on: ReinsPulled => ! Charge()
        on: ReinsPulled & { event.depth < 2 } => { starfish.energy = starfish.energy - 1 }
        on: RainFell => ! Charge()
    until: Rested
:end

state_machine: Dolphin(speed: string)
    default: Dolphin.Sit
    init: { dolphin.spawn() }

    state: Sit(foe: string)
        on: SugarOffered => { dolphin.wake() }
        on: PathBlocked => ! Swarm()
        on: PreyEscaped => { dolphin.pos = dolphin.pos:step() }
        on: ReinsPulled => "{event.kind} startles the dolphin"
        on: NoiseHeard & { event.weight >= 4 } => "dolphin stirs at {event.kind}"
    until: SunRose

    state: Swarm(prey: number)
        on: SeesPlayer => { dolphin.energy = dolphin.energy - 1 }
        on: HarpPlucked => { dolphin.pos = dolphin.pos:step() }
        on: RainFell => { dolphin.shift() }
        on: WhipCracked => { dolphin.pos = dolphin.pos:step() }
        on: ArrowIncoming => ! Surface()
        on: HarpPlucked => { dolphin.growl() }
    until: SugarOffered

    state: Climb
        init: { dolphin.count = dolphin.count + 1 }
        deinit: { dolphin.wake() }
        on: PreyEscaped => ! Surface()
        on: RainFell => { dolphin.pos = dolphin.pos:step() }
        on: Cornered => ! Surface()
        on: SugarOffered => ! Hunt()
    until: ClashResolved

    state: Surface
        deinit: { dolphin.state = "alert" }
        on: ReinsPulled => ! Climb()
        on: WhipCracked => { dolphin.energy = dolphin.energy - 1 }
        on: ReinsPulled & { event.fear < 3 } => { dolphin.pos = dolphin.pos:step() }
        on: Spooked & { event.count >= 2 } => { dolphin.state = "alert" }
        on: ScentCaught & { event.speed >= 1 } => ! Hunt()
        on: FlyBuzzed => ! Sit()
        on: Wounded & { event.weight < 4 } => ! Sit()
    until: CartLoaded

    state: Hunt
        init: { dolphin.wake() }
        on: Tick => ! Climb()
        on: Splash => ! Swarm()
        on: SugarOffered => ! Climb()
        on: GiantShouts & { event.volume < 1 } => ! Surface()
        on: DawnBreaks & { event.weight > 4 } => { dolphin.energy = dolphin.energy - 1 }
        on: DuskFalls => { dolphin.state = "ready" }
    until: ScentCaught
:end

state_machine: Urchin(reach: number)
    default: Urchin.Graze

    state: Graze(prey: string)
        init: { urchin.energy = urchin.energy - 1 }
        on: ClashResolved & { event.trust == 1 } => { urchin.state = "calm" }
        on: ScentCaught & { event.volume >= 10 } => ! Circle()
        on: SeesPrey & { event.speed >= 8 } => { urchin.pos = urchin.pos:step() }
        on: PreyEscaped & { event.range > 4 } => { urchin.state = "tense" }
        on: HarpPlucked => { urchin.growl() }
    until: Wounded

    state: Sit(target: string)
        deinit: { urchin.energy = urchin.energy - 1 }
        on: EnemyInRange & { event.volume < 2 } => { urchin.shift() }
        on: Spooked => { urchin.pause() }
        on: ScentCaught & { event.trust > 2 } => "{event.kind} startles the urchin"
        on: Spooked => "urchin stirs at {event.kind}"
        on: GiantShouts => { urchin.pos = urchin.pos:step() }
        on: EnemyInRange & { event.speed > 10 } => "the urchin reacts"
        on: CartLoaded & { event.speed > 2 } => ! Circle()
    until: ReinsPulled

    state: Rear
        init: { urchin.energy = urchin.energy - 1 }
        on: ClashResolved & { event.volume > 4 } => { urchin.pos = urchin.pos:step() }
        on: Cornered => { urchin.state = "ready" }
        on: SugarOffered & { event.fear <= 10 } => { urchin.state = "alert" }
        on: EnemyInRange => { urchin.count = urchin.count + 1 }
        on: ScentCaught => ! Circle()
        on: EnemyInRange & { event.volume > 1 } => ! Circle()
    until: RainFell

    state: Circle
        on: FlyBuzzed & { event.trust < 10 } => { urchin.stir() }
        on: Spooked & { event.speed <= 4 } => "urchin stirs at {event.kind}"
        on: ClashResolved & { event.volume > 10 } => "the urchin reacts"
        on: SugarOffered & { event.trust >= 4 } => { urchin.state = "calm" }
        on: ArrowIncoming & { event.range < 8 } => { urchin.energy = urchin.energy - 1 }
    until: BladeClash

    state: Lunge(foe: string)
        on: ArrowIncoming & { event.speed < 1 } => "the urchin holds its ground"
        on: Cornered => ! Rear()
        on: EnemyInRange & { event.weight >= 3 } => "the urchin reacts"
        on: SeesPrey => { urchin.state = "calm" }
    until: Cornered

    state: Burrow
        on: DawnBreaks & { event.fear >= 2 } => { urchin.state = "ready" }
        on: Spooked & { event.volume > 1 } => { urchin.wake() }
        on: BladeClash => ! Coil()
        on: Tick => "{event.kind} startles the urchin"
        on: ArrowIncoming => { urchin.energy = urchin.energy - 1 }
        on: SunRose & { event.trust <= 10 } => ! Sit()
    until: DawnBreaks

    state: Coil(foe: number)
        init: { urchin.state = "calm" }
        deinit: { urchin.pos = urchin.pos:step() }
        on: CartLoaded & { event.trust < 5 } => "urchin stirs at {event.kind}"
        on: EnemyInRange => ! Lunge()
        on: ScentCaught => ! Circle()
        on: PathBlocked => { urchin.state = "tense" }
        on: DawnBreaks & { event.weight == 5 } => ! Rear()
        on: PreyEscaped & { event.depth > 10 } => ! Rear()
    until: SunRose
:end

## =========================================================================
## sprites_plants.rule -- 10 plants (growth stages are exclusive)
## =========================================================================

state_machine: BeanPlant
    default: BeanPlant.Graze
    init: { plant.spawn() }

    state: Graze(prey: string)
        init: { plant.count = plant.count + 1 }
        on: Rested => { plant.state = "alert" }
        on: CartLoaded => ! Sprint()
        on: PreyEscaped => ! Perch()
        on: CartLoaded => { plant.count = plant.count + 1 }
        on: EnemyInRange & { event.speed < 5 } => { plant.count = plant.count + 1 }
    until: WhipCracked

    state: Pounce
        init: { plant.energy = plant.energy - 1 }
        on: Spooked => "plant stirs at {event.kind}"
        on: Splash & { event.trust < 10 } => ! Flee()
        on: SugarOffered => ! Perch()
        on: SunRose => { plant.count = plant.count + 1 }
        on: FlyBuzzed & { event.speed >= 4 } => { plant.turn() }
        on: ScentCaught & { event.trust < 5 } => "plant stirs at {event.kind}"
    until: Rested

    state: Flee(prey: number)
        on: ArrowIncoming => { plant.pos = plant.pos:step() }
        on: DuskFalls & { event.trust <= 10 } => { plant.pos = plant.pos:step() }
        on: Rested & { event.speed < 1 } => { plant.state = "alert" }
        on: Wounded & { event.count <= 8 } => ! Perch()
    until: HarpPlucked

    state: Swarm
        on: Wounded & { event.trust <= 8 } => { plant.energy = plant.energy - 1 }
        on: RainFell & { event.speed > 5 } => { plant.pos = plant.pos:step() }
        on: RainFell & { event.volume > 2 } => ! Sprint()
        on: BladeClash => { plant.pause() }
        on: SunRose & { event.depth >= 3 } => "the plant reacts"
    until: Wounded

    state: Perch
        init: { plant.count = plant.count + 1 }
        on: BladeClash & { event.depth > 10 } => { plant.pos = plant.pos:step() }
        on: SunRose & { event.fear >= 1 } => { plant.pos = plant.pos:step() }
        on: Tick => { plant.shift() }
        on: SunRose => { plant.pos = plant.pos:step() }
        on: BladeClash => ! Sprint()
        on: DawnBreaks & { event.trust > 2 } => ! Flee()
        on: ScentCaught & { event.weight <= 2 } => "the plant reacts"
    until: SeesPlayer

    state: Sprint
        on: BladeClash & { event.trust <= 1 } => { plant.energy = plant.energy - 1 }
        on: Tick & { event.depth >= 3 } => ! Graze()
        on: CartLoaded & { event.count <= 1 } => "the plant reacts"
        on: Cornered & { event.fear > 10 } => ! Perch()
        on: Splash => ! Perch()
        on: ScentCaught & { event.count < 8 } => "the plant reacts"
        on: Tick & { event.distance >= 3 } => "plant stirs at {event.kind}"
    until: Cornered
:end

state_machine: Oak(stamina: string)
    default: Oak.Parry
    init: { oak.spawn() }

    state: Parry
        init: { oak.energy = oak.energy - 1 }
        on: PreyEscaped => ! Trot()
        on: DuskFalls => { oak.count = oak.count + 1 }
        on: Tick => { oak.energy = oak.energy - 1 }
        on: Wounded => { oak.state = "alert" }
        on: SunRose & { event.speed >= 1 } => { oak.wake() }
        on: RainFell & { event.depth > 2 } => "the oak reacts"
    until: CartLoaded

    state: Pounce
        on: ReinsPulled => "oak stirs at {event.kind}"
        on: SunRose => { oak.energy = oak.energy - 1 }
        on: PathBlocked => "the oak reacts"
        on: DawnBreaks & { event.depth < 4 } => "the oak holds its ground"
    until: SeesPrey

    state: Glide
        init: { oak.energy = oak.energy - 1 }
        on: GiantShouts & { event.depth > 2 } => { oak.state = "alert" }
        on: BladeClash & { event.depth <= 10 } => ! Climb()
        on: SeesPrey & { event.fear < 2 } => { oak.state = "calm" }
        on: SeesPrey => ! Pounce()
        on: Spooked => { oak.turn() }
        on: ScentCaught => { oak.wake() }
    until: EnemyInRange

    state: Nest
        init: { oak.state = "alert" }
        on: ReinsPulled => { oak.energy = oak.energy - 1 }
        on: Rested & { event.trust == 4 } => ! Trot()
        on: EnemyInRange => ! Pounce()
        on: WhipCracked => ! Parry()
        on: PreyEscaped & { event.fear > 10 } => "the oak reacts"
        on: HarpPlucked => { oak.state = "ready" }
    until: PathBlocked

    state: Climb
        init: { oak.growl() }
        on: Spooked & { event.weight < 1 } => ! Parry()
        on: ScentCaught => "the oak holds its ground"
        on: ReinsPulled & { event.distance <= 5 } => ! Pounce()
        on: BladeClash & { event.range >= 8 } => ! Glide()
    until: Wounded

    state: Trot
        init: { oak.count = oak.count + 1 }
        on: SunRose => ! Glide()
        on: WhipCracked & { event.volume > 2 } => ! Climb()
        on: SeesPlayer => ! Glide()
        on: PreyEscaped => { oak.count = oak.count + 1 }
        on: WhipCracked => ! Parry()
    until: PathBlocked
:end

state_machine: Vine(speed: string)
    default: Vine.Parry
    init: { vine.spawn() }

    state: Parry
        init: { vine.state = "ready" }
        on: RainFell & { event.range == 1 } => "the vine reacts"
        on: DuskFalls & { event.depth < 10 } => { vine.wake() }
        on: Spooked => { vine.stir() }
        on: ReinsPulled => { vine.energy = vine.energy - 1 }
        on: Splash & { event.range == 3 } => ! Sit()
        on: DuskFalls & { event.trust < 1 } => { vine.pos = vine.pos:step() }
    until: BladeClash

    state: Sit
        on: SunRose & { event.range > 5 } => { vine.pos = vine.pos:step() }
        on: Cornered => { vine.energy = vine.energy - 1 }
        on: RainFell & { event.trust <= 5 } => { vine.count = vine.count + 1 }
        on: Splash & { event.range == 8 } => { vine.energy = vine.energy - 1 }
        on: CartLoaded & { event.trust <= 8 } => "the vine reacts"
    until: EnemyInRange

    state: Advance
        on: HarpPlucked & { event.weight >= 10 } => { vine.wake() }
        on: PathBlocked & { event.trust == 5 } => { vine.pos = vine.pos:step() }
        on: Wounded & { event.count >= 5 } => ! Charge()
        on: Cornered => ! Parry()
        on: HarpPlucked & { event.count >= 5 } => ! Parry()
        on: NoiseHeard & { event.count == 8 } => ! Parry()
    until: ArrowIncoming

    state: Retreat
        init: { vine.pos = vine.pos:step() }
        on: ScentCaught & { event.fear < 3 } => { vine.state = "tense" }
        on: Spooked => { vine.energy = vine.energy - 1 }
        on: EnemyInRange => ! Advance()
        on: NoiseHeard & { event.volume >= 3 } => { vine.shift() }
        on: SeesPrey => { vine.pause() }
        on: SunRose & { event.distance <= 4 } => { vine.state = "tense" }
        on: Splash => { vine.state = "calm" }
    until: Rested

    state: Charge
        on: Tick => ! Advance()
        on: ScentCaught => ! Retreat()
        on: NoiseHeard => ! Sit()
        on: ClashResolved => ! Advance()
        on: WhipCracked => { vine.energy = vine.energy - 1 }
    until: PathBlocked
:end

state_machine: Sunflower
    default: Sunflower.Hunt
    init: { sunflower.spawn() }

    state: Hunt
        on: ReinsPulled => { sunflower.count = sunflower.count + 1 }
        on: BladeClash & { event.trust >= 5 } => ! Retreat()
        on: Spooked => "{event.kind} startles the sunflower"
        on: CartLoaded => ! Rest()
        on: RainFell => { sunflower.turn() }
        on: GiantShouts => "{event.kind} startles the sunflower"
    until: SeesPrey

    state: Sprint(prey: number)
        on: SeesPlayer & { event.weight < 1 } => ! Retreat()
        on: PathBlocked => ! Nest()
        on: FlyBuzzed => "the sunflower reacts"
        on: ArrowIncoming => ! Retreat()
        on: Splash & { event.distance > 2 } => "the sunflower holds its ground"
        on: SugarOffered & { event.distance <= 1 } => ! Rest()
        on: ReinsPulled & { event.volume <= 8 } => ! Rest()
    until: RainFell

    state: Alert
        on: HarpPlucked => { sunflower.pos = sunflower.pos:step() }
        on: GiantShouts & { event.range == 8 } => "the sunflower reacts"
        on: WhipCracked => { sunflower.state = "calm" }
        on: HarpPlucked & { event.speed >= 4 } => { sunflower.shift() }
    until: Cornered

    state: Retreat
        on: RainFell & { event.range == 3 } => ! Hunt()
        on: BladeClash & { event.trust == 5 } => "the sunflower reacts"
        on: Splash & { event.fear < 1 } => { sunflower.state = "ready" }
        on: EnemyInRange & { event.amount >= 5 } => { sunflower.state = "calm" }
        on: ClashResolved & { event.amount > 8 } => ! Rest()
        on: RainFell & { event.distance > 4 } => { sunflower.count = sunflower.count + 1 }
    until: WhipCracked

    state: Nest
        on: Rested => { sunflower.shift() }
        on: Wounded & { event.trust < 1 } => "sunflower stirs at {event.kind}"
        on: Spooked => { sunflower.pos = sunflower.pos:step() }
        on: DuskFalls => ! Sprint()
        on: Cornered & { event.trust > 4 } => "{event.kind} startles the sunflower"
    until: SugarOffered

    state: Rest(prey: string)
        on: DuskFalls & { event.count < 4 } => "the sunflower holds its ground"
        on: Wounded => { sunflower.stir() }
        on: ClashResolved => "the sunflower reacts"
        on: GiantShouts => { sunflower.count = sunflower.count + 1 }
        on: ArrowIncoming => { sunflower.state = "calm" }
        on: ArrowIncoming => ! Sprint()
    until: DuskFalls
:end

state_machine: Mushroom(strength: number)
    default: Mushroom.Glide
    init: { mushroom.spawn() }

    state: Glide
        on: SeesPlayer & { event.amount > 10 } => { mushroom.state = "calm" }
        on: ScentCaught => "the mushroom holds its ground"
        on: RainFell & { event.amount <= 8 } => ! Advance()
        on: PathBlocked => { mushroom.turn() }
        on: WhipCracked => { mushroom.pause() }
        on: SeesPrey => ! Advance()
        on: DuskFalls & { event.distance > 5 } => ! Catch()
    until: Cornered

    state: Sprint
        on: ReinsPulled & { event.trust < 10 } => { mushroom.stir() }
        on: DuskFalls => ! Catch()
        on: CartLoaded & { event.trust == 1 } => ! Catch()
        on: RainFell => { mushroom.pos = mushroom.pos:step() }
    until: BladeClash

    state: Catch(goal: number)
        init: { mushroom.count = mushroom.count + 1 }
        on: Cornered => { mushroom.state = "tense" }
        on: BladeClash => { mushroom.energy = mushroom.energy - 1 }
        on: PathBlocked & { event.fear > 4 } => "the mushroom holds its ground"
        on: DawnBreaks & { event.trust <= 3 } => ! Pounce()
        on: Splash => "mushroom stirs at {event.kind}"
        on: WhipCracked => { mushroom.energy = mushroom.energy - 1 }
        on: WhipCracked & { event.speed > 2 } => ! Pounce()
    until: Spooked

    state: Pounce(target: string)
        deinit: { mushroom.stir() }
        on: CartLoaded => ! Glide()
        on: EnemyInRange & { event.fear >= 3 } => { mushroom.energy = mushroom.energy - 1 }
        on: SugarOffered => ! Catch()
        on: Spooked & { event.count <= 5 } => ! Catch()
        on: RainFell & { event.amount < 3 } => "the mushroom holds its ground"
    until: DawnBreaks

    state: Advance(target: number)
        on: RainFell => { mushroom.pos = mushroom.pos:step() }
        on: SunRose & { event.depth <= 3 } => { mushroom.count = mushroom.count + 1 }
        on: ScentCaught & { event.count > 5 } => "mushroom stirs at {event.kind}"
        on: SeesPlayer & { event.count == 5 } => ! Sprint()
        on: SeesPlayer & { event.trust == 8 } => ! Glide()
        on: ScentCaught & { event.depth <= 10 } => { mushroom.pos = mushroom.pos:step() }
    until: Cornered
:end

state_machine: Bramble(stamina: string)
    default: Bramble.Retreat
    init: { bramble.spawn() }

    state: Retreat
        init: { bramble.count = bramble.count + 1 }
        deinit: { bramble.count = bramble.count + 1 }
        on: BladeClash => "{event.kind} startles the bramble"
        on: FlyBuzzed => { bramble.pos = bramble.pos:step() }
        on: FlyBuzzed & { event.count <= 5 } => ! Glide()
        on: CartLoaded => ! Glide()
        on: SeesPlayer => { bramble.energy = bramble.energy - 1 }
        on: Tick => "the bramble reacts"
        on: DuskFalls & { event.amount == 2 } => ! Alert()
    until: Wounded

    state: Perch
        init: { bramble.state = "alert" }
        deinit: { bramble.pause() }
        on: NoiseHeard => ! Graze()
        on: Rested => { bramble.state = "ready" }
        on: DuskFalls => "the bramble reacts"
        on: Rested => { bramble.state = "alert" }
        on: SunRose & { event.speed > 4 } => { bramble.pos = bramble.pos:step() }
        on: BladeClash => "the bramble holds its ground"
        on: DawnBreaks & { event.fear == 2 } => ! Alert()
    until: FlyBuzzed

    state: Guard(target: string)
        init: { bramble.count = bramble.count + 1 }
        on: BladeClash => { bramble.count = bramble.count + 1 }
        on: BladeClash => ! Retreat()
        on: DawnBreaks & { event.depth <= 3 } => ! Perch()
        on: ArrowIncoming => "{event.kind} startles the bramble"
    until: ArrowIncoming

    state: Graze
        init: { bramble.energy = bramble.energy - 1 }
        on: BladeClash & { event.amount == 8 } => ! Glide()
        on: FlyBuzzed & { event.depth > 5 } => ! Alert()
        on: Rested & { event.amount >= 2 } => { bramble.pos = bramble.pos:step() }
        on: SeesPlayer & { event.trust <= 10 } => { bramble.count = bramble.count + 1 }
        on: RainFell & { event.amount == 4 } => ! Alert()
        on: Splash & { event.amount == 3 } => { bramble.energy = bramble.energy - 1 }
    until: NoiseHeard

    state: Alert
        deinit: { bramble.pos = bramble.pos:step() }
        on: Wounded & { event.range == 1 } => ! Guard()
        on: HarpPlucked => { bramble.state = "tense" }
        on: Tick & { event.trust <= 8 } => { bramble.count = bramble.count + 1 }
        on: WhipCracked & { event.count < 2 } => "the bramble holds its ground"
        on: RainFell => ! Graze()
        on: SeesPlayer & { event.distance >= 1 } => ! Guard()
    until: SugarOffered

    state: Lunge
        deinit: { bramble.state = "alert" }
        on: Spooked => { bramble.energy = bramble.energy - 1 }
        on: Spooked => ! Graze()
        on: WhipCracked => ! Guard()
        on: CartLoaded & { event.volume <= 8 } => { bramble.count = bramble.count + 1 }
        on: SugarOffered => ! Guard()
        on: Splash => ! Guard()
    until: CartLoaded

    state: Glide
        init: { bramble.turn() }
        on: Wounded & { event.speed >= 10 } => { bramble.count = bramble.count + 1 }
        on: FlyBuzzed => ! Guard()
        on: Wounded & { event.count > 2 } => ! Graze()
        on: Rested & { event.trust == 3 } => "bramble stirs at {event.kind}"
        on: CartLoaded & { event.fear >= 2 } => ! Alert()
        on: ArrowIncoming => { bramble.state = "alert" }
    until: ReinsPulled
:end

state_machine: Lily(reach: number)
