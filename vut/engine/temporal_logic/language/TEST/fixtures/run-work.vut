divide : work(in: a, b
              out: q
              signals: by_zero) {
    q = a / b else: { div_by_zero => exit by_zero; }
    give q;
}
countdown : clockwork(in: n
                      out: value
                      signals: negative(v)) {
    if: n < 0 { exit negative(n); }
    int: i = 1 .. n {
        value = n - i + 1;
        tick;
    }
    exit;
}
pair : class {
    lo: float;
    hi: float;
    from #{a, b -> the ordered pair; a -> the degenerate pair} : work
}
+pair.from : work(in: bounds, upper
                  out: p : pair
                  signals: disorder) {
    if: bounds > upper { exit disorder; }
    p = bounds + upper;
    give p;
}
+pair.from : work(in: center
                  out: p : pair
                  signals: disorder) {
    if: center < 0 { exit disorder; }
    p = center * 2;
    give p;
}
-pair : work(in: p : pair) {
    give;
}
cleanly : work(in: v
               out: result) {
    result = 0;
    dropto done;
    :done:
    result = v;
    give result;
}
guarded : work(in: v
               out: r
               signals: trouble) {
    r = v + 1;
    give r;
    :failures: => {
        exit trouble;
    }
}
spender : work(in: n
               out: total) {
    cw = countdown(n);
    total = 0;
    for: v from: cw { total = total + v; }
    give total;
}
runner : reactor(in: cmd) {
    q: float; r: float; s: float; t: float; u: float; w: float; x: float; y: float;
  B : behavior {
    GO => {
        .q = divide(10, 2) else: { by_zero => ; }
        .r = divide(1, 0) else: { by_zero => { .r = -1.0; } }
        for: v from: countdown(3) { .s = v; }
        .t = pair.from(bounds = 1, 2) else: { disorder => ; }
        .u = pair.from(center = 4) else: { disorder => ; }
        .w = guarded(5) else: { trouble => { .w = -9; } }
        .x = cleanly(42);
        .y = spender(3);
    }
}
}
plant : work() {
    f = script("GO");
    r = runner();
    f ----> r;
    give;
}
