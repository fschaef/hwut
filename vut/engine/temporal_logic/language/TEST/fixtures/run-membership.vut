w : reactor(in: cmd) {
    tag: string; items: list; ok: bool; same: bool; ys: list;
    probe : behavior {
        setup => { .items[0] = 3.0; .items[1] = 7.0; .ys[0] = 3.0; .ys[1] = 7.0; .tag = "sensor_7"; }
        q1 when: e.x in .items => hit;
        q2 when: e.x not in .items => miss;
        q3 when: .tag == "sensor_7" => { .ok = true; }
        q4 => { .same = .items == .ys; }
        q5 when: "ens" in .tag => substr_hit;
    }
}
plant : work() {
    f = script("setup; q1(x = 7.0); q1(x = 9.0);
                q2(x = 9.0); q2(x = 7.0); q3; q4; q5");
    p = w();
    f ----> p;
    give;
}
