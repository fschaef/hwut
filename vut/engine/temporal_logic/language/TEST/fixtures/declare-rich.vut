open: physics.motors {
    engine_ready: bool;
    spin_up : behavior { MOTOR_ON => run; }
    hot : cause temp_high when: t.value > 90;
}
import: "lib/base.vut" as: base
Rover : character(speed) is: base.vehicle
drive : aspect { idle : behavior { ~ENTRY => halt; } }
E => F;
gauge : aspect(knows: rate = 10 signals: overrun, sensor_lost(port)) {
    poll : behavior { sample => publish; }
}
