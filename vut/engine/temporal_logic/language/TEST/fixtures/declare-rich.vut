open: physics.motors {
    engine_ready: bool;
    spin_up : reactor { run : behavior { MOTOR_ON => run_fast; } }
    hot : cause temp_high when: t.value > 90;
}
import: "lib/base.vut" as: base
Rover : reactor is: base.vehicle {
    speed: float;
    known: hub: net;
    idle : behavior { ~ENTRY => halt; }
}
gauge : reactor++ {
    rate: float;
    poll : behavior { sample => publish; }
    report : behavior { publish_done => archived; }
}
bundle : work(in: raw, known: eps = 0.5
              out: center, known: rotation
              signals: no_convergence(residual)) {
    center = raw + eps;
    rotation = 0;
    give center, rotation;
}
sprite : class {
    pos: vec2;
    known: atlas: texture_atlas;
    make : work
}
+sprite.make : work(in: skin out: s : sprite signals: no_texture(path)) {
    s = 1;
    give s;
}
