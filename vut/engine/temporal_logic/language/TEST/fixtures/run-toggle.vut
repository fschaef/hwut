hot : cause(threshold) temp_high when: e.value > threshold;
climate : reactor(in: cmd out: note) {
    target: float; on: bool; seen: float; last: float;
    control : behavior {
        ac_button when: .on == false => { .on = true; .target = 21.0; }
        ac_button when: .on == true  => { .on = false; }
        dial_turned => { .target += e.delta;
                         signal adjusted(amount = e.delta) to note; }
        dial_turned => { .target = 0 - 99; }
        #{ ^ R-44 first-match: the arm above already fired -- this one is
           SUPPRESSED (under the old all-match it would zero the target). }
        hot(90) => { signal alarm; }
        hush => ;
        #{ ^ R-46: reckoned, ignored -- and CONSUMED: first-match stops
           here, so ~ANY below never sees 'hush' (contrast 'mystery'). }
        ~ANY => { .last = e.delta; .seen = .seen + 1; }
        #{ ^ the catch-all: any cmd event no causality above matched;
           e is Nothing under ~ANY -- .last reads Nothing. }
    }
}
plant : work() {
    f = script("ac_button; ac_button; ac_button;
                mystery(delta = 7.0); hush;
                dial_turned(delta = 2.5);
                temp_high(value = 95.0); temp_high(value = 50.0)");
    c = climate();
    f ----> c;
    give;
}
