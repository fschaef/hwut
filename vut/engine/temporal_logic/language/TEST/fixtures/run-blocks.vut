worker : reactor(in: cmd) {
    total: float; label: float; items: list;
  crunch : behavior {
    go => {
        int: i = 1 .. 5 step: 2 { .total += i; }
        .items[0] = 1.0;
        .items[1] = 2.0;
        for: v in: [ x * 10.0 with: x from: .items if: x > 1.5 ] {
            .total += v;
        }
        int: k with: x from: .items start: 10 { .total += k + x; }
        if: e.n > 2 { .total *= 2.0; dropto done; }
        else: { .total = 0.0; }
        .total = 999.0;
        :done:
        .label = 1.0;
    }
    classify => {
        match: e.code {
            case: 7 { .label = 7.0; }
            case: 10 to: 50 { .label = 30.0; }
            case: _ { .label = 99.0; }
        }
    }
}
}
plant : work() {
    f = script("go(n = 3.0);
                classify(code = 42.0); classify(code = 7.0);
                classify(code = 500.0)");
    w = worker();
    f ----> w;
    give;
}
