#{ ===========================================================================
   DESTRUCT -- destruction is a work that takes.

   One disposal work per class, spelled '-class' (R-31): it RECEIVES the
   instance through a takes-port and ends it. Its duty (0.3/11.4): discharge
   every obligation member -- give it onward or destruct it in turn; plain
   value members end under the memory exemption.

   HONESTY NOTE: the custody LEDGER -- the checker that proves every path
   discharges -- binds the future type document (SEMANTICS 23, deferred).
   The LAW binds now; this file shows its shape.
   =========================================================================== }

buffer : class has: { size: float; } {
    from : work
}

+buffer.from : work(knows: size
                    gives: b : buffer
                    signals: too_large(limit)) {
    if: size > 65536 { exit: too_large(65536); }
    b = size;
    finish:
}

#{ The '-' completion is THE disposal work: its panel TAKES the class --
   the debt arrives, the body ends it. DESTRUCTION CANNOT FAIL (11.4,
   R-36): a disposal work declares NO signals -- so its call sites carry
   no handling obligation (12.2), ever. The philosophy has its own file:
   explain-destruction-cannot-fail.vut. Declare's duplicate law holds
   single-'-' (one class, one disposal work). }

-buffer : work(takes: b : buffer) {
    # value members (size) end under the memory exemption -- no ceremony;
    # an obligation member would be given or destructed HERE, before the
    # terminal ends this work's own having (explain-lifecycle.vut).
    finish:
}

Demo : behavior has: { got: float; } {
    SHOW => {
        b.got = buffer.from(size = 1024) else: { too_large(limit) => ; }
    }
}
